// Blossom surface grammar. Node names are the typed CST view names.
// Contextual terminals are lexed IDENT; the parser chooses by fixed lookahead.
SourceFile = InnerAttr* ProgramHeader? Item*
ProgramHeader = 'program' Name 'version' 'INT_LIT' ('edition' 'INT_LIT')? ';'
InnerAttr = '#![' Attr ']'
Attr = '#[' Name ('(' Arg* ')' | '=' Expr)? ']'
Item = UseItem | ImportItem | IncludeItem | ConstItem | ParamItem | TypeAlias | StructItem | EnumItem | FnItem | ExternItem | ImplItem | LatticeTypeItem | AggregateItem | ServiceItem | ModuleItem | ProtocolItem | RoleItem | AtSection | InterposeItem | BlockItem | OverrideItem | AclItem | RelDecl | CellDecl | TimerDecl | ViewDecl | HandlerItem | BootstrapItem | FactItem | InvariantItem | MigrateItem | TranslateItem | SnapshotItem | SpecItem | FormatItem
UseItem = 'use' UseTree ';'
UseTree = Name (UseTree | Name)*
ImportItem = 'import' Name GenericArgs? Arg* Name ';'
IncludeItem = 'include' (Name | 'STRING_LIT') ';'
ConstItem = 'const' Name Type Expr ';'
ParamItem = 'param' Name Type Expr? ';'
TypeAlias = 'type' Name Generics? Type ';'
StructItem = 'struct' Name Generics? (FieldDecl* | Type*)
EnumItem = 'enum' Name Generics? Variant*
Variant = Attr* Name (Type* | FieldDecl*)
FieldDecl = Attr* Name Type Expr?
Generics = GenericParam*
GenericParam = Name Type*
GenericArgs = GenericArg*
GenericArg = Name? Type?
Type = Name GenericArgs? | Type*
FnItem = FnSig BlockExpr
FnSig = Name Generics? FnParam* Type
FnParam = Expr? Type?
BlockExpr = LetLit* Expr?
ExternItem = FnSig? Type? ParamList?
ParamList = Param*
Param = Name Type
ImplItem = Generics? Type* FnItem*
LatticeTypeItem = Name Generics? (Type | FieldDecl*)
AggregateItem = Name Generics? ParamList Type AggMember*
AggMember = Name (Type | Expr)
ServiceItem = Name ParamList ParamList
ModuleItem = Name Generics? ModParams? Type* Item*
ModParams = ModParam*
ModParam = Name (Type | ParamList) Expr?
ProtocolItem = Name Generics? Type* Item*
RoleItem = Name Name?
AtSection = Name Item*
InterposeItem = RelPath Name Name Item*
BlockItem = Name Item*
OverrideItem = Item
AclItem = RelPath Expr*
RelDecl = Name ColDecl* RelPath? (DirectionClause | KeyClause | TtlClause | MaxClause | RangeClause | ResolveClause | PartitionClause | SealedByClause | ExactlyOnceClause | WhileClause)*
ColDecl = Attr* Name Type Expr?
DirectionClause = Name Name
KeyClause = Name*
TtlClause = Expr
MaxClause = Expr
RangeClause = Name
ResolveClause = Policy
PartitionClause = Expr RelPath?
SealedByClause = Name* RelPath?
ExactlyOnceClause = Name
WhileClause = Body
Policy = Name* Expr?
CellDecl = Name Type
TimerDecl = Name Expr* RelPath?
RelPath = Name+
ViewDecl = Name ViewCol* Body+
ViewCol = Name Type? Expr?
HandlerItem = Name? Body Block
Block = Stmt*
Stmt = VerbStmt | IfStmt | ForStmt
VerbStmt = Attr* Head Expr? Policy?
IfStmt = Body Block (IfStmt | Block)?
ForStmt = Body Block
Head = RelPath Arg*
BootstrapItem = Block
FactItem = Head Expr*
InvariantItem = Name Body
Body = Literal+ Expr*
Literal = NotLit | LetLit | OuterLit | InsertedLit | DeletedLit | SealedLit | FinalLit | PerLit | AnyLit | ForallLit | EverLit | SentLit | QuorumLit | AtomLit
NotLit = (Body | Literal)
LetLit = Expr Expr
OuterLit = AtomLit
InsertedLit = AtomLit
DeletedLit = AtomLit
SealedLit = AtomLit
FinalLit = AtomLit
PerLit = AtomLit
AnyLit = Body+
ForallLit = AtomLit Body
EverLit = AtomLit
SentLit = AtomLit
QuorumLit = Name RelPath Body
AtomLit = Expr (FromSuffix | PrincipalSuffix | WeightSuffix | AtSuffix | AtTickSuffix)*
FromSuffix = Expr
PrincipalSuffix = Expr
WeightSuffix = Expr
AtSuffix = Expr
AtTickSuffix = Expr
Expr = LiteralExpr | PathExpr | CallExpr | MethodCallExpr | BangCallExpr | FieldExpr | TupleIndexExpr | IndexExpr | BinaryExpr | PrefixExpr | CastExpr | ParenExpr | TupleExpr | VecExpr | SetExpr | MapExpr | FoldExpr | IfExpr | MatchExpr | StructLitExpr | ClosureExpr | Wildcard | SelfExpr
LiteralExpr = 'INT_LIT' | 'FLOAT_LIT' | 'DURATION_LIT' | 'MOD_LIT' | 'STRING_LIT' | 'RAW_STRING_LIT' | 'BYTES_LIT' | 'true' | 'false'
PathExpr = Name GenericArgs?
CallExpr = Expr Arg*
MethodCallExpr = Expr Name Arg*
BangCallExpr = Name Arg* BangClause*
FieldExpr = Expr Name
TupleIndexExpr = Expr 'INT_LIT'
IndexExpr = Expr Expr
BinaryExpr = Expr Expr
PrefixExpr = Expr
CastExpr = Expr Type
ParenExpr = Expr
TupleExpr = Expr*
VecExpr = Expr*
SetExpr = Expr*
MapExpr = (Expr Expr)*
FoldExpr = Expr* Body
IfExpr = Expr BlockExpr BlockExpr?
MatchExpr = Expr MatchArm*
MatchArm = Expr Expr? Expr
StructLitExpr = PathExpr FieldInit*
FieldInit = Name? Expr?
ClosureExpr = Expr+
Wildcard = '_'
SelfExpr = 'self'
Arg = Name? Expr?
BangClause = Expr* OrderKeys?
OrderKeys = OrderKey*
OrderKey = Expr
MigrateItem = Item*
TranslateItem = RelPath Item*
SnapshotItem = Name RelPath Expr*
SpecItem = Name? (NodesMember | AssignMember | FaultsMember | LivenessMember | ProveMember | ExpectMember | CheckMember | ConstItem | FactItem | ViewDecl | InvariantItem)*
NodesMember = Name+
AssignMember = Name+
FaultsMember = OptBlock
LivenessMember = Name Body Expr*
ProveMember = Name+
ExpectMember = RelPath
CheckMember = Name OptBlock?
OptBlock = OptField*
OptField = Name Expr
Name = 'IDENT'
FormatItem = Name FormatParam* (Expr | FormatField*)
FormatParam = Name Type?
FormatField = Name? Expr FormatCond? FormatDefault?
FormatCond = Expr
FormatDefault = Expr
