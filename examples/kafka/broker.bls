//! A Kafka broker in Blossom (docs/design/KAFKA.md; slices 6 and 7): one node, a one-broker cluster, serving stock
//! clients (kcat, the Java tools, franz-go) on its `kafka` stream. It answers ApiVersions and Metadata; creates,
//! deletes and describes topics (CreateTopics, DeleteTopics, DescribeConfigs, Metadata auto-creation); appends
//! record batches durably (Produce, with idempotent producers through InitProducerId); serves them back (Fetch,
//! ListOffsets); and deletes old segments by time and size (retention).
//!
//! The connection layer (`broker_node.bls`) cuts each connection's bytes into frames and queues them; each
//! connection's requests are answered one at a time, in order. A request this broker cannot answer (an API it does
//! not advertise, a malformed frame) closes the connection, as a Kafka broker does for an unknown API.

program kafka version 1;

include "protocol.bls";
include "headers.bls";
include "apiversions.bls";
include "metadata.bls";
include "topics.bls";
include "records.bls";
include "produce.bls";
include "fetch.bls";
include "broker_fns.bls";

/// This broker's id, the address it advertises, and its cluster id.
param NODE_ID: i32 = 1;
param ADVERTISED_HOST: String = "localhost";
param ADVERTISED_PORT: i32 = 9092;
/// The partition count of a topic created without one (Kafka's `num.partitions`), and whether a Metadata request
/// may create the topics it names (`auto.create.topics.enable`).
param DEFAULT_PARTITIONS: i32 = 1;
param AUTO_CREATE_TOPICS: bool = true;
/// How often retention is checked (Kafka's `log.retention.check.interval.ms`, 5 minutes by default).
param RETENTION_CHECK: Duration = 300s;
param CLUSTER_ID: String = "blossom-kafka";
/// How many requests, and how many bytes of them, a connection's queue holds before the broker stops reading it
/// until it is shorter (Kafka mutes a connection while a request of it is in flight). The bytes are a bound on what a
/// pipelining client makes the broker hold, with what the host read ahead (FOREIGN-PROTOCOLS §1.2).
param MAX_QUEUED_REQUESTS: u64 = 64;
param MAX_QUEUED_BYTES: u64 = 16777216;

include "broker_node.bls";
include "topics_node.bls";
include "produce_node.bls";
include "fetch_node.bls";
