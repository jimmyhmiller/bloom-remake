//! Kafka request and response headers (RequestHeader v1–v2, ResponseHeader v0–v1).

const API_PRODUCE: i16 = 0;
const API_FETCH: i16 = 1;
const API_LIST_OFFSETS: i16 = 2;
const API_METADATA: i16 = 3;
const API_VERSIONS: i16 = 18;
const API_CREATE_TOPICS: i16 = 19;
const API_DELETE_TOPICS: i16 = 20;
const API_DESCRIBE_CONFIGS: i16 = 32;
const API_INIT_PRODUCER_ID: i16 = 22;
const API_DESCRIBE_CLUSTER: i16 = 60;
const API_ALTER_PARTITION_REASSIGNMENTS: i16 = 45;
const API_LIST_PARTITION_REASSIGNMENTS: i16 = 46;

/// The error code for no error.
const NONE: i16 = 0;
/// A partition's leader is not known yet (being elected, or the topic just created).
const LEADER_NOT_AVAILABLE: i16 = 5;
/// This broker does not lead the partition: the client refreshes its metadata.
const NOT_LEADER_OR_FOLLOWER: i16 = 6;
const REQUEST_TIMED_OUT: i16 = 7;

/// Whether a request of `api_key` at `version` uses the flexible encoding (compact types and tagged fields), which
/// also puts it in header v2. Only the APIs this broker answers are listed.
fn flexible(api_key: i16, version: i16) -> bool {
    (api_key == API_VERSIONS && version >= 3i16) || (api_key == API_METADATA && version >= 9i16)
        || (api_key == API_PRODUCE && version >= 9i16) || (api_key == API_FETCH && version >= 12i16)
        || (api_key == API_LIST_OFFSETS && version >= 6i16) || (api_key == API_INIT_PRODUCER_ID && version >= 2i16)
        || (api_key == API_CREATE_TOPICS && version >= 5i16) || (api_key == API_DELETE_TOPICS && version >= 4i16)
        || (api_key == API_DESCRIBE_CONFIGS && version >= 4i16) || api_key == API_DESCRIBE_CLUSTER
        || api_key == API_ALTER_PARTITION_REASSIGNMENTS || api_key == API_LIST_PARTITION_REASSIGNMENTS
        || (api_key == API_FIND_COORDINATOR && version >= 3i16) || (api_key == API_JOIN_GROUP && version >= 6i16)
        || (api_key == API_SYNC_GROUP && version >= 4i16) || (api_key == API_HEARTBEAT && version >= 4i16)
        || (api_key == API_LEAVE_GROUP && version >= 4i16) || (api_key == API_OFFSET_COMMIT && version >= 8i16)
        || (api_key == API_OFFSET_FETCH && version >= 6i16) || (api_key == API_DESCRIBE_GROUPS && version >= 5i16)
        || (api_key == API_LIST_GROUPS && version >= 3i16)
}

/// The fixed part of a request header: the API key, version and correlation id, which every version has. The rest
/// depends on the API and version.
fn request_prefix(c: Cur) -> Option<(i16, i16, i32, Cur)> {
    let (k, p) = c.buf.i16_be_at(c.pos).map(|k| (k, c.pos + 2))?;
    let (v, p) = c.buf.i16_be_at(p).map(|v| (v, p + 2))?;
    let (id, p) = c.buf.i32_be_at(p).map(|id| (id, p + 4))?;
    Some((k, v, id, at(c, p)))
}

/// A request header: v2 (with tagged fields) for a flexible request, v1 otherwise. `client_id` is a legacy nullable
/// string even in v2.
format RequestHeader {
    api_key: i16,
    api_version: i16,
    correlation_id: i32,
    client_id: string16,
    tags if flexible(api_key, api_version),
}

fn request_header(c: Cur) -> Option<(RequestHeader, Cur)> {
    let (h, p) = RequestHeader::decode(c.buf, c.pos)?;
    Some((h, at(c, p)))
}

/// Response header v0: the correlation id. (ApiVersions answers with header v0 at every version.)
fn response_header_v0(correlation_id: i32) -> Bytes {
    Bytes::from_i32_be(correlation_id)
}

/// Response header v1: the correlation id and tagged fields.
fn response_header_v1(correlation_id: i32) -> Bytes {
    Bytes::from_i32_be(correlation_id).concat(no_tags())
}

/// A request header v2 (for a flexible request): key, version, correlation id, client id, no tags.
fn request_header_v2(api_key: i16, version: i16, correlation_id: i32, client_id: String) -> Bytes {
    RequestHeader::encode(RequestHeader { api_key: api_key, api_version: version, correlation_id: correlation_id, client_id: Some(client_id) })
}

/// The correlation id at the front of a response (every response header version starts with it).
fn response_correlation(c: Cur) -> Option<(i32, Cur)> {
    c.buf.i32_be_at(c.pos).map(|id| (id, at(c, c.pos + 4)))
}
