//! The topics requests (S8 item 2): CreateTopics, DeleteTopics, Metadata and DescribeConfigs, over the applied
//! metadata of the controller (`cluster.bls`). Included next to `broker_node.bls`, whose `head` view gives each
//! connection's next request.
//!
//! A creation or deletion is decided in two places. The broker a client asked checks each entry against the request
//! alone (a malformed name, a bad configuration, a replication factor above the brokers, two entries for one topic)
//! and answers those at once; every other entry becomes a command to the controller, and the request waits at the
//! head of its connection until every command is applied (or its timeout passes). The controller's log orders the
//! commands of every broker, so concurrent requests see one order of creations and deletions; applying a command
//! decides what depends on the topics then (a name taken, an id gone) the same way on every broker.

/// A broker that has not caught up with the controller (cut off since it restarted) does not keep a client waiting
/// for ever: after `NOT_CAUGHT_UP_WAIT` it closes the connection, so the client goes to another broker (a Kafka
/// broker that has not caught up is fenced, and clients do not use it).
not_caught_up_close: while head(c, i, _seq, key, version, _corr, fr, at), not caught_up()
    where not pure_request(key, version) && now() >= at + NOT_CAUGHT_UP_WAIT {
    send kafka.close(c);
    delete queued(c, i, fr, at);
}

/// A supported request whose body this broker cannot decode closes the connection.
undecodable: while head(c, i, _seq, key, version, _corr, fr, at)
    where not pure_request(key, version) && not decoded_by_view(key) && not stateful_body_ok(key, fr) {
    send kafka.close(c);
    delete queued(c, i, fr, at);
}
view request_decoded(c, i) {
    produce_req(c, i, _);
    fetch_req(c, i, _);
}
undecodable_by_view: while head(c, i, _seq, key, version, _corr, fr, at), not request_decoded(c, i)
    where not pure_request(key, version) && decoded_by_view(key) {
    send kafka.close(c);
    delete queued(c, i, fr, at);
}

view create_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_CREATE_TOPICS,
    let Some(body) = request_body(fr), let Some(req) = decode_create_topics(body);

view delete_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_DELETE_TOPICS,
    let Some(body) = request_body(fr), let Some(d) = decode_delete_topics(body), let req = d.0;

view metadata_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_METADATA,
    let Some(body) = request_body(fr), let Some(req) = decode_metadata_request(body);

view describe_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_DESCRIBE_CONFIGS,
    let Some(body) = request_body(fr), let Some(req) = decode_describe_configs(body);

/// The commands this broker's requests wait on, by tag (`cluster.bls` sends them to the controller).
view wanted_cmd(tag, cmd) {
    create_cmd_of(_c, _i, tag, cmd);
    delete_cmd_of(_c, _i, tag, cmd);
    pid_cmd(tag, cmd);
    metadata_cmd_of(_c, _i, tag, cmd);
    alter_cmd_of(_c, _i, tag, cmd);
    reassigned_cmd_of(tag, cmd);
    offsets_cmd(tag, cmd);
}

// ---------------------------------------------------------------- CreateTopics

/// Each CreateTopics request's context: the request alone (what is taken is decided by the controller).
view create_context_of(c, ctx) = create_head(c, _, _, _, _, _, req), let ctx = create_context(create_names(req), []);

/// Each topic entry's outcome against the request, with the id and placement it would get: functions of the request
/// (this broker, the connection, the request's index and the entry: a connection id is unique on its broker only),
/// so a command sent again is the same command.
view create_verdict(c, i, j, o) =
    create_head(c, i, _, _, _, _, req), broker_ids(ids), (j, t) in req.topics.enumerate(), create_context_of(c, ctx),
    my_id(me), let id = topic_id(hash64(("id", me, c, i, j, 0u64)), hash64(("id", me, c, i, j, 1u64))),
    let o = create_outcome(t, ctx, id, DEFAULT_PARTITIONS, DEFAULT_REPLICATION_FACTOR, ids, hash64(("start", me, c, i, j)));

/// Each entry decided before a taken name is looked for (a name given twice, illegal, colliding within the request).
view create_early(c, i, j) =
    create_head(c, i, _, _, _, _, req), create_context_of(c, ctx), (j, t) in req.topics.enumerate()
    where decided_before_taken(t, ctx);

/// The entries that become the request's command: every other entry, with what the broker decided after that
/// (applied only if the name is not taken). A request that only validates is a command too, decided by the
/// controller against the metadata as it applies it, as Kafka forwards it to its controller.
view create_item_of(c, i, j, o) = create_verdict(c, i, j, o), not create_early(c, i, j);
view create_items(c, i, items = collect!(it)) = per create_head(c, i, _, _, _, _, _req), create_item_of(c, i, j, o),
    let it = create_item(j, o.error, o.topic.name, o.topic.id, o.topic.assignment, o.topic.configs);
view create_cmd_of(c, i, tag, cmd) =
    create_items(c, i, items), create_head(c, i, _, _, _, _, req), my_id(me), let tag = hash64(("create", c, i)),
    let cmd = encode_cmd(if req.validate_only { validate_cmd(me, tag, items) } else { create_cmd(me, tag, items) })
    where items.len() > 0;

/// Each entry's final outcome: decided at once, or once its command is applied.
view create_final(c, i, j, o) {
    create_verdict(c, i, j, o), create_early(c, i, j);
    create_item_of(c, i, j, o0), create_cmd_of(c, i, tag, _cmd), my_id(me), outcome(me, tag, j, err, _id, _pid, _n),
        create_head(c, i, _, _, _, _, req), let o1 = applied_create(o0, err),
        let o = if req.validate_only { validated(o1) } else { o1 };
}
view create_finals(c, i, xs = collect!((j, o))) = per create_head(c, i, _, _, _, _, _req), create_final(c, i, j, o);
/// When the timeout passes, an entry still waiting fails with REQUEST_TIMED_OUT.
view create_late(c, i, j, o) {
    create_final(c, i, j, o);
    create_item_of(c, i, j, o0), not create_final(c, i, j, _), let o = create_timed_out(o0.topic.name);
}
view create_lates(c, i, xs = collect!((j, o))) = per create_head(c, i, _, _, _, _, _req), create_late(c, i, j, o);

answer_create: while create_head(c, i, seq, corr, fr, at, req), create_finals(c, i, xs) where xs.len() == req.topics.len() {
    emit reply(c, i, [Part::Bytes(encode_create_topics_response(corr, create_outcomes_in(xs)))]);
}
answer_create_late: while create_head(c, i, seq, corr, fr, at, req), create_finals(c, i, xs), create_lates(c, i, ys)
    where xs.len() < req.topics.len() && now() >= at + Duration::from_millis(req.timeout_ms as i64) {
    emit reply(c, i, [Part::Bytes(encode_create_topics_response(corr, create_outcomes_in(ys)))]);
}

// ---------------------------------------------------------------- DeleteTopics

view delete_context_of(c, ctx) = delete_head(c, _, _, _, _, _, req), let ctx = delete_context(req);

/// Each entry refused at once: a malformed one (both a name and an id, or the same topic twice the same way), a
/// function of the request alone. The others are the request's command; the controller resolves their names and ids
/// against the metadata as it applies it, as Kafka forwards a deletion to its controller.
view delete_malformed(c, i, e) =
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate() where not delete_entry_ok(ctx, s);
view delete_item_of(c, i, e, name, id) =
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate(),
    let name = delete_name(s), let id = s.id
    where delete_entry_ok(ctx, s);
view delete_items(c, i, items = collect!(it)) = per delete_head(c, i, _, _, _, _, _req), delete_item_of(c, i, e, name, id),
    let it = delete_item(e, name, id);
view delete_cmd_of(c, i, tag, cmd) =
    delete_items(c, i, items), my_id(me), let tag = hash64(("delete", c, i)), let cmd = encode_cmd(delete_cmd(me, tag, items))
    where items.len() > 0;

view delete_final(c, i, e, o) {
    delete_malformed(c, i, e), delete_head(c, i, _, _, _, _, req), let Some(s) = req.get(e),
        let o = delete_refused(s, INVALID_REQUEST);
    delete_item_of(c, i, e, _name, _id), delete_cmd_of(c, i, tag, _cmd), my_id(me), outcome(me, tag, e, err, tid, _pid, name),
        delete_head(c, i, _, _, _, _, req), let Some(s) = req.get(e), let o = delete_applied(s, tid, name, err);
}
view delete_finals(c, i, xs = collect!((e, o))) = per delete_head(c, i, _, _, _, _, _req), delete_final(c, i, e, o);
view delete_late(c, i, e, o) {
    delete_final(c, i, e, o);
    delete_item_of(c, i, e, _name, _id), not delete_final(c, i, e, _), delete_head(c, i, _, _, _, _, req),
        let Some(s) = req.get(e), let o = delete_refused(s, REQUEST_TIMED_OUT);
}
view delete_lates(c, i, xs = collect!((e, o))) = per delete_head(c, i, _, _, _, _, _req), delete_late(c, i, e, o);
/// DeleteTopics' timeout (the request's only top-level field after the topics).
view delete_timeout(c, ms) = head(c, _, _, key, _version, _corr, fr, _at), key == API_DELETE_TOPICS,
    let Some(body) = request_body(fr), let Some(d) = decode_delete_topics(body), let ms = d.1;

answer_delete: while delete_head(c, i, seq, corr, fr, at, req), delete_finals(c, i, xs) where xs.len() == req.len() {
    emit reply(c, i, [Part::Bytes(encode_delete_topics_response(corr, delete_outcomes_in(xs)))]);
}
answer_delete_late: while delete_head(c, i, seq, corr, fr, at, req), delete_finals(c, i, xs), delete_lates(c, i, ys),
    delete_timeout(c, ms) where xs.len() < req.len() && now() >= at + Duration::from_millis(ms as i64) {
    emit reply(c, i, [Part::Bytes(encode_delete_topics_response(corr, delete_outcomes_in(ys)))]);
}

// ---------------------------------------------------------------- Metadata

/// Each partition as Metadata describes it (S8.md D7).
/// A partition's replicas as Metadata shows them: during a reassignment, the target's and then those it removes.
view shown_replicas(tid, p, rs) {
    massign(tid, p, rs), not reassigning_now(tid, p);
    massign(tid, p, rs0), mreassign(tid, p, target, _h, _s), let rs = reassign_shown(rs0, target);
}
/// Each partition's leader as Metadata shows it: the one this broker knows, if it is among the replicas this broker
/// knows (a leader that a reassignment just removed still has its last announcement here until a new one is
/// elected), with the in-sync replicas among them.
view shown_leader(tid, p, lid, epoch, isr) =
    shown_replicas(tid, p, rs), let g = (tid, p), partition_leader(g, epoch, l, isr0), broker(l, lid, _, _),
    let isr = among(isr0, rs) where rs.contains(lid);
view leader_shown(tid, p) = shown_leader(tid, p, _, _, _);
view part_info(tid, pi) {
    shown_replicas(tid, p, rs), shown_leader(tid, p, lid, epoch, isr),
        let pi = PartInfo { index: p, leader: lid, epoch: epoch as i32, replicas: rs, isr: isr };
    shown_replicas(tid, p, rs), not leader_shown(tid, p),
        let pi = PartInfo { index: p, leader: -1i32, epoch: -1i32, replicas: rs, isr: [] };
}
view topic_info(name, id, ps = collect!(pi)) = mtopic(name, id, _, _), part_info(id, pi);

/// The names a Metadata request auto-creates: those it asks for that may be created (auto-creation is on, the name
/// is legal and no other asked name collides with it), if one of them collides with no topic when the request is
/// first at the head; else none. They are pinned then, so the request's command stays the same while topics come and
/// go. The controller creates those still free when it applies the command, and the request is answered from the
/// metadata just after: the request takes effect at that point, so a name freed meanwhile is created too.
table metadata_pinned(c: Conn, i: u64, names: Vec<String>) key(c, i) while queued(c, i, _, _);
view metadata_free(c, i) = metadata_head(c, i, _, _, _, _, req), n in metadata_creates(req, AUTO_CREATE_TOPICS),
    let k = collision_key(n), not topic_keys(k, _);
pin_metadata: while metadata_head(c, i, _, _, _, _, req), not metadata_pinned(c, i, _) {
    if metadata_free(c, i) {
        upsert metadata_pinned(c, i, metadata_creates(req, AUTO_CREATE_TOPICS));
    }
    if not metadata_free(c, i) {
        upsert metadata_pinned(c, i, []);
    }
}
view metadata_cmd_of(c, i, tag, cmd) =
    metadata_pinned(c, i, names), broker_ids(ids), my_id(me), let tag = hash64(("auto", c, i)),
    let rf = if DEFAULT_REPLICATION_FACTOR as u64 > ids.len() { ids.len() as i16 } else { DEFAULT_REPLICATION_FACTOR },
    let cmd = encode_cmd(create_cmd(me, tag, metadata_items(me, c, i, names, ids, DEFAULT_PARTITIONS, rf))) where names.len() > 0;
view metadata_known(c, ts = collect!(TopicInfo { name: n, id: id, partitions: ps })) =
    per metadata_head(c, _, _, _, _, _, _req), topic_info(n, id, ps);
view broker_infos(bs = collect!(BrokerInfo { node_id: id, host: host, port: port, rack: None })) = broker(_, id, host, port);
/// The controller's leader as this broker knows it, or itself (KRaft brokers report a live broker; never -1).
view controller_or_none(id) {
    controller_id(id);
    my_id(id), not controller_id(_);
}

/// A Metadata request that auto-creates topics is answered once the controller has applied its command (the names
/// are then taken, by these topics or by others), or `METADATA_CREATE_WAIT` after it arrived: the topics are in its
/// answer, created by it (S7 answered them at once too; Kafka answers LEADER_NOT_AVAILABLE first). The names still
/// being created then are LEADER_NOT_AVAILABLE.
view metadata_creating(c, i, names) {
    metadata_pinned(c, i, names), metadata_cmd_of(c, i, tag, _cmd), my_id(me), not done(me, tag, _);
    metadata_pinned(c, i, _names), not metadata_cmd_of(c, i, _, _), let names = [];
    metadata_pinned(c, i, _names), metadata_cmd_of(c, i, tag, _cmd), my_id(me), done(me, tag, _), let names = [];
}
view metadata_ready(c, i) {
    metadata_creating(c, i, names) where names.len() == 0;
    metadata_pinned(c, i, _names), metadata_head(c, i, _, _, _, at, _req) where now() >= at + METADATA_CREATE_WAIT;
}
answer_metadata: while metadata_head(c, i, seq, corr, fr, at, req), metadata_ready(c, i), metadata_known(c, known),
    metadata_creating(c, i, names), broker_infos(bs), controller_or_none(ctl) {
    emit reply(c, i, [Part::Bytes(encode_metadata_response(corr, req, bs, CLUSTER_ID, ctl, known, names.to_set()))]);
}

// ---------------------------------------------------------------- AlterPartitionReassignments, ListPartitionReassignments

/// A reassignment request is one command (its partitions, with the broker's verdict on their replicas); the
/// controller decides the rest (item 5). It is answered once applied, or with REQUEST_TIMED_OUT for what was not when
/// its timeout passes.
view alter_head(c, i, seq, version, corr, fr, at, req) =
    head(c, i, seq, key, version, corr, fr, at), caught_up(), key == API_ALTER_PARTITION_REASSIGNMENTS,
    let Some(body) = request_body(fr), let Some(req) = decode_alter_reassignments(body, version);
view alter_items(c, i, items = collect!(it)) = per alter_head(c, i, _, _, _, _, _, req), broker_ids(ids),
    let repeated = reassign_repeated(req), e in reassign_entries(req),
    let it = reassign_item(e.0, e.1, e.2, reassign_entry_error(repeated, e.1, e.2, e.3, ids), e.3, req.allow_rf_change);
view alter_cmd_of(c, i, tag, cmd) =
    alter_items(c, i, items), my_id(me), let tag = hash64(("reassign", c, i)), let cmd = encode_cmd(reassign_cmd(me, tag, items))
    where items.len() > 0;
view alter_errors(c, i, es = collect!((slot, err))) = per alter_head(c, i, _, _, _, _, _, _req), alter_cmd_of(c, i, tag, _cmd),
    my_id(me), outcome(me, tag, slot, err, _id, _pid, _name);
answer_alter: while alter_head(c, i, seq, version, corr, fr, at, req), alter_errors(c, i, es)
    where es.len() == reassign_entries(req).len() {
    emit reply(c, i, [Part::Bytes(encode_alter_reassignments_response(corr, version, req, es.to_map()))]);
}
answer_alter_late: while alter_head(c, i, seq, version, corr, fr, at, req), alter_errors(c, i, es)
    where es.len() < reassign_entries(req).len() && now() >= at + Duration::from_millis(req.timeout_ms as i64) {
    emit reply(c, i, [Part::Bytes(encode_alter_reassignments_response(corr, version, req,
        errors_or_timed_out(reassign_entries(req).len(), es)))]);
}

/// ListPartitionReassignments reads this broker's metadata, as Kafka's brokers answer it from theirs.
view list_reassign_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_LIST_PARTITION_REASSIGNMENTS,
    let Some(body) = request_body(fr), let Some(req) = decode_list_reassignments(body);
view ongoing_for(c, os = collect!(Ongoing { name: n, index: p, replicas: rs, target: t })) =
    per list_reassign_head(c, _, _, _, _, _, _req), mreassign(tid, p, t, _h, _s), massign(tid, p, rs), mtopic(n, tid, _, _);
answer_list_reassign: while list_reassign_head(c, i, seq, corr, fr, at, req), ongoing_for(c, os) {
    emit reply(c, i, [Part::Bytes(encode_list_reassignments_response(corr, req, os))]);
}

// ---------------------------------------------------------------- DescribeCluster

/// DescribeCluster reads only the brokers (configuration) and the controller's leader, so it does not wait for the
/// metadata to catch up.
answer_describe_cluster: while head(c, i, seq, key, version, corr, fr, at), key == API_DESCRIBE_CLUSTER,
    let Some(body) = request_body(fr), let Some(req) = decode_describe_cluster(body, version), broker_infos(bs),
    controller_or_none(ctl) {
    emit reply(c, i, [Part::Bytes(encode_describe_cluster_response(corr, version, req, bs, CLUSTER_ID, ctl))]);
}

// ---------------------------------------------------------------- DescribeConfigs

/// Per DescribeConfigs request: the configurations of the topics it names that exist.
view describe_found(c, sets = collect!((n, cfg))) = per describe_head(c, _, _, _, _, _, req), r in req,
    r.kind == CONFIG_TOPIC, let n = r.name, mtopic(n, _, _, cfg);

answer_describe: while describe_head(c, i, seq, corr, fr, at, req), describe_found(c, sets) {
    emit reply(c, i, [Part::Bytes(encode_describe_configs_response(corr, describe_results(req, sets)))]);
}
