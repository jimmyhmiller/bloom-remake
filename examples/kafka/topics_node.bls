//! The topics requests (S8 item 2): CreateTopics, DeleteTopics, Metadata and DescribeConfigs, over the applied
//! metadata of the controller (`cluster.bls`). Included next to `broker_node.bls`, whose `head` view gives each
//! connection's next request.
//!
//! A creation or deletion is decided in two places. The broker a client asked checks each entry against the request
//! alone (a malformed name, a bad configuration, a replication factor above the brokers, two entries for one topic)
//! and answers those at once; every other entry becomes a command to the controller, and the request waits at the
//! head of its connection until every command is applied (or its timeout passes). The controller's log orders the
//! commands of every broker, so concurrent requests see one order of creations and deletions; applying a command
//! decides what depends on the topics then (a name taken, an id gone) the same way on every broker.

/// A supported request whose body this broker cannot decode closes the connection.
undecodable: while head(c, i, _seq, key, version, _corr, fr, at) where not pure_request(key, version) && not stateful_body_ok(key, fr) {
    send kafka.close(c);
    delete queued(c, i, fr, at);
}

view create_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_CREATE_TOPICS,
    let Some(body) = request_body(fr), let Some(req) = decode_create_topics(body);

view delete_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_DELETE_TOPICS,
    let Some(body) = request_body(fr), let Some(d) = decode_delete_topics(body), let req = d.0;

view metadata_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_METADATA,
    let Some(body) = request_body(fr), let Some(req) = decode_metadata_request(body);

view describe_head(c, i, seq, corr, fr, at, req) =
    head(c, i, seq, key, _version, corr, fr, at), caught_up(), key == API_DESCRIBE_CONFIGS,
    let Some(body) = request_body(fr), let Some(req) = decode_describe_configs(body);

/// The commands this broker's requests wait on, by tag (`cluster.bls` sends them to the controller).
view wanted_cmd(tag, cmd) {
    create_cmd_of(_c, _i, tag, cmd);
    delete_cmd_of(_c, _i, tag, cmd);
    pid_cmd(_c, _i, tag, cmd);
    metadata_cmd_of(_c, _i, tag, cmd);
}

// ---------------------------------------------------------------- CreateTopics

/// Each CreateTopics request's context: with nothing taken (its commands), or with the topics that exist (a request
/// that only validates).
view create_context_of(c, ctx) = create_head(c, _, _, _, _, _, req), let ctx = create_context(create_names(req), []);
view validate_taken(c, names = collect!(n)) = per create_head(c, _, _, _, _, _, req), u in req.topics,
    let k = collision_key(u.name), topic_keys(k, n);
view validate_context_of(c, ctx) =
    create_head(c, _, _, _, _, _, req), validate_taken(c, taken), let ctx = create_context(create_names(req), taken);

/// Each topic entry's outcome against the request (and, validating only, the topics that exist), with the id and
/// placement it would get: functions of the request (its connection, index and entry), so a command sent again is the
/// same command.
view create_verdict(c, i, j, o) =
    create_head(c, i, _, _, _, _, req), broker_ids(ids), (j, t) in req.topics.enumerate(),
    create_context_of(c, ctx0), validate_context_of(c, ctx1), let ctx = if req.validate_only { ctx1 } else { ctx0 },
    let id = topic_id(hash64(("id", c, i, j, 0u64)), hash64(("id", c, i, j, 1u64))),
    let o = create_outcome(t, ctx, id, DEFAULT_PARTITIONS, DEFAULT_REPLICATION_FACTOR, ids, hash64(("start", c, i, j)));

/// Each entry decided before a taken name is looked for (a name given twice, illegal, colliding within the request).
view create_early(c, i, j) =
    create_head(c, i, _, _, _, _, req), create_context_of(c, ctx), (j, t) in req.topics.enumerate()
    where decided_before_taken(t, ctx);

/// The entries that become the request's command: every other entry of a request that does not only validate, with
/// what the broker decided after that (applied only if the name is not taken).
view create_item_of(c, i, j, o) =
    create_verdict(c, i, j, o), create_head(c, i, _, _, _, _, req), not create_early(c, i, j) where not req.validate_only;
view create_items(c, i, items = collect!(it)) = per create_head(c, i, _, _, _, _, _req), create_item_of(c, i, j, o),
    let it = create_item(j, o.error, o.topic.name, o.topic.id, o.topic.assignment, o.topic.configs);
view create_cmd_of(c, i, tag, cmd) =
    create_items(c, i, items), my_id(me), let tag = hash64(("create", c, i)), let cmd = encode_cmd(create_cmd(me, tag, items))
    where items.len() > 0;

/// Each entry's final outcome: decided at once, or once its command is applied.
view create_final(c, i, j, o) {
    create_verdict(c, i, j, o), create_early(c, i, j);
    create_verdict(c, i, j, o0), create_head(c, i, _, _, _, _, req), not create_early(c, i, j), let o = validated(o0)
        where req.validate_only;
    create_item_of(c, i, j, o0), create_cmd_of(c, i, tag, _cmd), my_id(me), outcome(me, tag, j, err, _id, _pid, _n),
        let o = applied_create(o0, err);
}
view create_finals(c, i, xs = collect!((j, o))) = per create_head(c, i, _, _, _, _, _req), create_final(c, i, j, o);
/// When the timeout passes, an entry still waiting fails with REQUEST_TIMED_OUT.
view create_late(c, i, j, o) {
    create_final(c, i, j, o);
    create_item_of(c, i, j, o0), not create_final(c, i, j, _), let o = create_timed_out(o0.topic.name);
}
view create_lates(c, i, xs = collect!((j, o))) = per create_head(c, i, _, _, _, _, _req), create_late(c, i, j, o);

answer_create: while create_head(c, i, seq, corr, fr, at, req), create_finals(c, i, xs) where xs.len() == req.topics.len() {
    send kafka.write(c, seq, [Part::Bytes(encode_create_topics_response(corr, create_outcomes_in(xs)))]);
    upsert answering(c, i + 1, seq + 1);
    delete queued(c, i, fr, at);
}
answer_create_late: while create_head(c, i, seq, corr, fr, at, req), create_finals(c, i, xs), create_lates(c, i, ys)
    where xs.len() < req.topics.len() && now() >= at + Duration::from_millis(req.timeout_ms as i64) {
    send kafka.write(c, seq, [Part::Bytes(encode_create_topics_response(corr, create_outcomes_in(ys)))]);
    upsert answering(c, i + 1, seq + 1);
    delete queued(c, i, fr, at);
}

// ---------------------------------------------------------------- DeleteTopics

view delete_context_of(c, ctx) = delete_head(c, _, _, _, _, _, req), let ctx = delete_context(req);

/// Each entry refused at once (malformed, a name mapping to an id the request also gives, an unknown name), or the
/// topic id its command deletes.
view delete_refusal(c, i, e, err) {
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate(), let err = INVALID_REQUEST
        where not delete_entry_ok(ctx, s);
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate(),
        let Some(name) = delete_by_name(ctx, s), mtopic(name, id, _, _), let err = DELETE_CLASH where id_supplied(ctx, id);
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate(),
        let Some(name) = delete_by_name(ctx, s), not mtopic(name, _, _, _), let err = UNKNOWN_TOPIC_OR_PARTITION;
}
view delete_target(c, i, e, id) {
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate(),
        let Some(name) = delete_by_name(ctx, s), mtopic(name, id, _, _) where not id_supplied(ctx, id);
    delete_head(c, i, _, _, _, _, req), delete_context_of(c, ctx), (e, s) in req.enumerate(), let Some(id) = delete_by_id(ctx, s);
}
/// A request's entries are resolved once, when it is first at the head: by name against the topics then, so the
/// request's own deletion (applied later) does not change what its entries named. A refusal is pinned with its
/// error, a deletion with its topic id.
table delete_pinned(c: Conn, i: u64, e: u64, id: Bytes, err: i16) key(c, i, e);
pin_refusal: while delete_refusal(c, i, e, err), not delete_pinned(c, i, _, _, _) {
    upsert delete_pinned(c, i, e, zero_uuid(), err);
}
pin_target: while delete_target(c, i, e, id), not delete_pinned(c, i, _, _, _) {
    upsert delete_pinned(c, i, e, id, NONE);
}
forget_pinned: while delete_pinned(c, i, e, id, err), not queued(c, i, _, _) {
    delete delete_pinned(c, i, e, id, err);
}

/// The request's command: its entries that delete a topic.
view delete_items(c, i, items = collect!(it)) = per delete_head(c, i, _, _, _, _, _req), delete_pinned(c, i, e, id, err),
    let it = delete_item(e, id) where err == NONE;
view delete_cmd_of(c, i, tag, cmd) =
    delete_items(c, i, items), my_id(me), let tag = hash64(("delete", c, i)), let cmd = encode_cmd(delete_cmd(me, tag, items))
    where items.len() > 0;

view delete_final(c, i, e, o) {
    delete_pinned(c, i, e, _id, err), delete_head(c, i, _, _, _, _, req), let Some(s) = req.get(e),
        let o = delete_refused(s, err) where err != NONE;
    delete_pinned(c, i, e, id, _err), delete_cmd_of(c, i, tag, _cmd), my_id(me), outcome(me, tag, e, err, _id, _pid, name),
        delete_head(c, i, _, _, _, _, req), let Some(s) = req.get(e), let o = delete_applied(s, id, name, err);
}
view delete_finals(c, i, xs = collect!((e, o))) = per delete_head(c, i, _, _, _, _, _req), delete_final(c, i, e, o);
view delete_late(c, i, e, o) {
    delete_final(c, i, e, o);
    delete_pinned(c, i, e, _id, err), not delete_final(c, i, e, _), delete_head(c, i, _, _, _, _, req),
        let Some(s) = req.get(e), let o = delete_refused(s, REQUEST_TIMED_OUT) where err == NONE;
}
view delete_lates(c, i, xs = collect!((e, o))) = per delete_head(c, i, _, _, _, _, _req), delete_late(c, i, e, o);
/// DeleteTopics' timeout (the request's only top-level field after the topics).
view delete_timeout(c, ms) = head(c, _, _, key, _version, _corr, fr, _at), key == API_DELETE_TOPICS,
    let Some(body) = request_body(fr), let Some(d) = decode_delete_topics(body), let ms = d.1;

answer_delete: while delete_head(c, i, seq, corr, fr, at, req), delete_finals(c, i, xs) where xs.len() == req.len() {
    send kafka.write(c, seq, [Part::Bytes(encode_delete_topics_response(corr, delete_outcomes_in(xs)))]);
    upsert answering(c, i + 1, seq + 1);
    delete queued(c, i, fr, at);
}
answer_delete_late: while delete_head(c, i, seq, corr, fr, at, req), delete_finals(c, i, xs), delete_lates(c, i, ys),
    delete_timeout(c, ms) where xs.len() < req.len() && now() >= at + Duration::from_millis(ms as i64) {
    send kafka.write(c, seq, [Part::Bytes(encode_delete_topics_response(corr, delete_outcomes_in(ys)))]);
    upsert answering(c, i + 1, seq + 1);
    delete queued(c, i, fr, at);
}

// ---------------------------------------------------------------- Metadata

/// Each partition as Metadata describes it (S8.md D7).
view part_info(tid, pi) {
    massign(tid, p, rs), partition_leader(g, epoch, l), broker(l, lid, _, _), let g = (tid, p),
        let pi = PartInfo { index: p, leader: lid, epoch: epoch as i32, replicas: rs };
    massign(tid, p, rs), not partition_leader(g, _, _), let g = (tid, p),
        let pi = PartInfo { index: p, leader: -1i32, epoch: -1i32, replicas: rs };
}
view topic_info(name, id, ps = collect!(pi)) = mtopic(name, id, _, _), part_info(id, pi);

/// The names a Metadata request auto-creates: those it asks for that may be created (auto-creation is on, the name
/// is legal and no other asked name collides with it), if one of them collides with no topic when the request is
/// first at the head; else none. They are pinned then, so the request's command stays the same while topics come and
/// go. The controller creates those still free when it applies the command, and the request is answered from the
/// metadata just after: the request takes effect at that point, so a name freed meanwhile is created too.
table metadata_pinned(c: Conn, i: u64, names: Vec<String>) key(c, i);
view metadata_free(c, i) = metadata_head(c, i, _, _, _, _, req), n in metadata_creates(req, AUTO_CREATE_TOPICS),
    let k = collision_key(n), not topic_keys(k, _);
pin_metadata: while metadata_head(c, i, _, _, _, _, req), not metadata_pinned(c, i, _) {
    if metadata_free(c, i) {
        upsert metadata_pinned(c, i, metadata_creates(req, AUTO_CREATE_TOPICS));
    }
    if not metadata_free(c, i) {
        upsert metadata_pinned(c, i, []);
    }
}
forget_metadata_pinned: while metadata_pinned(c, i, names), not queued(c, i, _, _) {
    delete metadata_pinned(c, i, names);
}
view metadata_cmd_of(c, i, tag, cmd) =
    metadata_pinned(c, i, names), broker_ids(ids), my_id(me), let tag = hash64(("auto", c, i)),
    let rf = if DEFAULT_REPLICATION_FACTOR as u64 > ids.len() { ids.len() as i16 } else { DEFAULT_REPLICATION_FACTOR },
    let cmd = encode_cmd(create_cmd(me, tag, metadata_items(c, i, names, ids, DEFAULT_PARTITIONS, rf))) where names.len() > 0;
view metadata_known(c, ts = collect!(TopicInfo { name: n, id: id, partitions: ps })) =
    per metadata_head(c, _, _, _, _, _, _req), topic_info(n, id, ps);
view broker_infos(bs = collect!(BrokerInfo { node_id: id, host: host, port: port, rack: None })) = broker(_, id, host, port);
/// The controller's leader as this broker knows it, or itself (KRaft brokers report a live broker; never -1).
view controller_or_none(id) {
    controller_id(id);
    my_id(id), not controller_id(_);
}

/// A Metadata request that auto-creates topics is answered once the controller has applied its command (the names
/// are then taken, by these topics or by others), or `METADATA_CREATE_WAIT` after it arrived: the topics are in its
/// answer, created by it (S7 answered them at once too; Kafka answers LEADER_NOT_AVAILABLE first). The names still
/// being created then are LEADER_NOT_AVAILABLE.
view metadata_creating(c, i, names) {
    metadata_pinned(c, i, names), metadata_cmd_of(c, i, tag, _cmd), my_id(me), not done(me, tag);
    metadata_pinned(c, i, _names), not metadata_cmd_of(c, i, _, _), let names = [];
    metadata_pinned(c, i, _names), metadata_cmd_of(c, i, tag, _cmd), my_id(me), done(me, tag), let names = [];
}
view metadata_ready(c, i) {
    metadata_creating(c, i, names) where names.len() == 0;
    metadata_pinned(c, i, _names), metadata_head(c, i, _, _, _, at, _req) where now() >= at + METADATA_CREATE_WAIT;
}
answer_metadata: while metadata_head(c, i, seq, corr, fr, at, req), metadata_ready(c, i), metadata_known(c, known),
    metadata_creating(c, i, names), broker_infos(bs), controller_or_none(ctl) {
    send kafka.write(c, seq, [Part::Bytes(encode_metadata_response(corr, req, bs, CLUSTER_ID, ctl, known, names.to_set()))]);
    upsert answering(c, i + 1, seq + 1);
    delete queued(c, i, fr, at);
}

// ---------------------------------------------------------------- DescribeConfigs

/// Per DescribeConfigs request: the configurations of the topics it names that exist.
view describe_found(c, sets = collect!((n, cfg))) = per describe_head(c, _, _, _, _, _, req), r in req,
    r.kind == CONFIG_TOPIC, let n = r.name, mtopic(n, _, _, cfg);

answer_describe: while describe_head(c, i, seq, corr, fr, at, req), describe_found(c, sets) {
    send kafka.write(c, seq, [Part::Bytes(encode_describe_configs_response(corr, describe_results(req, sets)))]);
    upsert answering(c, i + 1, seq + 1);
    delete queued(c, i, fr, at);
}
