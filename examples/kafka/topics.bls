//! Topics: CreateTopics v7, DeleteTopics v6 and DescribeConfigs v4 (all flexible), and the topic configurations this
//! broker knows. Pure functions: the node (`broker_node.bls`) decides with the broker's state and emits the changes.

const TOPIC_ALREADY_EXISTS: i16 = 36;
const INVALID_PARTITIONS: i16 = 37;
const INVALID_REPLICATION_FACTOR: i16 = 38;
const INVALID_REPLICA_ASSIGNMENT: i16 = 39;
const INVALID_CONFIG: i16 = 40;
const INVALID_REQUEST: i16 = 42;
const INVALID_TOPIC_EXCEPTION: i16 = 17;

/// DescribeConfigs resource types.
const CONFIG_TOPIC: i8 = 2;
const CONFIG_BROKER: i8 = 4;

/// The most partitions one topic may have: a request cannot make the broker create millions of rows.
const MAX_PARTITIONS: i32 = 10000;

// ---------------------------------------------------------------- configurations

/// A topic configuration this broker knows: its name, its default, and its Kafka type (`ConfigType`: 1 boolean,
/// 2 string, 3 int, 5 long).
struct ConfigKey { name: String, default: String, kind: i8 }

fn topic_configs() -> Vec<ConfigKey> {
    [
        ConfigKey { name: "cleanup.policy", default: "delete", kind: 2i8 },
        ConfigKey { name: "compression.type", default: "producer", kind: 2i8 },
        ConfigKey { name: "max.message.bytes", default: "1048588", kind: 3i8 },
        ConfigKey { name: "message.timestamp.type", default: "CreateTime", kind: 2i8 },
        ConfigKey { name: "min.insync.replicas", default: "1", kind: 3i8 },
        ConfigKey { name: "retention.bytes", default: "-1", kind: 5i8 },
        ConfigKey { name: "retention.ms", default: "604800000", kind: 5i8 },
        ConfigKey { name: "segment.bytes", default: "1073741824", kind: 3i8 },
    ]
}

/// Whether `value` is a value this broker supports for configuration `name` (`None` if `name` is unknown).
fn config_value_ok(name: String, value: String) -> Option<bool> {
    let nonneg_int = value.parse_i64().map(|n| n >= 0 && n <= 2147483647).unwrap_or(false);
    let at_least_minus_one = value.parse_i64().map(|n| n >= -1).unwrap_or(false);
    if name == "cleanup.policy" {
        // Compaction is out of scope (KAFKA.md).
        Some(value == "delete")
    } else if name == "compression.type" {
        // The broker keeps batches as produced: it never recompresses.
        Some(value == "producer")
    } else if name == "message.timestamp.type" {
        // LogAppendTime would rewrite the batch inside its CRC (out of scope).
        Some(value == "CreateTime")
    } else if name == "retention.ms" || name == "retention.bytes" {
        Some(at_least_minus_one)
    } else if name == "min.insync.replicas" {
        // Kafka's `atLeast(1)`.
        Some(value.parse_i64().map(|n| n >= 1 && n <= 2147483647).unwrap_or(false))
    } else if name == "max.message.bytes" || name == "segment.bytes" {
        Some(nonneg_int)
    } else {
        None
    }
}

/// The value of configuration `name` among `set` (the ones given at creation), or its default.
fn config_value(set: Vec<(String, String)>, name: String) -> String {
    match set.filter(|kv| kv.0 == name).first() {
        Some(kv) => kv.1,
        None => match topic_configs().filter(|k| k.name == name).first() {
            Some(k) => k.default,
            None => error("config_value: a configuration this broker does not know"),
        },
    }
}

/// An integer configuration's value (they are checked integers when the topic is created).
fn config_int(set: Vec<(String, String)>, name: String) -> i64 {
    match config_value(set, name).parse_i64() {
        Some(n) => n,
        None => error("config_int: a stored integer configuration is not an integer"),
    }
}

/// A topic's retention: milliseconds and bytes (-1 for unbounded).
fn retention(set: Vec<(String, String)>) -> (i64, i64) {
    (config_int(set, "retention.ms"), config_int(set, "retention.bytes"))
}

// ---------------------------------------------------------------- CreateTopics v7

struct CreatableTopic {
    name: String,
    partitions: i32,
    replication: i16,
    assignments: Vec<(i32, Vec<i32>)>,
    configs: Vec<(String, Option<String>)>,
}

struct CreateTopicsRequest { topics: Vec<CreatableTopic>, timeout_ms: i32, validate_only: bool }

fn decode_assignment(c: Cur) -> Option<((i32, Vec<i32>), Cur)> {
    read_i32(c).and_then(|p| read_compact_i32s(p.1).and_then(|b| skip_tags(b.1).map(|end| ((p.0, b.0), end))))
}

fn decode_creatable_config(c: Cur) -> Option<((String, Option<String>), Cur)> {
    read_compact_string(c).and_then(|n| read_compact_nullable_string(n.1).and_then(|v| {
        skip_tags(v.1).map(|end| ((n.0, v.0), end))
    }))
}

fn decode_creatable_topic(c: Cur) -> Option<(CreatableTopic, Cur)> {
    read_compact_string(c).and_then(|name| read_i32(name.1).and_then(|parts| read_i16(parts.1).and_then(|rf| {
        read_compact_len(rf.1).and_then(|na| {
            range(0, na.0)
                .fold(Some(([], na.1)), |acc, _i| acc.and_then(|a| decode_assignment(a.1).map(|x| (a.0.push(x.0), x.1))))
                .and_then(|asg| read_compact_len(asg.1).and_then(|nc| {
                    range(0, nc.0)
                        .fold(Some(([], nc.1)), |acc, _i| {
                            acc.and_then(|a| decode_creatable_config(a.1).map(|x| (a.0.push(x.0), x.1)))
                        })
                        .and_then(|cfg| skip_tags(cfg.1).map(|end| {
                            (CreatableTopic { name: name.0, partitions: parts.0, replication: rf.0, assignments: asg.0, configs: cfg.0 }, end)
                        }))
                }))
        })
    })))
}

fn decode_create_topics(c: Cur) -> Option<CreateTopicsRequest> {
    read_compact_len(c).and_then(|n| {
        range(0, n.0)
            .fold(Some(([], n.1)), |acc, _i| acc.and_then(|a| decode_creatable_topic(a.1).map(|t| (a.0.push(t.0), t.1))))
            .and_then(|ts| read_i32(ts.1).and_then(|timeout| read_bool(timeout.1).and_then(|vo| {
                skip_tags(vo.1).map(|_end| CreateTopicsRequest { topics: ts.0, timeout_ms: timeout.0, validate_only: vo.0 })
            })))
    })
}

/// Whether `name` is a legal topic name: 1 to 249 of `[a-zA-Z0-9._-]`, and not `.` or `..`.
fn topic_name_ok(name: String) -> bool {
    let b = name.to_utf8();
    b.len() >= 1 && b.len() <= 249 && name != "." && name != ".." && range(0, b.len()).all(|i| {
        match b.u8_at(i) {
            Some(x) => (x >= 97u8 && x <= 122u8) || (x >= 65u8 && x <= 90u8) || (x >= 48u8 && x <= 57u8)
                || x == 46u8 || x == 95u8 || x == 45u8,
            None => false,
        }
    })
}

/// A topic name with `.` replaced by `_`: Kafka refuses a topic whose name collides with another's this way,
/// because the two names give metrics the same name. (A name that is not a legal topic name is its own key.)
fn collision_key(name: String) -> String {
    let b = name.to_utf8();
    let swapped = Bytes::join(range(0, b.len()).map(|i| match b.u8_at(i) {
        Some(x) => Bytes::from_u8(if x == 46u8 { 95u8 } else { x }),
        None => error("collision_key: a position inside the name is out of range"),
    }));
    // Swapping one ASCII byte for another keeps the text UTF-8.
    match swapped.from_utf8() {
        Some(k) => k,
        None => error("collision_key: the swapped name is not UTF-8"),
    }
}

/// A topic id from two random words. Kafka's `Uuid.randomUuid` redraws the zero id, the reserved metadata topic id
/// (0, 1) and any id whose base64 form starts with `-` (first six bits 111110); this clears the top bit, so the last
/// cannot occur, and moves the two reserved ids to (0, 2) and (0, 3). Ids stay unpredictable 127-bit values.
fn topic_id(hi: u64, lo: u64) -> Bytes {
    let h = hi % 9223372036854775808u64;
    let l = if h == 0u64 && lo < 2u64 { lo + 2u64 } else { lo };
    Bytes::join([Bytes::from_u64_be(h), Bytes::from_u64_be(l)])
}

/// A topic a CreateTopics request asks for, as the broker will make it: its name, id, partition count and configs.
struct NewTopic { name: String, id: Bytes, partitions: i32, configs: Vec<(String, String)>, assignment: Vec<Vec<i32>> }

/// One requested topic's outcome: its error and message (`NONE` and `None` when it is (or, validating, would be)
/// created) and the topic.
struct CreateOutcome { error: i16, message: Option<String>, topic: NewTopic }

/// The names that occur more than once in `xs`.
fn repeated_names(xs: Vec<String>) -> Set<String> {
    // Each name's first position (a later pair overwrites an earlier one, so the pairs go in reverse).
    let first = xs.enumerate().reverse().map(|e| (e.1, e.0)).to_map();
    xs.enumerate().filter(|e| first.get(e.1) != Some(e.0)).map(|e| e.1).to_set()
}

/// The ids that occur more than once in `xs`.
fn repeated_ids(xs: Vec<Bytes>) -> Set<Bytes> {
    let first = xs.enumerate().reverse().map(|e| (e.1, e.0)).to_map();
    xs.enumerate().filter(|e| first.get(e.1) != Some(e.0)).map(|e| e.1).to_set()
}

/// The collision keys that two different names of `keyed` (key, name) share.
fn colliding_keys(keyed: Vec<(String, String)>) -> Set<String> {
    // Each key's first name: a key collides when another name has it.
    let first = keyed.reverse().to_map();
    keyed.filter(|kn| first.get(kn.0) != Some(kn.1)).map(|kn| kn.0).to_set()
}

/// What deciding one entry of a CreateTopics request needs to know of the whole request, computed once for it: the
/// names it gives more than once, the collision keys two of its names share, and the names that are taken and their
/// keys.
struct CreateContext { repeated: Set<String>, colliding: Set<String>, taken: Set<String>, taken_keys: Set<String> }

/// `names` is every name the request asks for, `taken` the names that exist or that other connections create first
/// this tick.
fn create_context(names: Vec<String>, taken: Vec<String>) -> CreateContext {
    CreateContext {
        repeated: repeated_names(names),
        colliding: colliding_keys(names.map(|n| (collision_key(n), n))),
        taken: taken.to_set(),
        taken_keys: taken.map(|n| collision_key(n)).to_set(),
    }
}

/// Decides one requested topic: a topic named twice in the request is refused, and so are topics whose names
/// collide, and a topic whose name is taken (equal to the topic's name or colliding with it); `id` is the id it
/// gets.
/// `ids` are the cluster's broker ids, in order; a topic without a manual assignment is placed from `start` (D11), with
/// `default_rf` replicas when it asks for none.
fn create_outcome(t: CreatableTopic, ctx: CreateContext, id: Bytes, default_partitions: i32, default_rf: i16, ids: Vec<i32>, start: u64) -> CreateOutcome {
    let dup = ctx.repeated.contains(t.name);
    let key = collision_key(t.name);
    let collides_within = ctx.colliding.contains(key);
    let partitions = if t.assignments.is_empty() { if t.partitions == -1i32 { default_partitions } else { t.partitions } } else { t.assignments.len() as i32 };
    let bad_assignment = not t.assignments.is_empty() && (
        t.partitions != -1i32 || t.replication != -1i16
    );
    let manual_rf = match t.assignments.first() {
        Some(a) => a.1.len(),
        None => 0,
    };
    let known = ids.to_set();
    let assignment_nodes_ok = t.assignments.enumerate().all(|e| {
        let (i, a) = e;
        let (p, brokers) = a;
        p == i as i32 && brokers.len() == manual_rf && manual_rf > 0 && brokers.to_set().len() == manual_rf
            && brokers.all(|b| known.contains(b))
    });
    let rf = if not t.assignments.is_empty() { manual_rf as i16 } else if t.replication == -1i16 { default_rf } else { t.replication };
    let bad_config = t.configs.any(|kv| match kv.1 {
        Some(v) => config_value_ok(kv.0, v) != Some(true),
        None => true,
    });
    let configs = t.configs.filter_map(|kv| kv.1.map(|v| (kv.0, v)));
    if dup {
        create_failed(t.name, INVALID_REQUEST, "the request names this topic more than once")
    } else if not topic_name_ok(t.name) {
        create_failed(t.name, INVALID_TOPIC_EXCEPTION, "a topic name is 1 to 249 characters of [a-zA-Z0-9._-], not . or ..")
    } else if collides_within {
        create_failed(t.name, INVALID_TOPIC_EXCEPTION, "the request names topics whose names collide ('.' against '_')")
    } else if ctx.taken.contains(t.name) {
        create_failed(t.name, TOPIC_ALREADY_EXISTS, "the topic already exists")
    } else if ctx.taken_keys.contains(key) {
        create_failed(t.name, INVALID_TOPIC_EXCEPTION, "the name collides with an existing topic's ('.' against '_')")
    } else if bad_assignment {
        create_failed(t.name, INVALID_REQUEST, "a manual assignment needs the partition count and replication factor to be -1")
    } else if not assignment_nodes_ok {
        create_failed(t.name, INVALID_REPLICA_ASSIGNMENT, "every partition must be assigned, in order, to the same number of distinct, known brokers")
    } else if partitions < 1i32 || partitions > MAX_PARTITIONS {
        create_failed(t.name, INVALID_PARTITIONS, "the partition count must be between 1 and 10000")
    } else if rf < 1i16 || rf as u64 > ids.len() {
        create_failed(t.name, INVALID_REPLICATION_FACTOR, "the replication factor must be between 1 and the number of brokers")
    } else if bad_config {
        create_failed(t.name, INVALID_CONFIG, "a configuration is unknown, null, or has a value this broker does not support")
    } else {
        let assignment = if t.assignments.is_empty() { assign(ids, partitions, rf, start) } else { t.assignments.map(|a| a.1) };
        CreateOutcome { error: NONE, message: None, topic: NewTopic { name: t.name, id: id, partitions: partitions, configs: configs, assignment: assignment } }
    }
}

fn create_failed(name: String, code: i16, why: String) -> CreateOutcome {
    CreateOutcome { error: code, message: Some(why), topic: NewTopic { name: name, id: zero_uuid(), partitions: -1i32, configs: [], assignment: [] } }
}

fn create_names(req: CreateTopicsRequest) -> Vec<String> {
    req.topics.map(|t| t.name)
}

/// A creation's outcome once the controller applied it: refused for a name taken, or as decided at the broker (the
/// topic created, or a later check failed).
fn applied_create(o: CreateOutcome, error: i16) -> CreateOutcome {
    if error == TOPIC_ALREADY_EXISTS {
        create_failed(o.topic.name, error, "the topic already exists")
    } else if error == INVALID_TOPIC_EXCEPTION {
        create_failed(o.topic.name, error, "the name collides with an existing topic's ('.' against '_')")
    } else {
        o
    }
}

/// A request that only validates gets its topics with the zero id, as Kafka's does.
fn validated(o: CreateOutcome) -> CreateOutcome {
    CreateOutcome { error: o.error, message: o.message, topic: NewTopic {
        name: o.topic.name, id: zero_uuid(), partitions: o.topic.partitions, configs: o.topic.configs, assignment: o.topic.assignment,
    } }
}

/// A topic entry whose creation did not finish within the request's timeout.
fn create_timed_out(name: String) -> CreateOutcome {
    create_failed(name, REQUEST_TIMED_OUT, "the controller did not apply the creation in time")
}

fn encode_created_config(name: String, value: String, set: bool) -> Bytes {
    // ConfigSource: 1 a topic's own configuration, 5 the default.
    Bytes::join([
        enc_compact_string(name), enc_compact_nullable_string(Some(value)), enc_bool(false),
        Bytes::from_i8(if set { 1i8 } else { 5i8 }), enc_bool(false), no_tags(),
    ])
}

/// A topic's full configuration, in `topic_configs` order: what CreateTopics v5+ returns for a created topic.
fn encode_topic_configs(set: Vec<(String, String)>) -> Vec<Bytes> {
    topic_configs().map(|k| encode_created_config(k.name, config_value(set, k.name), set.any(|kv| kv.0 == k.name)))
}

fn encode_create_outcome(o: CreateOutcome) -> Bytes {
    let ok = o.error == NONE;
    Bytes::join([
        enc_compact_string(o.topic.name),
        o.topic.id,
        Bytes::from_i16_be(o.error),
        enc_compact_nullable_string(o.message),
        Bytes::from_i32_be(if ok { o.topic.partitions } else { -1i32 }),
        Bytes::from_i16_be(if ok { replication_of(o.topic.assignment) } else { -1i16 }),
        enc_compact_nullable_array(if ok { Some(encode_topic_configs(o.topic.configs)) } else { None }),
        no_tags(),
    ])
}

fn encode_create_topics_response(correlation_id: i32, outcomes: Vec<CreateOutcome>) -> Bytes {
    frame(Bytes::join([
        response_header_v1(correlation_id),
        Bytes::from_i32_be(0i32),
        enc_compact_array(outcomes.map(|o| encode_create_outcome(o))),
        no_tags(),
    ]))
}

// ---------------------------------------------------------------- DeleteTopics v6

/// A topic to delete: by name, or by id (a zero id means "by name").
struct DeleteTopicState { name: Option<String>, id: Bytes }

fn decode_delete_topic_state(c: Cur) -> Option<(DeleteTopicState, Cur)> {
    read_compact_nullable_string(c).and_then(|n| read_uuid(n.1).and_then(|id| {
        skip_tags(id.1).map(|end| (DeleteTopicState { name: n.0, id: id.0 }, end))
    }))
}

fn decode_delete_topics(c: Cur) -> Option<(Vec<DeleteTopicState>, i32)> {
    read_compact_len(c).and_then(|n| {
        range(0, n.0)
            .fold(Some(([], n.1)), |acc, _i| acc.and_then(|a| decode_delete_topic_state(a.1).map(|t| (a.0.push(t.0), t.1))))
            .and_then(|ts| read_i32(ts.1).and_then(|timeout| skip_tags(timeout.1).map(|_end| (ts.0, timeout.0))))
    })
}

/// What judging one entry of a DeleteTopics request needs to know of the whole request, computed once for it: the
/// ids its entries by id give more than once, the names its entries by name give more than once, and every id it
/// gives.
struct DeleteContext { repeated_ids: Set<Bytes>, repeated_names: Set<String>, ids: Set<Bytes> }

fn delete_context(req: Vec<DeleteTopicState>) -> DeleteContext {
    let ids = req.filter(|s| s.id != zero_uuid()).map(|s| s.id);
    let names = req.filter_map(|s| if s.id == zero_uuid() { s.name } else { None });
    DeleteContext { repeated_ids: repeated_ids(ids), repeated_names: repeated_names(names), ids: ids.to_set() }
}

/// Whether entry `s` of a DeleteTopics request (whose context is `ctx`) is well formed: it names a topic by name or
/// by id, not both, and no other entry names the same topic the same way.
fn delete_entry_ok(ctx: DeleteContext, s: DeleteTopicState) -> bool {
    if s.id != zero_uuid() {
        s.name.is_none() && not ctx.repeated_ids.contains(s.id)
    } else {
        match s.name {
            Some(n) => not ctx.repeated_names.contains(n),
            None => true,
        }
    }
}

/// The name entry `s` deletes the topic of, if it is a well-formed entry by name.
fn delete_by_name(ctx: DeleteContext, s: DeleteTopicState) -> Option<String> {
    if delete_entry_ok(ctx, s) && s.id == zero_uuid() { s.name } else { None }
}

/// The id entry `s` deletes the topic of, if it is a well-formed entry by id.
fn delete_by_id(ctx: DeleteContext, s: DeleteTopicState) -> Option<Bytes> {
    if delete_entry_ok(ctx, s) && s.id != zero_uuid() { Some(s.id) } else { None }
}

/// Whether an entry of the request names topic `id` by id: an entry by name that finds this topic is then refused,
/// as Kafka refuses a name that maps to an id the request already gives.
fn id_supplied(ctx: DeleteContext, id: Bytes) -> bool {
    ctx.ids.contains(id)
}

/// One deletion's result: the topic's name and id as the entry gave them (both when it is deleted), the error and
/// its message.
struct DeleteOutcome { name: Option<String>, id: Bytes, error: i16, message: Option<String> }

/// An entry's outcome decided at the broker it reached, before any command: a malformed entry, a name that maps to
/// an id the request also gives, a name no topic has.
fn delete_refused(s: DeleteTopicState, error: i16) -> DeleteOutcome {
    if error == UNKNOWN_TOPIC_OR_PARTITION {
        DeleteOutcome { name: s.name, id: zero_uuid(), error: error, message: Some("the topic does not exist") }
    } else if error == REQUEST_TIMED_OUT {
        DeleteOutcome { name: s.name, id: s.id, error: error, message: Some("the controller did not apply the deletion in time") }
    } else {
        DeleteOutcome { name: s.name, id: s.id, error: INVALID_REQUEST, message: Some(if error == INVALID_REQUEST {
            "an entry names a topic by name or by id, not both, and only once"
        } else {
            "the topic name maps to an id the request also gives"
        }) }
    }
}

/// Entry `s`'s outcome once the controller applied its deletion of topic `id` (named `name` there): gone already
/// (another request deleted it first), it is unknown as the entry named it, by name or by id.
fn delete_applied(s: DeleteTopicState, id: Bytes, name: String, error: i16) -> DeleteOutcome {
    if error == NONE {
        DeleteOutcome { name: Some(name), id: id, error: NONE, message: None }
    } else if s.id == zero_uuid() {
        DeleteOutcome { name: s.name, id: zero_uuid(), error: UNKNOWN_TOPIC_OR_PARTITION, message: Some("the topic does not exist") }
    } else {
        DeleteOutcome { name: None, id: id, error: UNKNOWN_TOPIC_ID, message: Some("the topic id does not exist") }
    }
}

/// Marks a name entry whose topic another entry names by id (not a Kafka error code: `delete_refused` maps it).
const DELETE_CLASH: i16 = -2;

fn encode_delete_outcome(o: DeleteOutcome) -> Bytes {
    Bytes::join([
        enc_compact_nullable_string(o.name), o.id, Bytes::from_i16_be(o.error), enc_compact_nullable_string(o.message),
        no_tags(),
    ])
}

fn encode_delete_topics_response(correlation_id: i32, outcomes: Vec<DeleteOutcome>) -> Bytes {
    frame(Bytes::join([
        response_header_v1(correlation_id),
        Bytes::from_i32_be(0i32),
        enc_compact_array(outcomes.map(|o| encode_delete_outcome(o))),
        no_tags(),
    ]))
}

// ---------------------------------------------------------------- DescribeConfigs v4

/// A resource whose configuration is asked for: its type (2 a topic, 4 a broker), name and the keys wanted (`None`,
/// or empty, for all).
struct ConfigResource { kind: i8, name: String, keys: Option<Vec<String>> }

fn decode_config_resource(c: Cur) -> Option<(ConfigResource, Cur)> {
    read_i8(c).and_then(|k| read_compact_string(k.1).and_then(|n| read_compact_nullable_strings(n.1).and_then(|keys| {
        skip_tags(keys.1).map(|end| (ConfigResource { kind: k.0, name: n.0, keys: keys.0 }, end))
    })))
}

fn decode_describe_configs(c: Cur) -> Option<Vec<ConfigResource>> {
    read_compact_len(c).and_then(|n| {
        range(0, n.0)
            .fold(Some(([], n.1)), |acc, _i| acc.and_then(|a| decode_config_resource(a.1).map(|r| (a.0.push(r.0), r.1))))
            .and_then(|rs| read_bool(rs.1).and_then(|syn| read_bool(syn.1).and_then(|doc| skip_tags(doc.1).map(|_end| rs.0))))
    })
}

fn encode_described_config(k: ConfigKey, set: Vec<(String, String)>) -> Bytes {
    let own = set.any(|kv| kv.0 == k.name);
    Bytes::join([
        enc_compact_string(k.name),
        enc_compact_nullable_string(Some(config_value(set, k.name))),
        enc_bool(false),
        Bytes::from_i8(if own { 1i8 } else { 5i8 }),
        enc_bool(false),
        enc_compact_array([]),
        Bytes::from_i8(k.kind),
        enc_compact_nullable_string(None),
        no_tags(),
    ])
}

/// One resource's result. `set` is the topic's own configs when it exists (`None`: unknown topic).
fn encode_config_result(r: ConfigResource, set: Option<Vec<(String, String)>>) -> Bytes {
    let (error, message, configs) = if r.kind == CONFIG_BROKER {
        // A broker: no configuration is described.
        (NONE, None, [])
    } else if r.kind != CONFIG_TOPIC {
        (INVALID_REQUEST, Some("only topics and brokers are described"), [])
    } else {
        match set {
            Some(s) => {
                // As Kafka does, an empty list of keys asks for every configuration, as a null one does.
                let wanted = topic_configs().filter(|k| match r.keys {
                    Some(ks) => ks.is_empty() || ks.any(|x| x == k.name),
                    None => true,
                });
                (NONE, None, wanted.map(|k| encode_described_config(k, s)))
            }
            None => (UNKNOWN_TOPIC_OR_PARTITION, Some("the topic does not exist"), []),
        }
    };
    Bytes::join([
        Bytes::from_i16_be(error),
        enc_compact_nullable_string(message),
        Bytes::from_i8(r.kind),
        enc_compact_string(r.name),
        enc_compact_array(configs),
        no_tags(),
    ])
}

fn encode_describe_configs_response(correlation_id: i32, results: Vec<Bytes>) -> Bytes {
    frame(Bytes::join([
        response_header_v1(correlation_id),
        Bytes::from_i32_be(0i32),
        enc_compact_array(results),
        no_tags(),
    ]))
}

/// Every resource's result. `sets` holds the configurations of the named topics that exist.
fn describe_results(req: Vec<ConfigResource>, sets: Vec<(String, Vec<(String, String)>)>) -> Vec<Bytes> {
    let set_of = sets.to_map();
    req.map(|r| {
        let set = if r.kind == CONFIG_TOPIC { set_of.get(r.name) } else { None };
        encode_config_result(r, set)
    })
}

/// A topic's replication factor: the length of its replica lists.
fn replication_of(assignment: Vec<Vec<i32>>) -> i16 {
    match assignment.first() {
        Some(rs) => rs.len() as i16,
        None => 0i16,
    }
}

/// A request's outcomes by entry, in entry order, without the entry numbers.
/// Whether an entry's outcome is decided before the topics are looked at (a name given twice, an illegal name, two
/// names of the request that collide): as Kafka's controller, a taken name is checked next, before the partition
/// count, the replication factor, the assignment and the configurations.
fn decided_before_taken(t: CreatableTopic, ctx: CreateContext) -> bool {
    ctx.repeated.contains(t.name) || not topic_name_ok(t.name) || ctx.colliding.contains(collision_key(t.name))
}

fn create_outcomes_in(xs: Vec<(u64, CreateOutcome)>) -> Vec<CreateOutcome> {
    xs.map(|x| x.1)
}

fn delete_outcomes_in(xs: Vec<(u64, DeleteOutcome)>) -> Vec<DeleteOutcome> {
    xs.map(|x| x.1)
}

/// The replica assignment of a new topic (docs/plan/notes/S8.md D11): partition `p`'s replicas are `rf` brokers in id order from
/// `start + p`, round-robin, as Kafka's rack-unaware assignment places them (the first is the preferred leader).
fn assign(ids: Vec<i32>, partitions: i32, rf: i16, start: u64) -> Vec<Vec<i32>> {
    let n = ids.len();
    range(0, partitions as u64).map(|p| range(0, rf as u64).map(|j| match ids.get((start + p + j) % n) {
        Some(id) => id,
        None => error("assign: a position past the broker list"),
    }))
}

