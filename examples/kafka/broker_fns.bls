//! The broker's request handling: the answer to each request frame (pure functions; `broker.bls` has the node).

/// The response to one request frame, or `None` to close the connection.
fn answer(req: Bytes) -> Option<Bytes> {
    let c = cur(req);
    request_prefix(c).and_then(|p| {
        let (key, version, corr, _rest) = p;
        if key == API_VERSIONS && not supports(key, version) {
            // Any version this broker does not know, even one whose header it cannot read (KIP-511).
            Some(encode_api_versions_unsupported(corr))
        } else if not supports(key, version) {
            None
        } else {
            request_header(c).and_then(|h| {
                let body = h.1;
                if key == API_VERSIONS {
                    decode_api_versions_request(body).map(|_r| encode_api_versions_response(corr))
                } else {
                    error("answer: a request that reads the broker's state reached the pure answers")
                }
            })
        }
    })
}

/// A request frame's API key, version and correlation id, if it holds a request header's fixed part.
fn frame_prefix(fr: Bytes) -> Option<(i16, i16, i32)> {
    request_prefix(cur(fr)).map(|p| (p.0, p.1, p.2))
}

fn frame_readable(fr: Bytes) -> bool {
    frame_prefix(fr).is_some()
}

/// Whether a request is answered from its bytes alone: ApiVersions, and anything unsupported (which closes the
/// connection).
fn pure_request(key: i16, version: i16) -> bool {
    key == API_VERSIONS || not supports(key, version)
}

/// A request frame's body: what follows its header.
fn request_body(fr: Bytes) -> Option<Cur> {
    request_header(cur(fr)).map(|h| h.1)
}

/// Whether a request that reads the broker's state has a body this broker can decode (otherwise the connection
/// closes, as Kafka closes it on a request it cannot parse).
fn stateful_body_ok(key: i16, fr: Bytes) -> bool {
    request_body(fr).map(|b| {
        if key == API_METADATA {
            decode_metadata_request(b).is_some()
        } else if key == API_CREATE_TOPICS {
            decode_create_topics(b).is_some()
        } else if key == API_DELETE_TOPICS {
            decode_delete_topics(b).is_some()
        } else if key == API_DESCRIBE_CONFIGS {
            decode_describe_configs(b).is_some()
        } else if key == API_PRODUCE {
            decode_produce(b).is_some()
        } else if key == API_INIT_PRODUCER_ID {
            decode_init_producer_id(b).is_some()
        } else if key == API_FETCH {
            decode_fetch(b).is_some()
        } else if key == API_LIST_OFFSETS {
            frame_prefix(fr).and_then(|p| decode_list_offsets(b, p.1)).is_some()
        } else if key == API_DESCRIBE_CLUSTER {
            frame_prefix(fr).and_then(|p| decode_describe_cluster(b, p.1)).is_some()
        } else {
            error("stateful_body_ok: a supported API with no decoder here")
        }
    }).unwrap_or(false)
}

/// Whether `answer` answers the frame (otherwise the connection closes).
fn answered(fr: Bytes) -> bool {
    answer(fr).is_some()
}
