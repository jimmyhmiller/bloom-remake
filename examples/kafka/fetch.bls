//! Fetch, versions 16 and 17 (flexible; v17 adds only a tagged field), and ListOffsets, versions 7 to 10 (flexible).
//! Pure functions: the node (`fetch_node.bls`) finds the batches and answers.

const OFFSET_OUT_OF_RANGE: i16 = 1;
const FETCH_SESSION_ID_NOT_FOUND: i16 = 70;
const INVALID_FETCH_SESSION_EPOCH: i16 = 71;
const FENCED_LEADER_EPOCH: i16 = 74;
const UNKNOWN_LEADER_EPOCH: i16 = 75;

/// The most batches one partition's answer walks (its byte limit usually stops it first).
const MAX_FETCH_BATCHES: u64 = 4096;

/// Every partition is led by this broker at epoch 0.

// ---------------------------------------------------------------- Fetch v16–v17

/// A partition to fetch; its last fetched epoch and log start (follower fields) are read past.
format FetchPartition {
    partition: i32,
    leader_epoch: i32,
    fetch_offset: i64,
    ignored(i32, -1i32),
    ignored(i64, -1i64),
    max_bytes: i32,
    tags
}

format FetchTopic {
    topic_id: uuid,
    partitions: compact_array(FetchPartition),
    tags
}

/// FetchRequest v16–v17; the forgotten topics (sessions only; this broker keeps none) and the rack are read past.
format FetchRequest {
    max_wait_ms: i32,
    min_bytes: i32,
    max_bytes: i32,
    isolation_level: i8,
    session_id: i32,
    session_epoch: i32,
    topics: compact_array(FetchTopic),
    ignored(compact_array((uuid, compact_array(i32), tags)), []),
    ignored(compact_string, ""),
    tags,
}

fn decode_fetch(c: Cur) -> Option<FetchRequest> {
    FetchRequest::decode(c.buf, c.pos).map(|r| r.0)
}

/// A request's partitions, in request order: (entry, topic id, partition).
fn fetch_entries(req: FetchRequest) -> Vec<(u64, Bytes, FetchPartition)> {
    let flat = req.topics.map(|t| t.partitions.map(|p| (t.topic_id, p))).flatten();
    flat.enumerate().map(|e| (e.0, e.1.0, e.1.1))
}

/// A whole-request error: a fetch session this broker never created (it creates none: session id 0 with epoch 0
/// or -1 is a sessionless full fetch, KIP-227).
fn fetch_session_error(req: FetchRequest) -> Option<i16> {
    if req.session_id != 0i32 {
        Some(FETCH_SESSION_ID_NOT_FOUND)
    } else if req.session_epoch != 0i32 && req.session_epoch != -1i32 {
        Some(INVALID_FETCH_SESSION_EPOCH)
    } else {
        None
    }
}

/// The error of a request's leader epoch against the partition leader's `current` (KIP-320, S8.md D10): -1 is unset;
/// an older one is fenced, a newer one unknown (this broker has not heard of that leader yet).
fn leader_epoch_error(requested: i32, current: u64) -> Option<i16> {
    if requested == -1i32 || requested as i64 == current as i64 {
        None
    } else if (requested as i64) < (current as i64) {
        Some(FENCED_LEADER_EPOCH)
    } else {
        Some(UNKNOWN_LEADER_EPOCH)
    }
}

/// One partition's answer: its error, high watermark, log start, and its batches (blob, size) in offset order.
struct FetchAnswer {
    error: i16,
    high_watermark: i64,
    log_start: i64,
    batches: Vec<Blob>
}

fn fetch_failed(error: i16) -> FetchAnswer {
    FetchAnswer { error: error, high_watermark: -1i64, log_start: -1i64, batches: [] }
}

/// The batches a partition keeps while they are trimmed: those kept, the bytes left for the partition and for the
/// response, whether the response has data yet, and whether this partition stopped (a batch did not fit).
struct Trim {
    kept: Vec<Blob>,
    room: i64,
    left: i64,
    any: bool,
    stopped: bool
}

fn trim_batch(t: Trim, b: Blob) -> Trim {
    let size = b.len() as i64;
    if t.stopped {
        t
    } else if not t.any || size <= t.room {
        Trim { kept: t.kept.push(b), room: t.room - size, left: t.left - size, any: true, stopped: false }
    } else {
        Trim { kept: t.kept, room: t.room, left: t.left, any: t.any, stopped: true }
    }
}

/// The answers trimmed to the byte limits, in request order: each partition takes its batches, in offset order,
/// while they fit both its own limit and what is left of the response's, and stops at the first that does not; but
/// the response's first batch is kept whatever its size, so a consumer can always make progress (KIP-74).
/// `answers` holds each entry's answer with its partition's limit.
fn trim_to(answers: Vec<(u64, FetchAnswer, i64)>, max_bytes: i64) -> Vec<(u64, FetchAnswer)> {
    let start: (Vec<(u64, FetchAnswer)>, i64, bool) = ([], max_bytes, false);
    let end = answers.fold(
        start,
        |acc, x| {
            let (out, left, any) = acc;
            let a = x.1;
            let room = if x.2 < left { x.2 } else { left };
            let t = a.batches.fold(
                Trim { kept: [], room: room, left: left, any: any, stopped: false },
                |t, b| trim_batch(t, b)
            );
            let answer = FetchAnswer {
                error: a.error,
                high_watermark: a.high_watermark,
                log_start: a.log_start,
                batches: t.kept
            };
            (out.push((x.0, answer)), t.left, t.any)
        }
    );
    end.0
}

/// A partition's walked batches, in walk order.
fn blobs_of(bs: Vec<(u64, Blob)>) -> Vec<Blob> {
    bs.map(|x| x.1)
}

/// Whether a Fetch can be answered now: a partition failed, or its data reaches `min_bytes`.
fn fetch_ready(answers: Vec<(u64, FetchAnswer)>, min_bytes: i64) -> bool {
    answers.any(|x| x.1.error != NONE) || fetch_bytes(answers) >= min_bytes
}

/// The request without its partitions, for an answer that carries only a request-level error.
fn without_topics(req: FetchRequest) -> FetchRequest {
    FetchRequest {
        max_wait_ms: req.max_wait_ms,
        min_bytes: req.min_bytes,
        max_bytes: req.max_bytes,
        isolation_level: req.isolation_level,
        session_id: req.session_id,
        session_epoch: req.session_epoch,
        topics: [],
    }
}

/// How many bytes the answers' batches hold.
fn fetch_bytes(answers: Vec<(u64, FetchAnswer)>) -> i64 {
    answers.fold(0i64, |n, x| n + x.1.batches.fold(0i64, |m, b| m + b.len() as i64))
}

/// FetchResponse v16–v17 as the parts of one stream write: the header and each partition's fields as bytes, and
/// its batches as blob ranges, so the stored batches are sent without being copied through the program.
fn fetch_response_parts(
    correlation_id: i32,
    error: i16,
    req: FetchRequest,
    answers: Vec<(u64, FetchAnswer)>
) -> Vec<Part> {
    let groups = by_topic(req.topics.map(|t| t.partitions.len()), answers);
    let topic_parts = req.topics.enumerate().map(|e| {
        let (k, t) = e;
        let partitions = t.partitions.enumerate().map(|pe| match groups.get(k).and_then(|g| g.get(pe.0)) {
            Some(a) => fetch_partition_parts(pe.1.partition, a),
            None => error("fetch_response_parts: a partition entry has no answer"),
        });
        [
            Part::Bytes(Bytes::join([t.topic_id, Bytes::uvarint(t.partitions.len() + 1)]))
        ].concat(partitions.flatten()).push(Part::Bytes(no_tags()))
    });
    let body = [
        Part::Bytes(Bytes::join([
            response_header_v1(correlation_id),
            Bytes::from_i32_be(0i32),
            Bytes::from_i16_be(error),
            Bytes::from_i32_be(0i32),
            Bytes::uvarint(req.topics.len() + 1),
        ]))
    ].concat(topic_parts.flatten()).push(Part::Bytes(no_tags()));
    let size = body.fold(0, |n, p| n + part_len(p));
    [Part::Bytes(Bytes::from_u32_be(size as u32))].concat(body)
}

/// The bytes a part sends.
fn part_len(p: Part) -> u64 {
    match p {
        Part::Bytes(b) => b.len(),
        Part::Blob(_b, lo, hi) => hi - lo,
    }
}

fn fetch_partition_parts(index: i32, a: FetchAnswer) -> Vec<Part> {
    let records = a.batches.fold(0, |n, b| n + b.len());
    [
        Part::Bytes(Bytes::join([
            Bytes::from_i32_be(index),
            Bytes::from_i16_be(a.error),
            Bytes::from_i64_be(a.high_watermark),
            Bytes::from_i64_be(a.high_watermark),
            Bytes::from_i64_be(a.log_start),
            Bytes::uvarint(0),
            Bytes::from_i32_be(-1i32),
            Bytes::uvarint(records + 1),
        ]))
    ].concat(a.batches.map(|b| Part::Blob(b, 0, b.len()))).push(Part::Bytes(no_tags()))
}

// ---------------------------------------------------------------- ListOffsets v7–v10

const EARLIEST_TIMESTAMP: i64 = -2;
const LATEST_TIMESTAMP: i64 = -1;
const MAX_TIMESTAMP: i64 = -3;
const EARLIEST_LOCAL_TIMESTAMP: i64 = -4;
const LATEST_TIERED_TIMESTAMP: i64 = -5;

/// Whether a ListOffsets timestamp is a search for the first record at or after it: any timestamp but the special
/// ones (-1 to -5), as Kafka treats one it does not know.
fn searches(t: i64) -> bool {
    t >= 0i64 || t < LATEST_TIERED_TIMESTAMP
}

format ListOffsetsPartition {
    partition: i32,
    leader_epoch: i32,
    timestamp: i64,
    tags
}
format ListOffsetsTopic {
    name: compact_string,
    partitions: compact_array(ListOffsetsPartition),
    tags
}
/// ListOffsets v7–v10 (the replica id is read past; v10 adds a timeout after the topics).
format ListOffsetsRequest(version: i16) {
    ignored(i32, -1i32),
    isolation_level: i8,
    topics: compact_array(ListOffsetsTopic),
    ignored(i32, 0i32) if version >= 10i16,
    tags,
}

fn decode_list_offsets(c: Cur, version: i16) -> Option<ListOffsetsRequest> {
    ListOffsetsRequest::decode(c.buf, c.pos, version).map(|r| r.0)
}

/// A request's partitions, in request order: (entry, topic, partition).
fn list_offsets_entries(req: ListOffsetsRequest) -> Vec<(u64, String, ListOffsetsPartition)> {
    let flat = req.topics.map(|t| t.partitions.map(|p| (t.name, p))).flatten();
    flat.enumerate().map(|e| (e.0, e.1.0, e.1.1))
}

/// One partition's answer: error, timestamp, offset, leader epoch.
struct OffsetAnswer {
    error: i16,
    timestamp: i64,
    offset: i64,
    leader_epoch: i32
}

/// The partition's new leader has not settled its high watermark yet (retriable).
const OFFSET_NOT_AVAILABLE: i16 = 78;

fn offset_failed(error: i16) -> OffsetAnswer {
    OffsetAnswer { error: error, timestamp: -1i64, offset: -1i64, leader_epoch: -1i32 }
}

/// No offset for the timestamp asked (Kafka answers -1 with no error).
fn no_offset() -> OffsetAnswer {
    OffsetAnswer { error: NONE, timestamp: -1i64, offset: -1i64, leader_epoch: -1i32 }
}

fn offset_at(timestamp: i64, offset: i64) -> OffsetAnswer {
    OffsetAnswer { error: NONE, timestamp: timestamp, offset: offset, leader_epoch: -1i32 }
}

format OffsetPartition {
    partition: i32,
    error: i16,
    timestamp: i64,
    offset: i64,
    leader_epoch: i32,
    tags
}
format OffsetTopic {
    name: compact_string,
    partitions: compact_array(OffsetPartition),
    tags
}
format ListOffsetsResponse {
    throttle: i32,
    topics: compact_array(OffsetTopic),
    tags
}

fn encode_list_offsets_response(
    correlation_id: i32,
    req: ListOffsetsRequest,
    answers: Vec<(u64, OffsetAnswer)>
) -> Bytes {
    let groups = by_topic(req.topics.map(|t| t.partitions.len()), answers);
    let topics = req.topics.enumerate().map(|e| OffsetTopic {
        name: e.1.name,
        partitions: e.1.partitions.enumerate().map(|pe| match groups.get(e.0).and_then(|g| g.get(pe.0)) {
            Some(a) => OffsetPartition {
                partition: pe.1.partition,
                error: a.error,
                timestamp: a.timestamp,
                offset: a.offset,
                leader_epoch: a.leader_epoch
            },
            None => error("encode_list_offsets_response: a partition entry has no answer"),
        }),
    });
    frame(response_header_v1(correlation_id).concat(ListOffsetsResponse::encode(ListOffsetsResponse {
        throttle: 0i32,
        topics: topics
    })))
}

/// The answer found in stored batch `stored` for timestamp `t`: with `exact`, the first record whose timestamp is
/// `t` (the partition's greatest); otherwise the first at or after `t`. A batch whose records do not parse, or do
/// not hold what its header promised, is reported corrupt (CORRUPT_MESSAGE), as Kafka fails such a read.
fn timestamp_answer(stored: Option<Bytes>, t: i64, exact: bool) -> OffsetAnswer {
    match stored {
        None => error("timestamp_answer: a stored batch's blob cannot be read"),
        Some(b) => {
            if exact {
                match offset_of_timestamp(b, t) {
                    Some(Some(o)) => offset_at(t, o),
                    _ => offset_failed(CORRUPT_MESSAGE),
                }
            } else {
                match first_at_or_after(b, t) {
                    Some(Some(x)) => offset_at(x.0, x.1),
                    _ => offset_failed(CORRUPT_MESSAGE),
                }
            }
        }
    }
}

/// An answer with the partition leader's epoch (S8.md D5: the group's term).
fn with_epoch(a: OffsetAnswer, epoch: u64) -> OffsetAnswer {
    if a.error == NONE && a.offset >= 0i64 {
        OffsetAnswer { error: a.error, timestamp: a.timestamp, offset: a.offset, leader_epoch: epoch as i32 }
    } else {
        a
    }
}
