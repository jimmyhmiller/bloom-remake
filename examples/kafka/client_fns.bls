//! The Blossom Kafka client's correlation ids and response decoding (`client_node.bls` has the node).

const CORR_VERSIONS: i32 = 1;
const CORR_METADATA: i32 = 2;

/// A response frame's ApiVersions answer, if it is the answer to `CORR_VERSIONS`.
fn versions_answer(f: Bytes) -> Option<(i16, Vec<ApiRange>)> {
    response_correlation(cur(f)).and_then(|p| if p.0 == CORR_VERSIONS { decode_api_versions_response(p.1) } else { None })
}

/// A response frame's Metadata answer, if it is the answer to `CORR_METADATA` (after response header v1's tags).
fn metadata_answer(f: Bytes) -> Option<MetadataAnswer> {
    response_correlation(cur(f)).and_then(|p| {
        if p.0 == CORR_METADATA { skip_tags(p.1).and_then(|body| decode_metadata_response(body)) } else { None }
    })
}

// ---------------------------------------------------------------- producing and fetching (slice 7, item 8)

/// A record of a batch: its length, attributes, timestamp and offset deltas, a null key, the value, no headers.
fn encode_record(offset_delta: u64, value: Bytes) -> Bytes {
    let body = Bytes::join([
        Bytes::from_i8(0i8),
        Bytes::varint(0i64),
        Bytes::varint(offset_delta as i64),
        Bytes::varint(-1i64),
        Bytes::varint(value.len() as i64),
        value,
        Bytes::varint(0i64),
    ]);
    Bytes::join([Bytes::varint(body.len() as i64), body])
}

/// A magic-2 batch of `values`, uncompressed, without idempotence, all at timestamp `ts`: its header, with the
/// length and the CRC32C over `attributes..end` computed, then its records.
fn encode_batch(values: Vec<Bytes>, ts: i64) -> Bytes {
    let records = Bytes::join(values.enumerate().map(|e| encode_record(e.0, e.1)));
    let n = values.len() as i32;
    let covered = Bytes::join([
        Bytes::from_i16_be(0i16),
        Bytes::from_i32_be(n - 1i32),
        Bytes::from_i64_be(ts),
        Bytes::from_i64_be(ts),
        Bytes::from_i64_be(-1i64),
        Bytes::from_i16_be(-1i16),
        Bytes::from_i32_be(-1i32),
        Bytes::from_i32_be(n),
        records,
    ]);
    Bytes::join([
        Bytes::from_i64_be(0i64),
        Bytes::from_i32_be((covered.len() + 9) as i32),
        Bytes::from_i32_be(-1i32),
        Bytes::from_i8(2i8),
        Bytes::from_u32_be(crc32c(covered)),
        covered,
    ])
}

/// ProduceRequest v12, framed: one batch to one partition, acks -1.
fn encode_produce_request(correlation_id: i32, client_id: String, topic: String, partition: i32, batch: Bytes) -> Bytes {
    frame(Bytes::join([
        request_header_v2(API_PRODUCE, 12i16, correlation_id, client_id),
        Bytes::uvarint(0),
        Bytes::from_i16_be(-1i16),
        Bytes::from_i32_be(30000i32),
        Bytes::uvarint(2),
        enc_compact_string(topic),
        Bytes::uvarint(2),
        Bytes::from_i32_be(partition),
        enc_compact_nullable_bytes(Some(batch)),
        no_tags(),
        no_tags(),
        no_tags(),
    ]))
}

/// A ProduceResponse v12's first partition, after its header: its error and base offset.
fn decode_produce_response(c: Cur) -> Option<(i16, i64)> {
    skip_tags(c).and_then(|body| read_compact_len(body).and_then(|_nt| read_compact_string(_nt.1).and_then(|_name| {
        read_compact_len(_name.1).and_then(|_np| read_i32(_np.1).and_then(|_index| read_i16(_index.1).and_then(|err| {
            read_i64(err.1).map(|base| (err.0, base.0))
        })))
    })))
}

/// FetchRequest v17, framed: one partition from `offset`, answered at once (`min_bytes` 0).
fn encode_fetch_request(correlation_id: i32, client_id: String, topic_id: Bytes, partition: i32, offset: i64) -> Bytes {
    frame(Bytes::join([
        request_header_v2(API_FETCH, 17i16, correlation_id, client_id),
        Bytes::from_i32_be(0i32),
        Bytes::from_i32_be(0i32),
        Bytes::from_i32_be(1048576i32),
        Bytes::from_i8(0i8),
        Bytes::from_i32_be(0i32),
        Bytes::from_i32_be(-1i32),
        Bytes::uvarint(2),
        topic_id,
        Bytes::uvarint(2),
        Bytes::from_i32_be(partition),
        Bytes::from_i32_be(-1i32),
        Bytes::from_i64_be(offset),
        Bytes::from_i32_be(-1i32),
        Bytes::from_i64_be(-1i64),
        Bytes::from_i32_be(1048576i32),
        no_tags(),
        no_tags(),
        Bytes::uvarint(1),
        enc_compact_string(""),
        no_tags(),
    ]))
}

/// Each record of a batch: its offset and value.
fn record_values(b: Bytes) -> Option<Vec<(i64, Bytes)>> {
    batch_header(b).and_then(|h| batch_records(b, h).and_then(|r| {
        let n = if h.record_count < 0i32 { 0 } else { h.record_count as u64 };
        let end = range(0, n).fold(Some(([], 0)), |acc, _i| acc.and_then(|a| {
            let (out, pos) = a;
            r.varint_at(pos).and_then(|len| r.varint_at(len.1 + 1).and_then(|td| r.varint_at(td.1).and_then(|od| {
                r.varint_at(od.1).and_then(|klen| {
                    let after_key = if klen.0 < 0i64 { klen.1 } else { klen.1 + klen.0 as u64 };
                    r.varint_at(after_key).and_then(|vlen| {
                        if vlen.0 < 0i64 || len.0 < 0i64 {
                            None
                        } else {
                            r.slice(vlen.1, vlen.1 + vlen.0 as u64).and_then(|v| {
                                add_i64(h.base_offset, od.0).map(|o| (out.push((o, v)), len.1 + len.0 as u64))
                            })
                        }
                    })
                })
            })))
        }));
        end.and_then(|e| if e.1 == r.len() { Some(e.0) } else { None })
    }))
}

/// A FetchResponse v17's first partition, after its header: its error, high watermark and records (offset, value).
fn decode_fetch_response(c: Cur) -> Option<(i16, i64, Vec<(i64, Bytes)>)> {
    skip_tags(c).and_then(|body| read_i32(body).and_then(|_throttle| read_i16(_throttle.1).and_then(|_err| {
        read_i32(_err.1).and_then(|_sid| read_compact_len(_sid.1).and_then(|_nt| read_uuid(_nt.1).and_then(|_id| {
            read_compact_len(_id.1).and_then(|_np| read_i32(_np.1).and_then(|_index| read_i16(_index.1).and_then(|err| {
                read_i64(err.1).and_then(|hw| read_i64(hw.1).and_then(|_lso| read_i64(_lso.1).and_then(|_ls| {
                    read_compact_nullable_len(_ls.1).and_then(|aborted| {
                        let after = match aborted.0 {
                            None => Some(aborted.1),
                            Some(k) => range(0, k).fold(Some(aborted.1), |acc, _i| {
                                acc.and_then(|x| read_bytes(x, 16).and_then(|y| skip_tags(y.1)))
                            }),
                        };
                        after.and_then(|a| read_i32(a).and_then(|_pref| read_compact_nullable_bytes(_pref.1).and_then(|recs| {
                            let batches = split_batches(recs.0.unwrap_or(Bytes::empty()));
                            batches.and_then(|bs| bs.fold(Some([]), |acc, b| {
                                acc.and_then(|all| record_values(b).map(|rs| all.concat(rs)))
                            })).map(|rs| (err.0, hw.0, rs))
                        })))
                    })
                })))
            })))
        })))
    })))
}

/// A MetadataResponse v13's topics, after its header: each one's error, name, id and partition count.
fn metadata_topic_ids(c: Cur) -> Option<Vec<(i16, Option<String>, Bytes, u64)>> {
    skip_tags(c).and_then(|body| read_i32(body).and_then(|throttle| read_compact_len(throttle.1).and_then(|nb| {
        range(0, nb.0)
            .fold(Some(nb.1), |acc, _i| acc.and_then(|x| decode_broker(x).map(|b| b.1)))
            .and_then(|after| read_compact_nullable_string(after).and_then(|cl| read_i32(cl.1).and_then(|ctl| {
                read_compact_len(ctl.1).and_then(|nt| {
                    range(0, nt.0).fold(Some(([], nt.1)), |acc, _i| acc.and_then(|a| {
                        read_i16(a.1).and_then(|e| read_compact_nullable_string(e.1).and_then(|name| read_uuid(name.1).and_then(|id| {
                            read_bool(id.1).and_then(|internal| read_compact_len(internal.1).and_then(|np| {
                                range(0, np.0)
                                    .fold(Some(np.1), |acc2, _j| acc2.and_then(|x| skip_partition(x)))
                                    .and_then(|pend| read_i32(pend).and_then(|ops| skip_tags(ops.1).map(|end| {
                                        (a.0.push((e.0, name.0, id.0, np.0)), end)
                                    })))
                            }))
                        })))
                    })).map(|t| t.0)
                })
            })))
    })))
}

const CORR_FETCH: i32 = 3;
const CORR_TOPIC: i32 = 4;
/// A produce of batch `k` has correlation id `CORR_PRODUCE + k`.
const CORR_PRODUCE: i32 = 1000;

/// A response frame's topic metadata for `CLIENT_TOPIC`: its id and partition count, if it exists.
fn topic_answer(f: Bytes) -> Option<(Bytes, u64)> {
    response_correlation(cur(f)).and_then(|p| if p.0 == CORR_TOPIC {
        metadata_topic_ids(p.1).and_then(|ts| ts.filter(|t| t.0 == NONE && t.1 == Some(CLIENT_TOPIC)).first().map(|t| (t.2, t.3)))
    } else {
        None
    })
}

/// A response frame's produce answer: the batch it answers, its error and base offset.
fn produce_answer(f: Bytes) -> Option<(u64, i16, i64)> {
    response_correlation(cur(f)).and_then(|p| if p.0 >= CORR_PRODUCE {
        decode_produce_response(p.1).map(|a| ((p.0 - CORR_PRODUCE) as u64, a.0, a.1))
    } else {
        None
    })
}

/// A response frame's fetch answer: error, high watermark and records.
fn fetched_answer(f: Bytes) -> Option<(i16, i64, Vec<(i64, Bytes)>)> {
    response_correlation(cur(f)).and_then(|p| if p.0 == CORR_FETCH { decode_fetch_response(p.1) } else { None })
}

/// The values of batch `k`: `blossom/`, then the batch and the record number as 8-byte big-endian integers.
fn batch_values(k: u64) -> Vec<Bytes> {
    range(0, 1 + k % 3).map(|i| Bytes::join(["blossom/".to_utf8(), Bytes::from_u64_be(k), Bytes::from_u64_be(i)]))
}

/// The produce request for batch `k`, to partition `k` modulo the partition count.
fn produce_frame(k: u64, parts: u64) -> Bytes {
    encode_produce_request(CORR_PRODUCE + k as i32, "blossom", CLIENT_TOPIC, (k % parts) as i32, encode_batch(batch_values(k), 0i64))
}

/// Where the read goes after reading `records` at `(p, off)` in a log whose high watermark is `hw`: on in the same
/// partition, to the next partition's start, or nowhere (done). A failed or empty answer below the high watermark
/// is asked again.
fn next_read(p: i32, off: i64, parts: u64, err: i16, hw: i64, records: Vec<(i64, Bytes)>) -> Option<(i32, i64)> {
    let nxt = match records.last() {
        Some(r) => r.0 + 1i64,
        None => off,
    };
    if err != NONE || nxt < hw {
        Some((p, nxt))
    } else if ((p + 1i32) as u64) < parts {
        Some((p + 1i32, 0i64))
    } else {
        None
    }
}
