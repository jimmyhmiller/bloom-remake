//! Partition reassignment (S8 item 5): AlterPartitionReassignments (key 45, versions 0–1) and
//! ListPartitionReassignments (key 46, version 0), both flexible.
//!
//! A reassignment moves a partition to target replicas. The controller records the target (`cluster.bls`); the
//! partition's leader changes its configuration one replica at a time (adding the target's first, removing the
//! others once the target's are in sync) and reports when it reaches the target, which then becomes the
//! partition's replicas.

const NO_REASSIGNMENT_IN_PROGRESS: i16 = 85;

/// One partition of a reassignment request: its index and target replicas (`None` cancels a reassignment).
format ReassignPartition { index: i32, replicas: compact_nullable_array(i32), tags }
format ReassignTopic { name: compact_string, partitions: compact_array(ReassignPartition), tags }
/// AlterPartitionReassignmentsRequest. `allow_rf_change` (v1; true before) lets a reassignment change the number of
/// replicas.
format AlterReassignmentsRequest(version: i16) {
    timeout_ms: i32,
    allow_rf_change: bool if version >= 1i16 = true,
    topics: compact_array(ReassignTopic),
    tags,
}

fn decode_alter_reassignments(c: Cur, version: i16) -> Option<AlterReassignmentsRequest> {
    AlterReassignmentsRequest::decode(c.buf, c.pos, version).map(|r| r.0)
}

/// Each partition entry of a request, in order: (its position among the request's partitions, topic name,
/// partition index, target replicas).
fn reassign_entries(req: AlterReassignmentsRequest) -> Vec<(u64, String, i32, Option<Vec<i32>>)> {
    let flat = req.topics.map(|t| t.partitions.map(|p| (t.name, p.index, p.replicas))).flatten();
    flat.enumerate().map(|x| (x.0, (x.1).0, (x.1).1, (x.1).2))
}

/// The partitions a request names more than once: each of their entries is refused (INVALID_REQUEST), since one
/// request may move a partition only one way.
fn reassign_repeated(req: AlterReassignmentsRequest) -> Set<(String, i32)> {
    let keys = reassign_entries(req).map(|e| (e.1, e.2));
    keys.filter(|k| keys.filter(|x| x == k).len() > 1).to_set()
}

/// An entry's verdict at the broker: a repeated partition, else the replicas' (`reassign_replicas_error`).
fn reassign_entry_error(repeated: Set<(String, i32)>, name: String, part: i32, replicas: Option<Vec<i32>>, brokers: Vec<i32>) -> i16 {
    if repeated.contains((name, part)) { INVALID_REQUEST } else { reassign_replicas_error(replicas, brokers) }
}

/// The broker's own verdict on target replicas, before the controller (Kafka's checks of a manual assignment): a
/// list that is empty, names a broker twice, or names one that does not exist is INVALID_REPLICA_ASSIGNMENT.
fn reassign_replicas_error(replicas: Option<Vec<i32>>, brokers: Vec<i32>) -> i16 {
    match replicas {
        None => NONE,
        Some(rs) => if rs.is_empty() || rs.to_set().len() != rs.len() || not rs.all(|r| brokers.contains(r)) {
            INVALID_REPLICA_ASSIGNMENT
        } else {
            NONE
        },
    }
}

fn reassign_message(error: i16) -> Option<String> {
    if error == NONE {
        None
    } else if error == UNKNOWN_TOPIC_OR_PARTITION {
        Some("the topic or partition does not exist")
    } else if error == INVALID_REPLICA_ASSIGNMENT {
        Some("the replicas must be distinct, existing brokers, and at least one")
    } else if error == INVALID_REPLICATION_FACTOR {
        Some("the reassignment would change the replication factor, which the request does not allow")
    } else if error == NO_REASSIGNMENT_IN_PROGRESS {
        Some("no reassignment of the partition is in progress")
    } else if error == REQUEST_TIMED_OUT {
        Some("the controller did not apply the reassignment in time")
    } else if error == INVALID_REQUEST {
        Some("the request names the partition more than once")
    } else {
        None
    }
}

/// Each of `n` entries' error: the one applied, else REQUEST_TIMED_OUT.
fn errors_or_timed_out(n: u64, es: Vec<(u64, i16)>) -> Map<u64, i16> {
    let m = es.to_map();
    range(0, n).map(|k| (k, m.get(k).unwrap_or(REQUEST_TIMED_OUT))).to_map()
}

fn error_at(errors: Map<u64, i16>, k: u64) -> i16 {
    match errors.get(k) {
        Some(e) => e,
        None => error("encode_alter_reassignments_response: a partition without its error"),
    }
}

format AlterPartition { index: i32, error: i16, message: compact_nullable_string, tags }
format AlterTopic { name: compact_string, partitions: compact_array(AlterPartition), tags }
format AlterReassignmentsResponse(version: i16) {
    throttle: i32,
    allow_rf_change: bool if version >= 1i16,
    error: i16,
    message: compact_nullable_string,
    topics: compact_array(AlterTopic),
    tags,
}

/// The response: each partition of the request with its error (`errors`, by position in `reassign_entries`).
fn encode_alter_reassignments_response(correlation_id: i32, version: i16, req: AlterReassignmentsRequest, errors: Map<u64, i16>) -> Bytes {
    let ends = req.topics.scan(0, |n, t| n + t.partitions.len());
    let topics = req.topics.enumerate().map(|t| {
        let first = match ends.get(t.0) {
            Some(x) => x - t.1.partitions.len(),
            None => error("encode_alter_reassignments_response: a topic without an end"),
        };
        AlterTopic { name: t.1.name, partitions: t.1.partitions.enumerate().map(|p| {
            let e = error_at(errors, first + p.0);
            AlterPartition { index: p.1.index, error: e, message: reassign_message(e) }
        }) }
    });
    let r = AlterReassignmentsResponse { throttle: 0i32, allow_rf_change: req.allow_rf_change, error: NONE, message: None, topics: topics };
    frame(response_header_v1(correlation_id).concat(AlterReassignmentsResponse::encode(r, version)))
}

/// ListPartitionReassignmentsRequest: the topics and partitions asked about (`None`: every reassignment).
format ListReassignmentsRequest { timeout_ms: i32, topics: compact_nullable_array((compact_string, compact_array(i32), tags)), tags }

fn decode_list_reassignments(c: Cur) -> Option<ListReassignmentsRequest> {
    ListReassignmentsRequest::decode(c.buf, c.pos).map(|r| r.0)
}

/// A reassignment in progress, as ListPartitionReassignments reports it: the partition, its replicas (the
/// target's, then the ones being removed), the ones being added and the ones being removed.
struct Ongoing { name: String, index: i32, replicas: Vec<i32>, target: Vec<i32> }

/// The members of `xs` that are in `ys`, in `xs`'s order.
fn among(xs: Vec<i32>, ys: Vec<i32>) -> Vec<i32> {
    xs.filter(|x| ys.contains(x))
}

/// The replicas a partition being reassigned is shown with (Metadata too): the target's, then those it removes.
fn reassign_shown(replicas: Vec<i32>, target: Vec<i32>) -> Vec<i32> {
    target.concat(replicas.filter(|r| not target.contains(r)))
}

/// A partition being reassigned on the wire: its replicas as shown, those being added and those being removed.
format OngoingPartition { index: i32, replicas: compact_array(i32), adding: compact_array(i32), removing: compact_array(i32), tags }
format OngoingTopic { name: compact_string, partitions: compact_array(OngoingPartition), tags }
format ListReassignmentsResponse { throttle: i32, error: i16, message: compact_nullable_string, topics: compact_array(OngoingTopic), tags }

fn ongoing_partition(o: Ongoing) -> OngoingPartition {
    OngoingPartition {
        index: o.index, replicas: reassign_shown(o.replicas, o.target),
        adding: o.target.filter(|r| not o.replicas.contains(r)), removing: o.replicas.filter(|r| not o.target.contains(r)),
    }
}

fn asked_about(req: ListReassignmentsRequest, o: Ongoing) -> bool {
    match req.topics {
        None => true,
        Some(ts) => ts.any(|t| t.0 == o.name && t.1.contains(o.index)),
    }
}

/// The reassignments asked about, by topic (`ongoing` comes in name order), partitions in index order.
fn list_reassignments_topics(req: ListReassignmentsRequest, ongoing: Vec<Ongoing>) -> Vec<OngoingTopic> {
    let asked = ongoing.filter(|o| asked_about(req, o));
    let names = asked.fold([], |acc, o| if acc.contains(o.name) { acc } else { acc.push(o.name) });
    names.map(|n| OngoingTopic { name: n, partitions: asked.filter(|o| o.name == n).map(|o| ongoing_partition(o)) })
}

fn encode_list_reassignments_response(correlation_id: i32, req: ListReassignmentsRequest, ongoing: Vec<Ongoing>) -> Bytes {
    let r = ListReassignmentsResponse { throttle: 0i32, error: NONE, message: None, topics: list_reassignments_topics(req, ongoing) };
    frame(response_header_v1(correlation_id).concat(ListReassignmentsResponse::encode(r)))
}
