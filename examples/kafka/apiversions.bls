//! ApiVersions (key 18), versions 3 and 4 (flexible; identical schemas), and the version-0 answer to a version this
//! broker does not support, which Kafka clients use to fall back (KIP-511).

/// ApiVersionsRequest v3–v4.
format ApiVersionsRequest { client_software_name: compact_string, client_software_version: compact_string, tags }

fn decode_api_versions_request(c: Cur) -> Option<ApiVersionsRequest> {
    ApiVersionsRequest::decode(c.buf, c.pos).map(|r| r.0)
}

/// One supported API: its key and version range.
format ApiRange { key: i16, min: i16, max: i16, tags }
/// The same, in the version-0 layout (no tagged fields).
format ApiRange0 { key: i16, min: i16, max: i16 }
/// ApiVersionsResponse v3–v4 after its header.
format ApiVersionsResponse { error: i16, keys: compact_array(ApiRange), throttle: i32, tags }
/// The version-0 layout, as UNSUPPORTED_VERSION (35) is answered.
format ApiVersionsUnsupported { constant(i16, 35), keys: array(i32, 0, ApiRange0) }

/// What this broker answers: Produce 10–12, Fetch 16–17, ListOffsets 7–10, ApiVersions 3–4, Metadata 13, CreateTopics 7, DeleteTopics 6,
/// DescribeConfigs 4 and InitProducerId 3–5.
fn supported() -> Vec<ApiRange> {
    [
        ApiRange { key: API_PRODUCE, min: 10i16, max: 12i16 },
        ApiRange { key: API_FETCH, min: 16i16, max: 17i16 },
        ApiRange { key: API_LIST_OFFSETS, min: 7i16, max: 10i16 },
        ApiRange { key: API_METADATA, min: 13i16, max: 13i16 },
        ApiRange { key: API_VERSIONS, min: 3i16, max: 4i16 },
        ApiRange { key: API_CREATE_TOPICS, min: 7i16, max: 7i16 },
        ApiRange { key: API_DELETE_TOPICS, min: 6i16, max: 6i16 },
        ApiRange { key: API_INIT_PRODUCER_ID, min: 3i16, max: 5i16 },
        ApiRange { key: API_DESCRIBE_CONFIGS, min: 4i16, max: 4i16 },
        ApiRange { key: API_ALTER_PARTITION_REASSIGNMENTS, min: 0i16, max: 1i16 },
        ApiRange { key: API_LIST_PARTITION_REASSIGNMENTS, min: 0i16, max: 0i16 },
        ApiRange { key: API_DESCRIBE_CLUSTER, min: 0i16, max: 2i16 },
    ]
}

fn supports(api_key: i16, version: i16) -> bool {
    supported().any(|r| r.key == api_key && version >= r.min && version <= r.max)
}

/// ApiVersionsResponse v3–v4 with no error: every supported API, no throttle, and no feature tags.
fn encode_api_versions_response(correlation_id: i32) -> Bytes {
    frame(response_header_v0(correlation_id).concat(ApiVersionsResponse::encode(ApiVersionsResponse { error: 0i16, keys: supported(), throttle: 0i32 })))
}

/// UNSUPPORTED_VERSION (35), answered in the version-0 layout, whatever the version asked, listing the ApiVersions
/// range: a client that sent a version it may not reads this and retries with a supported one.
fn encode_api_versions_unsupported(correlation_id: i32) -> Bytes {
    let own = supported().filter(|r| r.key == API_VERSIONS).map(|r| ApiRange0 { key: r.key, min: r.min, max: r.max });
    frame(response_header_v0(correlation_id).concat(ApiVersionsUnsupported::encode(ApiVersionsUnsupported { keys: own })))
}

/// ApiVersionsRequest v4, framed, from a client.
fn encode_api_versions_request(correlation_id: i32, client_id: String, software: String, software_version: String) -> Bytes {
    let body = ApiVersionsRequest { client_software_name: software, client_software_version: software_version };
    frame(request_header_v2(API_VERSIONS, 4i16, correlation_id, client_id).concat(ApiVersionsRequest::encode(body)))
}

/// ApiVersionsResponse v3–v4 after its header: the error code and the supported ranges (tagged fields skipped).
fn decode_api_versions_response(c: Cur) -> Option<(i16, Vec<ApiRange>)> {
    ApiVersionsResponse::decode(c.buf, c.pos).map(|r| (r.0.error, r.0.keys))
}
