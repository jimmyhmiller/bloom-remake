//! Metadata (key 3), version 13 (flexible).

/// A requested topic: by id, by name, or both.
format MetadataTopicRequest { topic_id: uuid, name: compact_nullable_string, tags }

/// MetadataRequest v13. `topics` is `None` for "all topics".
format MetadataRequest {
    topics: compact_nullable_array(MetadataTopicRequest),
    allow_auto_topic_creation: bool,
    include_topic_authorized_operations: bool,
    tags,
}

fn decode_metadata_request(c: Cur) -> Option<MetadataRequest> {
    MetadataRequest::decode(c.buf, c.pos).map(|r| r.0)
}

/// A broker in a metadata response.
format BrokerInfo { node_id: i32, host: compact_string, port: i32, rack: compact_nullable_string, tags }

/// A partition and a topic of a metadata response.
format MetadataPartition {
    error: i16,
    index: i32,
    leader: i32,
    epoch: i32,
    replicas: compact_array(i32),
    isr: compact_array(i32),
    offline: compact_array(i32),
    tags,
}
format MetadataTopic {
    error: i16,
    name: compact_nullable_string,
    id: uuid,
    internal: bool,
    partitions: compact_array(MetadataPartition),
    ops: i32,
    tags,
}
/// MetadataResponse v13 after its header.
format MetadataResponse {
    throttle: i32,
    brokers: compact_array(BrokerInfo),
    cluster_id: compact_nullable_string,
    controller_id: i32,
    topics: compact_array(MetadataTopic),
    error: i16,
    tags,
}

/// No authorized operations reported.
const NO_OPERATIONS: i32 = -2147483648i32;

/// A topic this broker does not have, with `error`, `name` and `topic_id`, no partitions and no authorized operations.
fn unknown_topic(error: i16, name: Option<String>, topic_id: Bytes) -> MetadataTopic {
    MetadataTopic { error: error, name: name, id: topic_id, internal: false, partitions: [], ops: NO_OPERATIONS }
}

const UNKNOWN_TOPIC_OR_PARTITION: i16 = 3;
const UNKNOWN_TOPIC_ID: i16 = 100;

/// A partition as Metadata describes it: its leader's broker id and epoch (-1 while no leader is known), its replicas,
/// and its in-sync replicas as its leader last announced them.
struct PartInfo { index: i32, leader: i32, epoch: i32, replicas: Vec<i32>, isr: Vec<i32> }

/// A topic, as Metadata describes it: its partitions in index order.
struct TopicInfo { name: String, id: Bytes, partitions: Vec<PartInfo> }

/// A topic, with the operations a client may perform on it when the request asks (`ops`; else none reported).
fn known_topic(t: TopicInfo, ops: bool) -> MetadataTopic {
    let parts = t.partitions.map(|p| MetadataPartition {
        error: if p.leader < 0i32 { LEADER_NOT_AVAILABLE } else { NONE }, index: p.index, leader: p.leader,
        epoch: p.epoch, replicas: p.replicas, isr: p.isr, offline: [],
    });
    MetadataTopic {
        error: NONE, name: Some(t.name), id: t.id, internal: false, partitions: parts,
        ops: if ops { TOPIC_OPERATIONS } else { NO_OPERATIONS },
    }
}

/// The names a Metadata request asks for by name that auto-creation would make, when the broker allows it
/// (`enabled`, Kafka's `auto.create.topics.enable`) and so does the request: the legal names, less any whose
/// collision key another requested name shares (creating one of them would refuse the others; none is created).
/// The node leaves out the names of topics that exist.
fn metadata_creates(req: MetadataRequest, enabled: bool) -> Vec<String> {
    match req.topics {
        Some(ts) => {
            if enabled && req.allow_auto_topic_creation && ts.all(|t| t.topic_id == zero_uuid()) {
                let keyed = ts.filter_map(|t| t.name).map(|n| (collision_key(n), n));
                let colliding = colliding_keys(keyed);
                keyed.filter(|kn| topic_name_ok(kn.1) && not colliding.contains(kn.0)).map(|kn| kn.1)
            } else {
                []
            }
        }
        None => [],
    }
}

/// The topics part of a Metadata answer. `topics` are the broker's topics (those created by this request included).
/// As Kafka does, a request naming any topic by id is answered by id (each requested nonzero id, known or
/// UNKNOWN_TOPIC_ID with a null name) and its name-only entries are ignored; otherwise each requested name is its
/// topic, or INVALID_TOPIC_EXCEPTION for a name that is not a legal topic name, or UNKNOWN_TOPIC_OR_PARTITION; no
/// list means every topic.
///
/// Kafka also drops duplicate ids and names (it collects them into sets); this answers each requested entry,
/// duplicates included, which only a client that repeats a topic in one request can see.
/// `creating` are the names this request auto-creates: LEADER_NOT_AVAILABLE until they exist, as Kafka answers.
fn metadata_topics(req: MetadataRequest, topics: Vec<TopicInfo>, creating: Set<String>) -> Vec<MetadataTopic> {
    match req.topics {
        Some(ts) => {
            let by_id = ts.filter(|t| t.topic_id != zero_uuid());
            if by_id.is_empty() {
                let named = topics.map(|x| (x.name, x)).to_map();
                ts.map(|t| match t.name {
                    Some(n) => match named.get(n) {
                        Some(x) => known_topic(x, req.include_topic_authorized_operations),
                        None => {
                            let error = if creating.contains(n) {
                                LEADER_NOT_AVAILABLE
                            } else if topic_name_ok(n) {
                                UNKNOWN_TOPIC_OR_PARTITION
                            } else {
                                INVALID_TOPIC_EXCEPTION
                            };
                            unknown_topic(error, Some(n), zero_uuid())
                        }
                    },
                    None => unknown_topic(UNKNOWN_TOPIC_OR_PARTITION, None, zero_uuid()),
                })
            } else {
                let with_id = topics.map(|x| (x.id, x)).to_map();
                by_id.map(|t| match with_id.get(t.topic_id) {
                    Some(x) => known_topic(x, req.include_topic_authorized_operations),
                    None => unknown_topic(UNKNOWN_TOPIC_ID, None, t.topic_id),
                })
            }
        }
        None => topics.map(|x| known_topic(x, req.include_topic_authorized_operations)),
    }
}

/// MetadataResponse v13 for a cluster of `brokers` whose topics are `topics`.
fn encode_metadata_response(
    correlation_id: i32,
    req: MetadataRequest,
    brokers: Vec<BrokerInfo>,
    cluster_id: String,
    controller_id: i32,
    topics: Vec<TopicInfo>,
    creating: Set<String>,
) -> Bytes {
    let r = MetadataResponse {
        throttle: 0i32, brokers: brokers, cluster_id: Some(cluster_id), controller_id: controller_id,
        topics: metadata_topics(req, topics, creating), error: 0i16,
    };
    frame(response_header_v1(correlation_id).concat(MetadataResponse::encode(r)))
}

/// MetadataRequest v13, framed, from a client: `None` for all topics.
fn encode_metadata_request(correlation_id: i32, client_id: String, topics: Option<Vec<String>>) -> Bytes {
    let ts = topics.map(|names| names.map(|n| MetadataTopicRequest { topic_id: zero_uuid(), name: Some(n) }));
    let r = MetadataRequest { topics: ts, allow_auto_topic_creation: true, include_topic_authorized_operations: false };
    frame(request_header_v2(API_METADATA, 13i16, correlation_id, client_id).concat(MetadataRequest::encode(r)))
}

/// What a client keeps of a metadata answer: the brokers, cluster id, controller and each topic's error and name.
struct MetadataAnswer { brokers: Vec<BrokerInfo>, cluster_id: Option<String>, controller_id: i32, topics: Vec<(i16, Option<String>)>, error: i16 }

/// MetadataResponse v13 after its header.
fn decode_metadata_response(c: Cur) -> Option<MetadataAnswer> {
    let (r, _end) = MetadataResponse::decode(c.buf, c.pos)?;
    Some(MetadataAnswer {
        brokers: r.brokers, cluster_id: r.cluster_id, controller_id: r.controller_id,
        topics: r.topics.map(|t| (t.error, t.name)), error: r.error,
    })
}

// ---------------------------------------------------------------- DescribeCluster (key 60), versions 0–2 (flexible)

/// DescribeClusterRequest: whether to report the cluster's authorized operations, which endpoints to describe (v1+;
/// 1 brokers, 2 controllers) and whether to include fenced brokers (v2+).
format DescribeClusterRequest(version: i16) {
    include_operations: bool,
    endpoint_type: i8 if version >= 1i16 = ENDPOINT_BROKERS,
    include_fenced: bool if version >= 2i16,
    tags,
}

const ENDPOINT_BROKERS: i8 = 1;
const ENDPOINT_CONTROLLERS: i8 = 2;
/// Asked a broker for controllers (Kafka 4.0's `AuthHelper.computeDescribeClusterResponse`), or for a type that
/// does not exist.
const MISMATCHED_ENDPOINT_TYPE: i16 = 114;
const UNSUPPORTED_ENDPOINT_TYPE: i16 = 115;
/// The cluster operations a client may perform, as a bit field (Kafka without an authorizer allows every operation
/// the cluster resource supports: CREATE, ALTER, DESCRIBE, CLUSTER_ACTION, DESCRIBE_CONFIGS, ALTER_CONFIGS and
/// IDEMPOTENT_WRITE).
const CLUSTER_OPERATIONS: i32 = 8096;
/// The topic operations, likewise (READ, WRITE, CREATE, DELETE, ALTER, DESCRIBE, DESCRIBE_CONFIGS, ALTER_CONFIGS).
const TOPIC_OPERATIONS: i32 = 3576;

fn decode_describe_cluster(c: Cur, version: i16) -> Option<DescribeClusterRequest> {
    DescribeClusterRequest::decode(c.buf, c.pos, version).map(|r| r.0)
}

/// The answer: this cluster's brokers (none is fenced: brokers are configuration, S8.md D2) and the controller as
/// Metadata reports it. A broker describes only brokers: asked for controllers it answers MISMATCHED_ENDPOINT_TYPE
/// (controllers answer for themselves on their own listener), for an unknown type UNSUPPORTED_ENDPOINT_TYPE, as a
/// Kafka broker does.
fn describe_cluster_error(endpoint: i8) -> i16 {
    if endpoint == ENDPOINT_BROKERS {
        NONE
    } else if endpoint == ENDPOINT_CONTROLLERS {
        MISMATCHED_ENDPOINT_TYPE
    } else {
        UNSUPPORTED_ENDPOINT_TYPE
    }
}

format DescribedBroker(version: i16) {
    node_id: i32, host: compact_string, port: i32, rack: compact_nullable_string, fenced: bool if version >= 2i16, tags,
}
format DescribeClusterResponse(version: i16) {
    throttle: i32,
    error: i16,
    message: compact_nullable_string,
    endpoint_type: i8 if version >= 1i16,
    cluster_id: compact_string,
    controller_id: i32,
    brokers: compact_array(DescribedBroker(version)),
    ops: i32,
    tags,
}

fn encode_describe_cluster_response(correlation_id: i32, version: i16, req: DescribeClusterRequest, brokers: Vec<BrokerInfo>, cluster_id: String, controller_id: i32) -> Bytes {
    let ok = req.endpoint_type == ENDPOINT_BROKERS;
    let r = DescribeClusterResponse {
        throttle: 0i32,
        error: describe_cluster_error(req.endpoint_type),
        message: if ok { None } else { Some("this broker describes brokers only") },
        endpoint_type: req.endpoint_type,
        cluster_id: if ok { cluster_id } else { "" },
        controller_id: if ok { controller_id } else { -1i32 },
        brokers: if ok { brokers.map(|b| DescribedBroker { node_id: b.node_id, host: b.host, port: b.port, rack: b.rack, fenced: false }) } else { [] },
        ops: if req.include_operations && ok { CLUSTER_OPERATIONS } else { NO_OPERATIONS },
    };
    frame(response_header_v1(correlation_id).concat(DescribeClusterResponse::encode(r, version)))
}
