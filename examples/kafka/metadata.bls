//! Metadata (key 3), version 13 (flexible).

/// A requested topic: by id, by name, or both.
struct MetadataTopicRequest { topic_id: Bytes, name: Option<String> }

/// MetadataRequest v13. `topics` is `None` for "all topics".
struct MetadataRequest {
    topics: Option<Vec<MetadataTopicRequest>>,
    allow_auto_topic_creation: bool,
    include_topic_authorized_operations: bool,
}

fn decode_metadata_topic(c: Cur) -> Option<(MetadataTopicRequest, Cur)> {
    read_uuid(c).and_then(|id| read_compact_nullable_string(id.1).and_then(|name| {
        skip_tags(name.1).map(|end| (MetadataTopicRequest { topic_id: id.0, name: name.0 }, end))
    }))
}

fn decode_metadata_request(c: Cur) -> Option<MetadataRequest> {
    read_compact_nullable_len(c).and_then(|len| {
        let topics = match len.0 {
            None => Some((None, len.1)),
            Some(n) => range(0, n)
                .fold(Some(([], len.1)), |acc, _i| acc.and_then(|a| decode_metadata_topic(a.1).map(|t| (a.0.push(t.0), t.1))))
                .map(|a| (Some(a.0), a.1)),
        };
        topics.and_then(|t| read_bool(t.1).and_then(|auto| read_bool(auto.1).and_then(|ops| {
            skip_tags(ops.1).map(|_end| MetadataRequest {
                topics: t.0,
                allow_auto_topic_creation: auto.0,
                include_topic_authorized_operations: ops.0,
            })
        })))
    })
}

/// A broker in a metadata response.
struct BrokerInfo { node_id: i32, host: String, port: i32, rack: Option<String> }

fn encode_broker(b: BrokerInfo) -> Bytes {
    Bytes::join([
        Bytes::from_i32_be(b.node_id), enc_compact_string(b.host), Bytes::from_i32_be(b.port),
        enc_compact_nullable_string(b.rack), no_tags(),
    ])
}

/// A topic this broker does not have, with `error`, `name` and `topic_id`, no partitions and no authorized operations.
fn encode_unknown_topic(error: i16, name: Option<String>, topic_id: Bytes) -> Bytes {
    Bytes::join([
        Bytes::from_i16_be(error), enc_compact_nullable_string(name), topic_id, enc_bool(false),
        enc_compact_array([]), Bytes::from_i32_be(-2147483648i32), no_tags(),
    ])
}

const UNKNOWN_TOPIC_OR_PARTITION: i16 = 3;
const UNKNOWN_TOPIC_ID: i16 = 100;

/// The topics part of the answer when every requested topic is unknown. As Kafka does, a request naming any topic by
/// id is answered by id: each requested nonzero id is UNKNOWN_TOPIC_ID with a null name, and the entries that give
/// only a name are ignored. Otherwise each requested name is UNKNOWN_TOPIC_OR_PARTITION.
///
/// Kafka also drops duplicate ids and names (it collects them into sets); this answers each requested entry,
/// duplicates included, which only a client that repeats a topic in one request can see.
fn unknown_topics(ts: Vec<MetadataTopicRequest>) -> Vec<Bytes> {
    let by_id = ts.filter(|t| t.topic_id != zero_uuid());
    if by_id.is_empty() {
        ts.map(|t| encode_unknown_topic(UNKNOWN_TOPIC_OR_PARTITION, t.name, zero_uuid()))
    } else {
        by_id.map(|t| encode_unknown_topic(UNKNOWN_TOPIC_ID, None, t.topic_id))
    }
}

/// MetadataResponse v13 for a cluster of `brokers` with no topics (S6): a requested topic is unknown.
fn encode_metadata_response(
    correlation_id: i32,
    req: MetadataRequest,
    brokers: Vec<BrokerInfo>,
    cluster_id: String,
    controller_id: i32,
) -> Bytes {
    let topics = match req.topics {
        Some(ts) => unknown_topics(ts),
        None => [],
    };
    frame(Bytes::join([
        response_header_v1(correlation_id),
        Bytes::from_i32_be(0i32),
        enc_compact_array(brokers.map(|b| encode_broker(b))),
        enc_compact_nullable_string(Some(cluster_id)),
        Bytes::from_i32_be(controller_id),
        enc_compact_array(topics),
        Bytes::from_i16_be(0i16),
        no_tags(),
    ]))
}

/// MetadataRequest v13, framed, from a client: `None` for all topics.
fn encode_metadata_request(correlation_id: i32, client_id: String, topics: Option<Vec<String>>) -> Bytes {
    let ts = match topics {
        Some(names) => enc_compact_array(names.map(|n| Bytes::join([
            zero_uuid(), enc_compact_nullable_string(Some(n)), no_tags(),
        ]))),
        None => Bytes::uvarint(0),
    };
    frame(Bytes::join([
        request_header_v2(API_METADATA, 13i16, correlation_id, client_id),
        ts, enc_bool(true), enc_bool(false), no_tags(),
    ]))
}

/// What a client keeps of a metadata answer: the brokers, cluster id, controller and each topic's error and name.
struct MetadataAnswer { brokers: Vec<BrokerInfo>, cluster_id: Option<String>, controller_id: i32, topics: Vec<(i16, Option<String>)>, error: i16 }

fn decode_broker(c: Cur) -> Option<(BrokerInfo, Cur)> {
    read_i32(c).and_then(|id| read_compact_string(id.1).and_then(|host| read_i32(host.1).and_then(|port| {
        read_compact_nullable_string(port.1).and_then(|rack| skip_tags(rack.1).map(|end| {
            (BrokerInfo { node_id: id.0, host: host.0, port: port.0, rack: rack.0 }, end)
        }))
    })))
}

/// Skips a compact array of int32s.
fn skip_i32s(c: Cur) -> Option<Cur> {
    read_compact_len(c).and_then(|n| read_bytes(n.1, n.0 * 4).map(|b| b.1))
}

fn skip_partition(c: Cur) -> Option<Cur> {
    read_bytes(c, 2 + 4 + 4 + 4).and_then(|fixed| {
        skip_i32s(fixed.1).and_then(|r| skip_i32s(r).and_then(|i| skip_i32s(i).and_then(|o| skip_tags(o))))
    })
}

fn decode_topic(c: Cur) -> Option<((i16, Option<String>), Cur)> {
    read_i16(c).and_then(|e| read_compact_nullable_string(e.1).and_then(|name| read_uuid(name.1).and_then(|id| {
        read_bool(id.1).and_then(|internal| read_compact_len(internal.1).and_then(|np| {
            range(0, np.0)
                .fold(Some(np.1), |acc, _i| acc.and_then(|x| skip_partition(x)))
                .and_then(|after| read_i32(after).and_then(|ops| skip_tags(ops.1).map(|end| ((e.0, name.0), end))))
        }))
    })))
}

/// MetadataResponse v13 after its header.
fn decode_metadata_response(c: Cur) -> Option<MetadataAnswer> {
    read_i32(c).and_then(|throttle| read_compact_len(throttle.1).and_then(|nb| {
        range(0, nb.0)
            .fold(Some(([], nb.1)), |acc, _i| acc.and_then(|a| decode_broker(a.1).map(|b| (a.0.push(b.0), b.1))))
            .and_then(|bs| read_compact_nullable_string(bs.1).and_then(|cluster| read_i32(cluster.1).and_then(|ctl| {
                read_compact_len(ctl.1).and_then(|nt| {
                    range(0, nt.0)
                        .fold(Some(([], nt.1)), |acc, _i| acc.and_then(|a| decode_topic(a.1).map(|t| (a.0.push(t.0), t.1))))
                        .and_then(|ts| read_i16(ts.1).and_then(|err| skip_tags(err.1).map(|_end| MetadataAnswer {
                            brokers: bs.0,
                            cluster_id: cluster.0,
                            controller_id: ctl.0,
                            topics: ts.0,
                            error: err.0,
                        })))
                })
            })))
    }))
}
