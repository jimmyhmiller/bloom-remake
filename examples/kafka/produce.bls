//! Produce, versions 10 to 12 (flexible; one layout: v12 changes only transactional semantics, KIP-890), and the
//! checks a partition's records pass before they are appended. Pure functions: the node (`produce_node.bls`) orders
//! the appends and writes the batches.

const CORRUPT_MESSAGE: i16 = 2;
const MESSAGE_TOO_LARGE: i16 = 10;
const INVALID_REQUIRED_ACKS: i16 = 21;
const TRANSACTIONAL_ID_AUTHORIZATION_FAILED: i16 = 53;
const OUT_OF_ORDER_SEQUENCE_NUMBER: i16 = 45;
const INVALID_PRODUCER_EPOCH: i16 = 47;
const INVALID_RECORD: i16 = 87;

struct ProducePartition { index: i32, records: Option<Bytes> }

struct ProduceTopic { name: String, partitions: Vec<ProducePartition> }

struct ProduceRequest { transactional_id: Option<String>, acks: i16, timeout_ms: i32, topics: Vec<ProduceTopic> }

fn decode_produce_partition(c: Cur) -> Option<(ProducePartition, Cur)> {
    read_i32(c).and_then(|i| read_compact_nullable_bytes(i.1).and_then(|r| {
        skip_tags(r.1).map(|end| (ProducePartition { index: i.0, records: r.0 }, end))
    }))
}

fn decode_produce_topic(c: Cur) -> Option<(ProduceTopic, Cur)> {
    read_compact_string(c).and_then(|name| read_compact_len(name.1).and_then(|n| {
        range(0, n.0)
            .fold(Some(([], n.1)), |acc, _i| acc.and_then(|a| decode_produce_partition(a.1).map(|p| (a.0.push(p.0), p.1))))
            .and_then(|ps| skip_tags(ps.1).map(|end| (ProduceTopic { name: name.0, partitions: ps.0 }, end)))
    }))
}

fn decode_produce(c: Cur) -> Option<ProduceRequest> {
    read_compact_nullable_string(c).and_then(|tid| read_i16(tid.1).and_then(|acks| read_i32(acks.1).and_then(|timeout| {
        read_compact_len(timeout.1).and_then(|n| {
            range(0, n.0)
                .fold(Some(([], n.1)), |acc, _i| acc.and_then(|a| decode_produce_topic(a.1).map(|t| (a.0.push(t.0), t.1))))
                .and_then(|ts| skip_tags(ts.1).map(|_end| ProduceRequest {
                    transactional_id: tid.0,
                    acks: acks.0,
                    timeout_ms: timeout.0,
                    topics: ts.0,
                }))
        })
    })))
}

/// An error that refuses every partition of a request: `acks` other than -1, 0 or 1 (INVALID_REQUIRED_ACKS), or a
/// transactional producer (transactions are out of scope, KAFKA.md K1; the broker authorizes no transactional id).
fn produce_request_error(req: ProduceRequest) -> Option<(i16, String)> {
    if req.acks != -1i16 && req.acks != 0i16 && req.acks != 1i16 {
        Some((INVALID_REQUIRED_ACKS, "acks must be -1, 0 or 1"))
    } else if req.transactional_id.is_some() {
        Some((TRANSACTIONAL_ID_AUTHORIZATION_FAILED, "this broker authorizes no transactional id"))
    } else {
        None
    }
}

/// A topic's `max.message.bytes`: the largest batch it accepts.
fn max_message_bytes(set: Vec<(String, String)>) -> i64 {
    match config_value(set, "max.message.bytes").parse_i64() {
        Some(n) => n,
        None => error("max_message_bytes: a stored max.message.bytes is not an integer"),
    }
}

/// A request's partition entries, in request order, with their positions: (entry, topic, partition, records).
fn produce_entries(req: ProduceRequest) -> Vec<(u64, String, i32, Option<Bytes>)> {
    let flat = req.topics.fold([], |acc, t| acc.concat(t.partitions.map(|p| (t.name, p.index, p.records))));
    flat.enumerate().map(|e| (e.0, e.1.0, e.1.1, e.1.2))
}

/// One partition's records, checked: an error (with its message and, for a bad batch, the batch's index), or the
/// batches and how many offsets they take.
struct Checked { error: i16, message: Option<String>, bad_batch: Option<i32>, batches: Vec<Bytes>, count: i64 }

fn refused(error: i16, message: String, bad_batch: Option<i32>) -> Checked {
    Checked { error: error, message: Some(message), bad_batch: bad_batch, batches: [], count: 0i64 }
}

/// The error of one batch, if any: not magic 2 or with inconsistent counts (INVALID_RECORD), a bad CRC or length
/// (CORRUPT_MESSAGE), larger than `max_bytes` (MESSAGE_TOO_LARGE), or transactional (INVALID_RECORD: a request
/// with transactional batches must name a transactional id, which `produce_request_error` refuses). An idempotent
/// batch's producer state is checked when it is sequenced (`sequence_appends`).
fn batch_error(b: Bytes, max_bytes: i64) -> Option<(i16, String)> {
    match batch_header(b) {
        None => Some((CORRUPT_MESSAGE, "a batch is shorter than its header")),
        Some(h) => {
            if h.magic != 2i8 {
                Some((INVALID_RECORD, "only record batches of magic 2 are accepted"))
            } else if not batch_ok(b) {
                Some((CORRUPT_MESSAGE, "a batch's length or CRC32C does not match its contents"))
            } else if h.record_count as i64 != offsets_taken(h) {
                Some((INVALID_RECORD, "a batch's record count does not match its last offset delta"))
            } else if b.len() as i64 > max_bytes {
                Some((MESSAGE_TOO_LARGE, "a batch is larger than the topic's max.message.bytes"))
            } else if (h.attributes & 16i16) != 0i16 {
                Some((INVALID_RECORD, "transactional batches need a transactional id"))
            } else {
                None
            }
        }
    }
}

/// Checks a partition's records: whole batches, each valid. The first bad batch refuses the partition, as Kafka
/// refuses it. No records (or null) append nothing.
fn check_records(records: Option<Bytes>, max_bytes: i64) -> Checked {
    let b = records.unwrap_or(Bytes::empty());
    match split_batches(b) {
        None => refused(CORRUPT_MESSAGE, "the records are not a sequence of whole batches", None),
        Some(batches) => {
            let bad = batches.enumerate().filter_map(|e| batch_error(e.1, max_bytes).map(|x| (e.0, x))).first();
            match bad {
                Some(x) => refused(x.1.0, x.1.1, Some(x.0 as i32)),
                None => Checked {
                    error: NONE,
                    message: None,
                    bad_batch: None,
                    batches: batches,
                    count: batches.fold(0i64, |n, b| n + batch_header(b).map(|h| offsets_taken(h)).unwrap_or(0i64)),
                },
            }
        }
    }
}

/// One partition's answer.
struct PartitionAnswer { error: i16, base_offset: i64, log_start: i64, message: Option<String>, bad_batch: Option<i32> }

fn unknown_partition() -> PartitionAnswer {
    PartitionAnswer {
        error: UNKNOWN_TOPIC_OR_PARTITION,
        base_offset: -1i64,
        log_start: -1i64,
        message: Some("the topic or partition does not exist"),
        bad_batch: None,
    }
}

/// Whether any partition of an answer failed.
fn produce_failed(xs: Vec<(u64, PartitionAnswer)>) -> bool {
    xs.any(|x| x.1.error != NONE)
}

fn encode_partition_answer(index: i32, a: PartitionAnswer) -> Bytes {
    let record_errors = match a.bad_batch {
        Some(i) => [Bytes::join([Bytes::from_i32_be(i), enc_compact_nullable_string(a.message), no_tags()])],
        None => [],
    };
    Bytes::join([
        Bytes::from_i32_be(index),
        Bytes::from_i16_be(a.error),
        Bytes::from_i64_be(a.base_offset),
        Bytes::from_i64_be(-1i64),
        Bytes::from_i64_be(a.log_start),
        enc_compact_array(record_errors),
        enc_compact_nullable_string(a.message),
        no_tags(),
    ])
}

/// ProduceResponse v10–v12: each entry's answer (by entry position in `answers`), grouped by topic as the request
/// grouped them.
fn encode_produce_response(correlation_id: i32, req: ProduceRequest, answers: Vec<(u64, PartitionAnswer)>) -> Bytes {
    let starts = req.topics.fold(([], 0), |acc, t| (acc.0.push(acc.1), acc.1 + t.partitions.len()));
    let topics = req.topics.enumerate().map(|e| {
        let (k, t) = e;
        let first = match starts.0.get(k) {
            Some(x) => x,
            None => error("encode_produce_response: a topic without a starting entry"),
        };
        Bytes::join([
            enc_compact_string(t.name),
            enc_compact_array(t.partitions.enumerate().map(|pe| {
                match answers.filter(|a| a.0 == first + pe.0).first() {
                    Some(a) => encode_partition_answer(pe.1.index, a.1),
                    None => error("encode_produce_response: a partition entry has no answer"),
                }
            })),
            no_tags(),
        ])
    });
    frame(Bytes::join([
        response_header_v1(correlation_id),
        enc_compact_array(topics),
        Bytes::from_i32_be(0i32),
        no_tags(),
    ]))
}

// ---------------------------------------------------------------- idempotent producers

/// A producer's state in one partition: its epoch and its last batches (at most five, oldest first): first and last
/// sequence, base and last offset.
struct ProducerEntry { pid: i64, epoch: i16, recent: Vec<(i32, i32, i64, i64)> }

/// How many batches a producer's state remembers for duplicate detection, as Kafka does.
const RECENT_BATCHES: u64 = 5;

/// One append's outcome: an error (and message), or where its batches go (`base`, and each placed batch), or, for a
/// retried batch the partition already holds, the offset it was appended at (`duplicate`).
struct AppendOutcome { error: i16, message: Option<String>, base: i64, placed: Vec<(i64, i64, i64, Bytes)>, count: i64 }

/// The appends to one partition in one tick, sequenced: each one's outcome, the new log end, and the producer
/// states that changed.
struct Sequenced { outcomes: Vec<((Instant, Conn, u64), AppendOutcome)>, end: i64, changed: Vec<ProducerEntry> }

/// The sequence number after `s` by `n`, wrapping from `i32::MAX` to 0 as Kafka's do.
fn seq_add(s: i32, n: i32) -> i32 {
    let wide = s as i64 + n as i64;
    if wide > 2147483647i64 { (wide - 2147483648i64) as i32 } else { wide as i32 }
}

fn entry_of(states: Vec<ProducerEntry>, pid: i64) -> Option<ProducerEntry> {
    states.filter(|e| e.pid == pid).first()
}

fn with_entry(states: Vec<ProducerEntry>, e: ProducerEntry) -> Vec<ProducerEntry> {
    states.filter(|x| x.pid != e.pid).push(e)
}

/// What an idempotent batch meets in its producer's state: an error (`refused`), a duplicate of the batch appended
/// at `duplicate_of`, or neither (append it).
struct Verdict { refused: Option<(i16, String)>, duplicate_of: Option<i64> }

fn append_it() -> Verdict {
    Verdict { refused: None, duplicate_of: None }
}

fn refuse(code: i16, why: String) -> Verdict {
    Verdict { refused: Some((code, why)), duplicate_of: None }
}

/// Kafka's `ProducerAppendInfo` checks: a retried batch (same epoch, same sequence range as one of the last five)
/// is a duplicate; an older epoch is INVALID_PRODUCER_EPOCH; a new epoch must start at sequence 0, and the same
/// epoch must continue the last sequence, else OUT_OF_ORDER_SEQUENCE_NUMBER. A producer this partition has no state
/// for may start at any sequence.
fn producer_check(e: Option<ProducerEntry>, h: BatchHeader) -> Verdict {
    let last_seq = seq_add(h.base_sequence, h.last_offset_delta);
    match e {
        None => append_it(),
        Some(x) => {
            let dup = x.recent.filter(|r| r.0 == h.base_sequence && r.1 == last_seq).first();
            if h.producer_epoch == x.epoch && dup.is_some() {
                Verdict { refused: None, duplicate_of: dup.map(|r| r.2) }
            } else if h.producer_epoch < x.epoch {
                refuse(INVALID_PRODUCER_EPOCH, "the producer's epoch is older than the partition's")
            } else if h.producer_epoch != x.epoch {
                if h.base_sequence == 0i32 { append_it() } else { refuse(OUT_OF_ORDER_SEQUENCE_NUMBER, "a new epoch starts at sequence 0") }
            } else if h.base_sequence == next_sequence(x) {
                append_it()
            } else {
                refuse(OUT_OF_ORDER_SEQUENCE_NUMBER, "the batch does not continue the producer's sequence")
            }
        }
    }
}

/// The sequence a producer's next batch must start at.
fn next_sequence(x: ProducerEntry) -> i32 {
    match x.recent.last() {
        Some(r) => seq_add(r.1, 1i32),
        None => 0i32,
    }
}

/// The producer state after appending a batch at offsets `base..=last`.
fn after_append(e: Option<ProducerEntry>, h: BatchHeader, base: i64, last: i64) -> ProducerEntry {
    let batch = (h.base_sequence, seq_add(h.base_sequence, h.last_offset_delta), base, last);
    let kept = match e {
        Some(x) => if x.epoch == h.producer_epoch { x.recent } else { [] },
        None => [],
    };
    let all = kept.push(batch);
    let drop = if all.len() > RECENT_BATCHES { all.len() - RECENT_BATCHES } else { 0 };
    ProducerEntry { pid: h.producer_id, epoch: h.producer_epoch, recent: all.enumerate().filter(|x| x.0 >= drop).map(|x| x.1) }
}

/// The state of an append while its batches are checked: the batches placed so far, the next offset, the producer
/// states, and whether a batch was refused or found to be a duplicate (which ends the walk).
struct Walk { placed: Vec<(i64, i64, i64, Bytes)>, at: i64, states: Vec<ProducerEntry>, refused: Option<(i16, String)>, duplicate_of: Option<i64> }

fn walk_batch(w: Walk, b: Bytes) -> Walk {
    if w.refused.is_some() || w.duplicate_of.is_some() {
        w
    } else {
        match batch_header(b) {
            None => error("walk_batch: an accepted batch has no header"),
            Some(h) => {
                let n = offsets_taken(h);
                let placed = w.placed.push((w.at, w.at + n - 1i64, h.max_timestamp, stamp(b, w.at)));
                if h.producer_id == -1i64 {
                    Walk { placed: placed, at: w.at + n, states: w.states, refused: None, duplicate_of: None }
                } else {
                    let e = entry_of(w.states, h.producer_id);
                    let v = producer_check(e, h);
                    if v.refused.is_some() || v.duplicate_of.is_some() {
                        Walk { placed: w.placed, at: w.at, states: w.states, refused: v.refused, duplicate_of: v.duplicate_of }
                    } else {
                        Walk {
                            placed: placed,
                            at: w.at + n,
                            states: with_entry(w.states, after_append(e, h, w.at, w.at + n - 1i64)),
                            refused: None,
                            duplicate_of: None,
                        }
                    }
                }
            }
        }
    }
}

/// One append (one partition entry's batches) against the log end `end` and the producer states: its outcome, and
/// the states after it. Every batch must pass; the first refusal refuses the whole entry and changes nothing. A
/// retried batch returns where it was appended and appends nothing, as Kafka answers a duplicate.
fn sequence_one(batches: Vec<Bytes>, end: i64, states: Vec<ProducerEntry>) -> (AppendOutcome, Vec<ProducerEntry>) {
    let w = batches.fold(Walk { placed: [], at: end, states: states, refused: None, duplicate_of: None }, |acc, b| walk_batch(acc, b));
    match (w.refused, w.duplicate_of) {
        (Some(x), _) => (AppendOutcome { error: x.0, message: Some(x.1), base: -1i64, placed: [], count: 0i64 }, states),
        (None, Some(base)) => (AppendOutcome { error: NONE, message: None, base: base, placed: [], count: 0i64 }, states),
        (None, None) => (
            AppendOutcome { error: NONE, message: None, base: if w.at == end { -1i64 } else { end }, placed: w.placed, count: w.at - end },
            w.states,
        ),
    }
}

/// `b` with its offset assigned at `at` (`check_records` accepted it, so it has room for it).
fn stamp(b: Bytes, at: i64) -> Bytes {
    match with_offsets(b, at, 0i32) {
        Some(x) => x,
        None => error("stamp: an accepted batch has no room for its offsets"),
    }
}

/// The appends to one partition in one tick, in the tick's order (`xs` is ordered, as `collect!` orders it).
fn sequence_appends(xs: Vec<((Instant, Conn, u64), Vec<Bytes>)>, end: i64, states: Vec<ProducerEntry>) -> Sequenced {
    let start: (Vec<((Instant, Conn, u64), AppendOutcome)>, i64, Vec<ProducerEntry>) = ([], end, states);
    let r = xs.fold(start, |acc, x| {
        let (outs, at, sts) = acc;
        let (o, sts2) = sequence_one(x.1, at, sts);
        (outs.push((x.0, o)), at + o.count, sts2)
    });
    let changed = r.2.filter(|e| not states.any(|s| s == e));
    Sequenced { outcomes: r.0, end: r.1, changed: changed }
}

/// The outcome of the append ordered `o`.
fn outcome_of(s: Sequenced, o: (Instant, Conn, u64)) -> AppendOutcome {
    match s.outcomes.filter(|x| x.0 == o).first() {
        Some(x) => x.1,
        None => error("outcome_of: an append was not sequenced"),
    }
}

/// Every batch the sequenced appends place.
fn placed_all(s: Sequenced) -> Vec<(i64, i64, i64, Bytes)> {
    s.outcomes.fold([], |acc, x| acc.concat(x.1.placed))
}

// ---------------------------------------------------------------- InitProducerId v3–v5

struct InitProducerIdRequest { transactional_id: Option<String>, timeout_ms: i32, producer_id: i64, producer_epoch: i16 }

fn decode_init_producer_id(c: Cur) -> Option<InitProducerIdRequest> {
    read_compact_nullable_string(c).and_then(|t| read_i32(t.1).and_then(|timeout| read_i64(timeout.1).and_then(|pid| {
        read_i16(pid.1).and_then(|epoch| skip_tags(epoch.1).map(|_end| InitProducerIdRequest {
            transactional_id: t.0,
            timeout_ms: timeout.0,
            producer_id: pid.0,
            producer_epoch: epoch.0,
        }))
    })))
}

fn encode_init_producer_id_response(correlation_id: i32, error: i16, producer_id: i64, epoch: i16) -> Bytes {
    frame(Bytes::join([
        response_header_v1(correlation_id),
        Bytes::from_i32_be(0i32),
        Bytes::from_i16_be(error),
        Bytes::from_i64_be(producer_id),
        Bytes::from_i16_be(epoch),
        no_tags(),
    ]))
}

// ---------------------------------------------------------------- the offset and time indexes

/// Offsets per chunk of the chunk index.
const CHUNK: i64 = 256;

/// The chunks a batch covering offsets `base..=last` falls in.
fn chunks_of(base: i64, last: i64) -> Vec<i64> {
    range(0, (last / CHUNK - base / CHUNK + 1i64) as u64).map(|k| base / CHUNK + k as i64)
}

/// The time index rows the placed batches add, given the partition's greatest timestamp `m` before them: each batch
/// whose greatest timestamp is above every earlier one's, with that timestamp and its base.
fn time_marks(placed: Vec<(i64, i64, i64, Bytes)>, m: i64) -> Vec<(i64, i64)> {
    let end = placed.fold(([], m), |acc, pb| {
        let (marks, top) = acc;
        if pb.2 > top { (marks.push((pb.2, pb.0)), pb.2) } else { (marks, top) }
    });
    end.0
}
