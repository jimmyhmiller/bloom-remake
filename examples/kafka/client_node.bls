//! A Kafka client in Blossom (slice 6, item 8): on a connect stream it dials a broker, sends ApiVersions (v4) and
//! Metadata (v13, all topics), and records the answers. It redials when the connection closes or a dial fails, and
//! asks again, so every connection it gets answered records the same answers.
//!
//! It talks to one broker at a time, from its `contact` addresses (`BROKER_ADDR` alone without any), and moves to
//! the next when a dial fails or the broker answers that it does not lead the partition (S11): as a Kafka client
//! follows the partition's leader, though by trying the brokers in turn rather than by reading the leader from
//! Metadata. A connection that closes is dialed again to the same broker (a broker that is down fails the dial).

stream up: connect;

/// The brokers to talk to, by index.
static contact(i: u64, addr: String);
view contacts(n = count!(i)) = contact(i, _);
view broker_addr(i, a) {
    contact(i, a);
    not contact(_, _), let i = 0u64, let a = BROKER_ADDR;
}
view broker_count(n) {
    contacts(n);
    not contact(_, _), let n = 1u64;
}
/// The broker the client is on (no row: the first), its address, and the next one's.
durable table on_broker(i: u64) key();
view current_broker(i = max!(x default 0u64)) = on_broker(x);
view current_addr(a) = current_broker(i), broker_addr(i, a);
view next_broker(j, a) = current_broker(i), broker_count(n), let j = (i + 1u64) % n, broker_addr(j, a);

/// Per connection: the bytes not yet consumed.
table session(c: Conn, bytes: Framer) key(c);

/// The answers: ApiVersions' error and ranges, and each metadata answer.
table versions_seen(error: i16, ranges: Vec<ApiRange>);
table metadata_seen(answer: MetadataAnswer);


start: on boot(), current_addr(a) {
    send up.dial(0, a);
}

redial_after_failure: on up.failed(req, _why), next_broker(j, a) {
    upsert on_broker(j);
    send up.dial(req + 1, a);
}

redial_after_close: on up.closed(c, _why), session(c, p), current_addr(a) {
    delete session(c, p);
    send up.dial(0, a);
}

ask: on up.opened(c, _req, _peer, _at) {
    emit session(c, framer());
    send up.write(c, 0, [
        Part::Bytes(encode_api_versions_request(CORR_VERSIONS, "blossom", "blossom-kafka-client", "0.1")),
        Part::Bytes(encode_metadata_request(CORR_METADATA, "blossom", None)),
    ]);
}

/// A connection's chunks come one per tick after its `opened` tick; each complete response frame is recorded.
recv: on up.data(c, _seq, bytes), session(c, f) {
    upsert session(c, feed(f, bytes).next);
}

record_versions: on up.data(c, _seq, bytes), session(c, f),
        fr in feed(f, bytes).frames,
        let Some(v) = versions_answer(fr) {
    emit versions_seen(v.0, v.1);
}

record_metadata: on up.data(c, _seq, bytes), session(c, f),
        fr in feed(f, bytes).frames,
        let Some(m) = metadata_answer(fr) {
    emit metadata_seen(m);
}

// ---------------------------------------------------------------- producing and reading back (slice 7, item 8)
//
// With `CLIENT_BATCHES` above 0 the client also produces that many batches to `CLIENT_TOPIC` (auto-created through
// Metadata), one at a time with `CLIENT_ACKS`, then reads every partition back from offset 0 to its high watermark.
// Its progress is durable, so a crash of the client resumes it. A produce whose connection closed unanswered (it may
// or may not be in the log) is sent again only with `CLIENT_RETRY`; with `CLIENT_IDEMPOTENT` the client first asks
// for a producer id and numbers its batches, so the broker keeps one copy of a batch sent twice.

/// The topic, once Metadata has named it: its id and partition count.
durable table topic_seen(id: Bytes, partitions: u64) key();
/// The next batch to send (no row: 0), the batches sent, and the answers.
durable table produced_next(k: u64) key();
durable table sent(k: u64) key(k);
durable table acked(k: u64, partition: i32, base: i64, error: i16) key(k);
/// Where the read is (no row: partition 0, offset 0), whether it is done, and what it read.
durable table reading(partition: i32, next: i64) key();
durable table read_done(done: bool) key();
durable table consumed(partition: i32, offset: i64, value: Bytes) key(partition, offset);

/// Per connection: the next write's `seq` (writes are numbered from 0 on each connection; the first two are sent
/// when it opens). One request is in flight at a time, so a connection writes at most once a tick after that.
table wseq(c: Conn, next: u64) key(c);

view progress(k = max!(x default 0u64)) = produced_next(x);

/// The producer id and epoch, once InitProducerId answered (idempotence), and what batches carry: those, or none.
durable table producer_id(pid: i64, epoch: i16) key();
view producing_as(pid, epoch) {
    producer_id(pid, epoch);
    not producer_id(_, _), let pid = -1i64, let epoch = -1i16 where not CLIENT_IDEMPOTENT;
}
/// A batch sent and not answered.
view outstanding(k) = sent(k), not acked(k, _, _, _);
view read_at(p = max!(x default 0i32), off = max!(y default 0i64)) = reading(x, y);

/// The response frames that arrive this tick, per connection.
view frames(c, fr) = up.data(c, _seq, bytes), session(c, f), fr in feed(f, bytes).frames;

ask_topic: on up.opened(c, _req, _peer, _at) where CLIENT_BATCHES > 0u64 && not CLIENT_IDEMPOTENT {
    send up.write(c, 1, [Part::Bytes(encode_metadata_request(CORR_TOPIC, "blossom", Some([CLIENT_TOPIC])))]);
    emit wseq(c, 2);
}

ask_topic_with_pid: on up.opened(c, _req, _peer, _at), producer_id(_, _) where CLIENT_BATCHES > 0u64 && CLIENT_IDEMPOTENT {
    send up.write(c, 1, [Part::Bytes(encode_metadata_request(CORR_TOPIC, "blossom", Some([CLIENT_TOPIC])))]);
    emit wseq(c, 2);
}

/// An idempotent producer without its id asks for one first, in the same write: the answer comes before the topic's.
ask_pid_and_topic: on up.opened(c, _req, _peer, _at), not producer_id(_, _) where CLIENT_BATCHES > 0u64 && CLIENT_IDEMPOTENT {
    send up.write(c, 1, [
        Part::Bytes(encode_init_pid_request(CORR_INIT_PID, "blossom")),
        Part::Bytes(encode_metadata_request(CORR_TOPIC, "blossom", Some([CLIENT_TOPIC]))),
    ]);
    emit wseq(c, 2);
}

/// The producer id, recorded in the tick it arrives (the topic's answer may come in the same chunk).
learn_pid: on frames(_c, fr), let Some(a) = init_pid_answer(fr) where a.0 == NONE {
    emit producer_id(a.1, a.2);
}

/// No producer id yet (the cluster has none to give): ask again on a new connection.
pid_refused: on frames(c, fr), let Some(a) = init_pid_answer(fr) where a.0 != NONE {
    send up.close(c);
}

/// A produce whose connection closed unanswered is sent again (`CLIENT_RETRY`).
retry_unanswered: on up.closed(_c, _why), outstanding(k) where CLIENT_RETRY {
    upsert produced_next(k);
}

forget_wseq: on up.closed(c, _why), wseq(c, n) {
    delete wseq(c, n);
}

/// Once the topic is known (on every connection): resume producing, or reading.
learn_topic: on frames(c, fr), let Some(t) = topic_answer(fr) {
    upsert topic_seen(t.0, t.1);
}

resume_produce: on frames(c, fr), let Some(t) = topic_answer(fr), progress(k), wseq(c, n), producing_as(pid, epoch)
        where k < CLIENT_BATCHES {
    send up.write(c, n, [Part::Bytes(produce_frame_as(k, t.1, pid, epoch))]);
    upsert wseq(c, n + 1u64);
    upsert produced_next(k + 1u64);
    emit sent(k);
}

resume_read: on frames(c, fr), let Some(t) = topic_answer(fr), progress(k), read_at(p, off), not read_done(_), wseq(c, n)
        where k >= CLIENT_BATCHES && CLIENT_BATCHES > 0u64 {
    send up.write(c, n, [Part::Bytes(encode_fetch_request(CORR_FETCH, "blossom", t.0, p, off))]);
    upsert wseq(c, n + 1u64);
}

/// A produce answered by a broker that does not lead the partition (or by one whose partition has no leader yet):
/// the batch was not appended, so it is sent again, to the next broker (the connection's close redials there).
produce_elsewhere: on frames(c, fr), let Some(a) = produce_answer(fr), next_broker(j, _a)
        where a.1 == NOT_LEADER_OR_FOLLOWER || a.1 == LEADER_NOT_AVAILABLE {
    upsert produced_next(a.0);
    upsert on_broker(j);
    send up.close(c);
}

/// A produce answered: record it, then send the next batch, or start reading.
after_produce: on frames(c, fr), let Some(a) = produce_answer(fr), topic_seen(id, parts), wseq(c, n), producing_as(pid, epoch)
        where a.1 != NOT_LEADER_OR_FOLLOWER && a.1 != LEADER_NOT_AVAILABLE {
    emit acked(a.0, (a.0 % parts) as i32, a.2, a.1);
    upsert wseq(c, n + 1u64);
    if a.0 + 1u64 < CLIENT_BATCHES {
        send up.write(c, n, [Part::Bytes(produce_frame_as(a.0 + 1u64, parts, pid, epoch))]);
        upsert produced_next(a.0 + 2u64);
        emit sent(a.0 + 1u64);
    } else {
        send up.write(c, n, [Part::Bytes(encode_fetch_request(CORR_FETCH, "blossom", id, 0i32, 0i64))]);
    }
}

/// A fetch answered: record its records, then read on or finish.
record_fetch: on frames(_c, fr), let Some(r) = fetched_answer(fr), read_at(p, _off), rec in r.2 {
    emit consumed(p, rec.0, rec.1);
}

/// A fetch from a broker that does not lead the partition: read on from the next broker.
fetch_elsewhere: on frames(c, fr), let Some(r) = fetched_answer(fr), next_broker(j, _a) where r.0 == NOT_LEADER_OR_FOLLOWER {
    upsert on_broker(j);
    send up.close(c);
}

after_fetch: on frames(c, fr), let Some(r) = fetched_answer(fr), read_at(p, off), topic_seen(id, parts), wseq(c, w),
        let Some(n) = next_read(p, off, parts, r.0, r.1, r.2) where r.0 != NOT_LEADER_OR_FOLLOWER {
    upsert reading(n.0, n.1);
    send up.write(c, w, [Part::Bytes(encode_fetch_request(CORR_FETCH, "blossom", id, n.0, n.1))]);
    upsert wseq(c, w + 1u64);
}

finish_read: on frames(_c, fr), let Some(r) = fetched_answer(fr), read_at(p, off), topic_seen(_id, parts)
        where next_read(p, off, parts, r.0, r.1, r.2) == None {
    emit read_done(true);
}
