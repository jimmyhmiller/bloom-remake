//! Record batches, magic 2 (KAFKA.md "Record batches and offsets"): the broker keeps batches as they arrive, checks
//! their CRC32C, and assigns offsets by writing `baseOffset` and `partitionLeaderEpoch`, which lie before the part
//! the CRC covers, so no checksum is recomputed and compressed batches stay compressed.
//!
//! A batch's header, by byte position:
//!
//! | 0 baseOffset i64 | 8 batchLength i32 | 12 partitionLeaderEpoch i32 | 16 magic i8 | 17 crc u32 |
//! | 21 attributes i16 | 23 lastOffsetDelta i32 | 27 baseTimestamp i64 | 35 maxTimestamp i64 | 43 producerId i64 |
//! | 51 producerEpoch i16 | 53 baseSequence i32 | 57 recordCount i32 | 61 records… |
//!
//! `batchLength` counts from the leader epoch to the end, so a batch takes `12 + batchLength` bytes; the CRC covers
//! from `attributes` to the end.

extern fn crc32c(b: Bytes) -> u32 = "blossom_std::checksum::crc32c";

/// The fixed header of a batch: the bytes before its first record.
const BATCH_HEADER: u64 = 61;

struct BatchHeader {
    base_offset: i64,
    length: i32,
    leader_epoch: i32,
    magic: i8,
    crc: u32,
    attributes: i16,
    last_offset_delta: i32,
    base_timestamp: i64,
    max_timestamp: i64,
    producer_id: i64,
    producer_epoch: i16,
    base_sequence: i32,
    record_count: i32,
}

/// The header of the batch at the front of `b`, if `b` is long enough to hold one.
fn batch_header(b: Bytes) -> Option<BatchHeader> {
    if b.len() < BATCH_HEADER {
        None
    } else {
        b.i64_be_at(0).and_then(|base| b.i32_be_at(8).and_then(|len| b.i32_be_at(12).and_then(|epoch| {
            b.i8_at(16).and_then(|magic| b.u32_be_at(17).and_then(|crc| b.i16_be_at(21).and_then(|attrs| {
                b.i32_be_at(23).and_then(|delta| b.i64_be_at(27).and_then(|first| b.i64_be_at(35).and_then(|max| {
                    b.i64_be_at(43).and_then(|pid| b.i16_be_at(51).and_then(|pepoch| b.i32_be_at(53).and_then(|seq| {
                        b.i32_be_at(57).map(|count| BatchHeader {
                            base_offset: base,
                            length: len,
                            leader_epoch: epoch,
                            magic: magic,
                            crc: crc,
                            attributes: attrs,
                            last_offset_delta: delta,
                            base_timestamp: first,
                            max_timestamp: max,
                            producer_id: pid,
                            producer_epoch: pepoch,
                            base_sequence: seq,
                            record_count: count,
                        })
                    })))
                })))
            })))
        })))
    }
}

/// The batches of a records field, in order: `None` if any is truncated or its length is not a whole batch. A batch
/// takes at least a header, so at most `len / 61` are looked for.
fn split_batches(b: Bytes) -> Option<Vec<Bytes>> {
    let end = range(0, b.len() / BATCH_HEADER + 1).fold(Some(([], 0)), |acc, _i| {
        acc.and_then(|a| {
            let (batches, pos) = a;
            if pos == b.len() {
                Some((batches, pos))
            } else {
                b.i32_be_at(pos + 8).and_then(|n| {
                    if n < 49i32 {
                        None
                    } else {
                        let size = 12 + n as u64;
                        if size > b.len() - pos {
                            None
                        } else {
                            b.slice(pos, pos + size).map(|x| (batches.push(x), pos + size))
                        }
                    }
                })
            }
        })
    });
    end.and_then(|e| if e.1 == b.len() { Some(e.0) } else { None })
}

/// Whether `b` is one whole, uncorrupted magic-2 batch: its length matches, its counts are sane and its CRC32C over
/// `attributes..end` matches.
fn batch_ok(b: Bytes) -> bool {
    match batch_header(b) {
        Some(h) => {
            h.magic == 2i8
                && 12 + h.length as u64 == b.len()
                && h.record_count >= 0i32
                && h.last_offset_delta >= 0i32
                && b.slice(21, b.len()).map(|covered| crc32c(covered) == h.crc).unwrap_or(false)
        }
        None => false,
    }
}

/// `b` with its offsets assigned: `baseOffset` and `partitionLeaderEpoch` written (outside the CRC's cover).
fn with_offsets(b: Bytes, base: i64, epoch: i32) -> Option<Bytes> {
    b.put_i64_be(0, base).and_then(|x| x.put_i32_be(12, epoch))
}

/// How many offsets a batch takes: `lastOffsetDelta + 1`.
fn offsets_taken(h: BatchHeader) -> i64 {
    h.last_offset_delta as i64 + 1
}
