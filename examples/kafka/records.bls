//! Record batches, magic 2 (KAFKA.md "Record batches and offsets"): the broker keeps batches as they arrive, checks
//! their CRC32C, and assigns offsets by writing `baseOffset` and `partitionLeaderEpoch`, which lie before the part
//! the CRC covers, so no checksum is recomputed and compressed batches stay compressed.
//!
//! A batch's header, by byte position:
//!
//! | 0 baseOffset i64 | 8 batchLength i32 | 12 partitionLeaderEpoch i32 | 16 magic i8 | 17 crc u32 |
//! | 21 attributes i16 | 23 lastOffsetDelta i32 | 27 baseTimestamp i64 | 35 maxTimestamp i64 | 43 producerId i64 |
//! | 51 producerEpoch i16 | 53 baseSequence i32 | 57 recordCount i32 | 61 records… |
//!
//! `batchLength` counts from the leader epoch to the end, so a batch takes `12 + batchLength` bytes; the CRC covers
//! from `attributes` to the end.

extern fn crc32c(b: Bytes) -> u32 = "blossom_std::checksum::crc32c";

/// The fixed header of a batch: the bytes before its first record.
const BATCH_HEADER: u64 = 61;

struct BatchHeader {
    base_offset: i64,
    length: i32,
    leader_epoch: i32,
    magic: i8,
    crc: u32,
    attributes: i16,
    last_offset_delta: i32,
    base_timestamp: i64,
    max_timestamp: i64,
    producer_id: i64,
    producer_epoch: i16,
    base_sequence: i32,
    record_count: i32,
}

/// The header of the batch at the front of `b`, if `b` is long enough to hold one.
fn batch_header(b: Bytes) -> Option<BatchHeader> {
    if b.len() < BATCH_HEADER {
        None
    } else {
        b.i64_be_at(0).and_then(|base| b.i32_be_at(8).and_then(|len| b.i32_be_at(12).and_then(|epoch| {
            b.i8_at(16).and_then(|magic| b.u32_be_at(17).and_then(|crc| b.i16_be_at(21).and_then(|attrs| {
                b.i32_be_at(23).and_then(|delta| b.i64_be_at(27).and_then(|first| b.i64_be_at(35).and_then(|max| {
                    b.i64_be_at(43).and_then(|pid| b.i16_be_at(51).and_then(|pepoch| b.i32_be_at(53).and_then(|seq| {
                        b.i32_be_at(57).map(|count| BatchHeader {
                            base_offset: base,
                            length: len,
                            leader_epoch: epoch,
                            magic: magic,
                            crc: crc,
                            attributes: attrs,
                            last_offset_delta: delta,
                            base_timestamp: first,
                            max_timestamp: max,
                            producer_id: pid,
                            producer_epoch: pepoch,
                            base_sequence: seq,
                            record_count: count,
                        })
                    })))
                })))
            })))
        })))
    }
}

/// The batches of a records field, in order: `None` if any is truncated or its length is not a whole batch. A batch
/// takes at least a header, so at most `len / 61` are looked for.
fn split_batches(b: Bytes) -> Option<Vec<Bytes>> {
    let end = range(0, b.len() / BATCH_HEADER + 1).fold(Some(([], 0)), |acc, _i| {
        acc.and_then(|a| {
            let (batches, pos) = a;
            if pos == b.len() {
                Some((batches, pos))
            } else {
                b.i32_be_at(pos + 8).and_then(|n| {
                    if n < 49i32 {
                        None
                    } else {
                        let size = 12 + n as u64;
                        if size > b.len() - pos {
                            None
                        } else {
                            b.slice(pos, pos + size).map(|x| (batches.push(x), pos + size))
                        }
                    }
                })
            }
        })
    });
    end.and_then(|e| if e.1 == b.len() { Some(e.0) } else { None })
}

/// Whether `b` is one whole, uncorrupted magic-2 batch: its length matches, its counts are sane and its CRC32C over
/// `attributes..end` matches.
fn batch_ok(b: Bytes) -> bool {
    match batch_header(b) {
        Some(h) => {
            h.magic == 2i8
                && 12 + h.length as u64 == b.len()
                && h.record_count >= 0i32
                && h.last_offset_delta >= 0i32
                && b.slice(21, b.len()).map(|covered| crc32c(covered) == h.crc).unwrap_or(false)
        }
        None => false,
    }
}

/// `b` with its offsets assigned: `baseOffset` and `partitionLeaderEpoch` written (outside the CRC's cover).
fn with_offsets(b: Bytes, base: i64, epoch: i32) -> Option<Bytes> {
    b.put_i64_be(0, base).and_then(|x| x.put_i32_be(12, epoch))
}

/// How many offsets a batch takes: `lastOffsetDelta + 1`.
fn offsets_taken(h: BatchHeader) -> i64 {
    h.last_offset_delta as i64 + 1
}

// ---------------------------------------------------------------- records inside a batch

extern fn gzip_decompress(b: Bytes, max: u64) -> Option<Bytes> = "blossom_std::compress::gzip_decompress";
extern fn snappy_block(b: Bytes, max: u64) -> Option<Bytes> = "blossom_std::compress::snappy_decompress";
extern fn lz4_decompress(b: Bytes, max: u64) -> Option<Bytes> = "blossom_std::compress::lz4_decompress";
extern fn zstd_decompress(b: Bytes, max: u64) -> Option<Bytes> = "blossom_std::compress::zstd_decompress";

/// The most a batch's records may decompress to. A batch is at most `max.message.bytes` compressed; this bounds
/// what a decompression bomb can make the broker allocate.
const MAX_RECORDS_BYTES: u64 = 67108864;

/// The magic that starts snappy in the xerial framing Kafka's Java client writes: `0x82 SNAPPY 0`.
fn xerial_magic() -> Bytes {
    Bytes::join([Bytes::from_u8(130u8), "SNAPPY".to_utf8(), Bytes::from_u8(0u8)])
}

/// Kafka's snappy: the xerial framing (the magic, a version and a compatibility word, then chunks of a 4-byte length
/// and a raw block), or, from other clients, one raw block.
fn kafka_snappy(b: Bytes, max: u64) -> Option<Bytes> {
    let framed = b.slice(0, 8).map(|m| m == xerial_magic()).unwrap_or(false);
    if not framed {
        snappy_block(b, max)
    } else {
        // At most one chunk per 5 bytes (a length and a byte).
        let end = range(0, b.len() / 5 + 1).fold(Some(([], 16)), |acc, _i| acc.and_then(|a| {
            let (out, pos) = a;
            if pos == b.len() {
                Some((out, pos))
            } else {
                b.u32_be_at(pos).and_then(|n| b.slice(pos + 4, pos + 4 + n as u64).and_then(|chunk| {
                    snappy_block(chunk, max).map(|x| (out.push(x), pos + 4 + n as u64))
                }))
            }
        }));
        end.and_then(|e| {
            let all = Bytes::join(e.0);
            if e.1 == b.len() && all.len() <= max { Some(all) } else { None }
        })
    }
}

/// A batch's records section, decompressed: codec 0 none, 1 gzip, 2 snappy, 3 LZ4 (frame), 4 zstd.
fn batch_records(b: Bytes, h: BatchHeader) -> Option<Bytes> {
    b.slice(BATCH_HEADER, b.len()).and_then(|r| {
        let codec = h.attributes & 7i16;
        if codec == 0i16 {
            Some(r)
        } else if codec == 1i16 {
            gzip_decompress(r, MAX_RECORDS_BYTES)
        } else if codec == 2i16 {
            kafka_snappy(r, MAX_RECORDS_BYTES)
        } else if codec == 3i16 {
            lz4_decompress(r, MAX_RECORDS_BYTES)
        } else if codec == 4i16 {
            zstd_decompress(r, MAX_RECORDS_BYTES)
        } else {
            None
        }
    })
}

/// Each record's offset and timestamp, in order (a record: its length, attributes, timestamp delta, offset delta,
/// then key, value and headers, which are skipped by the length). `None` if the records do not parse.
fn record_times(b: Bytes) -> Option<Vec<(i64, i64)>> {
    batch_header(b).and_then(|h| batch_records(b, h).and_then(|r| {
        let n = if h.record_count < 0i32 { 0 } else { h.record_count as u64 };
        let end = range(0, n).fold(Some(([], 0)), |acc, _i| acc.and_then(|a| {
            let (out, pos) = a;
            r.varint_at(pos).and_then(|len| r.varint_at(len.1 + 1).and_then(|td| r.varint_at(td.1).and_then(|od| {
                if len.0 < 0i64 {
                    None
                } else {
                    add_i64(h.base_offset, od.0).and_then(|o| add_i64(h.base_timestamp, td.0).map(|t| {
                        (out.push((o, t)), len.1 + len.0 as u64)
                    }))
                }
            })))
        }));
        end.and_then(|e| if e.1 == r.len() { Some(e.0) } else { None })
    }))
}

/// `a + b`, or `None` where it leaves `i64`: a record's deltas come from the client and are not checked at produce
/// time, so reading them must not overflow.
fn add_i64(a: i64, b: i64) -> Option<i64> {
    if (b > 0i64 && a > 9223372036854775807i64 - b) || (b < 0i64 && a < -9223372036854775807i64 - 1i64 - b) {
        None
    } else {
        Some(a + b)
    }
}

/// The first record at or after timestamp `t` in batch `b`: `Some(Some((timestamp, offset)))`, `Some(None)` if no
/// record is, and `None` if the batch's records do not parse (the broker never decompresses at produce time, so a
/// client could store such a batch; the caller reports it corrupt).
fn first_at_or_after(b: Bytes, t: i64) -> Option<Option<(i64, i64)>> {
    record_times(b).map(|rs| rs.filter(|x| x.1 >= t).first().map(|x| (x.1, x.0)))
}

/// The offset of the first record of batch `b` whose timestamp is `t`; `None` as for `first_at_or_after`.
fn offset_of_timestamp(b: Bytes, t: i64) -> Option<Option<i64>> {
    record_times(b).map(|rs| rs.filter(|x| x.1 == t).first().map(|x| x.0))
}
