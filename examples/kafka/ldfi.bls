//! The Blossom Kafka broker under LDFI (S11): the broker and the Blossom Kafka client (`client_node.bls`) as two
//! roles of one module, the client dialing the first broker at `sim://B1/kafka`, producing `CLIENT_BATCHES` batches
//! with acks -1 and reading them back, checked with Kafka's properties in the synchronous-round world under lost
//! messages and crash-restarts. This file is a library of modules and specs: it has no `program` header.

pub module Kafka(
    CLIENT_BATCHES: u64 = 1,
    DEFAULT_PARTITIONS: i32 = 1,
    DEFAULT_REPLICATION_FACTOR: i16 = 1,
) {
    include "protocol.bls";
    include "headers.bls";
    include "apiversions.bls";
    include "metadata.bls";
    include "topics.bls";
    include "records.bls";
    include "produce.bls";
    include "fetch.bls";
    include "reassign.bls";
    include "groups.bls";
    include "coordinator.bls";
    include "broker_fns.bls";
    include "client_fns.bls";

    role Broker: cluster;
    role Client;

    static broker(n: Node<Broker>, id: i32, host: String, port: i32);

    param AUTO_CREATE_TOPICS: bool = true;
    param METADATA_CREATE_WAIT: Duration = 2s;
    param RETENTION_CHECK: Duration = 300s;
    param CLUSTER_ID: String = "blossom-ldfi";
    param MAX_QUEUED_REQUESTS: u64 = 64;
    param MAX_QUEUED_BYTES: u64 = 16777216;
    param OFFSETS_PARTITIONS: i32 = 1;
    param OFFSETS_REPLICATION: i16 = 1;
    param GROUP_MIN_SESSION_MS: i32 = 6000;
    param GROUP_MAX_SESSION_MS: i32 = 1800000;
    param GROUP_INITIAL_DELAY_MS: i32 = 3000;
    param OFFSET_COMMIT_TIMEOUT: Duration = 5s;
    param OFFSETS_KEEP: u64 = 1000;
    param OFFSET_FETCH_CONFIRM: Duration = 2s;
    param BROKER_ADDR: String = "sim://B1/kafka";
    param CLIENT_TOPIC: String = "logs";

    include "raft.bls";
    include "cluster.bls";

    at Broker {
        include "broker_node.bls";
        include "topics_node.bls";
        include "produce_node.bls";
        include "fetch_node.bls";
        include "groups_node.bls";
    }

    at Client {
        include "client_node.bls";
    }
}

/// One broker and the client.
spec Single {
    nodes B1, C1;
    assign Broker = [B1];
    assign Client = [C1];
    fact broker(B1, 1, "b1.sim", 9092);
}

/// Kafka's guarantees to a producer, one `(property, batch)` row each:
/// - durability: a batch acknowledged without error stays in the partition's committed log: some broker holds it
///   committed (materialized, or committed and waiting to be; a broker down at EOT counts with the state it went down
///   with, which it restarts from), and no broker holds another batch at its offset (a replica that restarted may
///   lag: it is not asked to hold what it has not committed yet, only not to hold something else there);
/// - read back: once the client has read every partition to its end, it has read every acknowledged batch, at its
///   offset;
/// - unique offset: no other acknowledged batch was given its offset;
/// - stored once (one row, batch 0): once the client has read every partition to its end, it read no record twice
///   (a retried batch the log holds twice would show).
spec Guarantees {
    view acknowledged(k, p, base) = acked(k, p, base, 0i16) @ _;
    view pre(prop, k) {
        acknowledged(k, _, _), let prop = "durability";
        acknowledged(k, _, _), read_done(true) @ _, let prop = "read back";
        acknowledged(k, _, _), let prop = "unique offset";
        read_done(true) @ _, let prop = "stored once", let k = 0u64;
    }
    /// The batches a broker holds committed, by blob: materialized, or committed and not yet materialized.
    view holds_batch(b, p, base, blob) {
        batch(_, p, base, _, _, blob) @ b;
        pending_batch(_, p, base, _, _, blob) @ b;
    }
    view held(p, base) = holds_batch(_, p, base, _);
    /// Two brokers that hold different batches at one offset.
    view diverged(p, base) = holds_batch(b1, p, base, x), holds_batch(b2, p, base, y) where x != y;
    view read_twice(v) = consumed(p, o1, v) @ c, consumed(p, o2, v) @ c where o1 != o2;
    view shared_offset(k) = acknowledged(k, p, base), acknowledged(j, p, base) where j != k;
    view lost(k) {
        acknowledged(k, p, base), not held(p, base);
        acknowledged(k, p, base), diverged(p, base);
    }
    view post(prop, k) {
        acknowledged(k, _, _), not lost(k), let prop = "durability";
        acknowledged(k, p, base), consumed(p, base, _) @ _, let prop = "read back";
        acknowledged(k, _, _), not shared_offset(k), let prop = "unique offset";
        read_done(true) @ _, not read_twice(_), let prop = "stored once", let k = 0u64;
    }
}

/// The failure-free run.
spec SingleRun for Kafka {
    include Single;
    include Guarantees;
    faults { eot: 30, eff: 0, crashes: 0, model: sync, round: 50ms }
}

/// One broker under lost messages and one crash.
spec SingleFaults for Kafka {
    include Single;
    include Guarantees;
    faults { eot: 30, eff: 20, crashes: 1, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// One broker under a crash-restart of either node (down two rounds, back with its durable state), no lost messages.
spec SingleRestart for Kafka {
    include Single;
    include Guarantees;
    faults { eot: 30, eff: 1, crashes: 1, restart: 2, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// Three brokers and the client, which tries them in turn.
spec Triple {
    nodes B1, B2, B3, C1;
    assign Broker = [B1, B2, B3];
    assign Client = [C1];
    fact broker(B1, 1, "b1.sim", 9092);
    fact broker(B2, 2, "b2.sim", 9092);
    fact broker(B3, 3, "b3.sim", 9092);
    fact contact(0, "sim://B1/kafka") @ C1;
    fact contact(1, "sim://B2/kafka") @ C1;
    fact contact(2, "sim://B3/kafka") @ C1;
}

/// Three brokers, the topic replicated on all three: the failure-free run.
spec TripleRun for Kafka(DEFAULT_REPLICATION_FACTOR = 3) {
    include Triple;
    include Guarantees;
    faults { eot: 60, eff: 1, crashes: 0, model: sync, round: 50ms }
}

/// Three brokers under a crash-restart of any node (down 3 rounds), no lost messages: an `acks=all` batch survives.
spec TripleRestart for Kafka(DEFAULT_REPLICATION_FACTOR = 3) {
    include Triple;
    include Guarantees;
    faults { eot: 40, eff: 1, crashes: 1, restart: 3, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// SEEDED BUG (a misconfigured producer): with `acks=1` the leader answers before the followers copy the batch, so a
/// crash of the leader right after it answered loses an acknowledged batch the durability check counts on.
spec TripleRestartAcks1 for Kafka(DEFAULT_REPLICATION_FACTOR = 3, CLIENT_ACKS = 1) {
    include Triple;
    include Guarantees;
    faults { eot: 40, eff: 1, crashes: 1, restart: 3, model: sync, round: 50ms }
    check ldfi expect fails;
}

/// Three brokers under lost messages (between any nodes, until round 30), no crashes.
spec TripleOmissions for Kafka(DEFAULT_REPLICATION_FACTOR = 3) {
    include Triple;
    include Guarantees;
    faults { eot: 40, eff: 30, crashes: 0, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// Three brokers, any one lost message (between any two nodes, until round 30).
spec TripleOneLoss for Kafka(DEFAULT_REPLICATION_FACTOR = 3) {
    include Triple;
    include Guarantees;
    faults { eot: 40, eff: 30, crashes: 0, omissions: 1, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// Three brokers, any one lost message and any one crash-restart.
spec TripleLossRestart for Kafka(DEFAULT_REPLICATION_FACTOR = 3) {
    include Triple;
    include Guarantees;
    faults { eot: 40, eff: 30, crashes: 1, restart: 3, omissions: 1, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// Three brokers, two batches, under a crash-restart of any node.
spec TripleTwoRestart for Kafka(DEFAULT_REPLICATION_FACTOR = 3, CLIENT_BATCHES = 2) {
    include Triple;
    include Guarantees;
    faults { eot: 50, eff: 1, crashes: 1, restart: 3, model: sync, round: 50ms }
    check ldfi expect holds;
}

/// SEEDED BUG (a misconfigured producer): retries without idempotence. A lost answer resets the connection, the
/// client sends the batch again, and the log holds it twice.
spec TripleRetry for Kafka(DEFAULT_REPLICATION_FACTOR = 3, CLIENT_RETRY = true) {
    include Triple;
    include Guarantees;
    faults { eot: 55, eff: 40, crashes: 0, omissions: 1, model: sync, round: 50ms }
    check ldfi expect fails;
}

/// Retries with an idempotent producer: the broker keeps one copy of a retried batch.
spec TripleRetryIdempotent for Kafka(DEFAULT_REPLICATION_FACTOR = 3, CLIENT_RETRY = true, CLIENT_IDEMPOTENT = true) {
    include Triple;
    include Guarantees;
    faults { eot: 55, eff: 40, crashes: 0, omissions: 1, model: sync, round: 50ms }
    check ldfi expect holds;
}
