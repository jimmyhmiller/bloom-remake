.DS_Store
.claude/settings.local.json
.worktrees/
# Build outputs, including private per-WP target directories (PLAN §2.1).
/target*
# Repository-local tool installs (scripts/install-dev-tools.sh, scripts/install-solvers.sh).
/.tools
# Benchmark inputs fetched by `cargo run -p xtask -- fetch-datasets`.
/datasets
# cargo-fuzz outputs.
/fuzz/target
/fuzz/artifacts
/fuzz/coverage
# Python bytecode caches of the corpus tools.
__pycache__/
.tools/
# The browser host's build (scripts/build-web.sh).
/web/pkg/
/web/pkg-member/
/tests/web/node_modules/
/tests/web/test-results/
/tests/web/playwright-report/
/examples/web/.data/
