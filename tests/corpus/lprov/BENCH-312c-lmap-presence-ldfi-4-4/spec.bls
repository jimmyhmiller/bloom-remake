//! BENCH-312c spec: R11 T13, EOT 4, EFF 4, no crashes, post = key?(k) at r3.

spec PresenceLdfi44 for r#program {
    nodes CL, R1, R2, R3;
    assign Client = [CL];
    assign Replica = [R1, R2];
    assign Observer = [R3];

    fact do_put("k", 1) @ CL at tick 1;

    faults { eot: 4, eff: 4, crashes: 0, model: sync }

    view pre() = not crashed(R3);
    view post() = has_k() @ R3;

    check ldfi expect fails;
}
