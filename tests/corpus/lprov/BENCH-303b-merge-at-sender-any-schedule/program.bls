//! BENCH-303b. T4 under simulated schedules: both_eph is ultimately true in every run (the content of C6).
//!
//! R11/G1 T4: merge at the sender (D9, C6). At tick 1, a derives upd(@r; {k ↦ {1}}) and upd(@r; {k ↦ {2}}) from two
//! different rules. Both have the key () toward r, so they form one message carrying their join, {k ↦ {1,2}}
//! (SEM-105, CR-52). Because the two elements always travel together, the ephemeral test `both_eph` (both elements
//! in one delivered batch) holds under every schedule.

program merge_at_sender_t4 version 1;

role Src;
role Dst;

channel upd(u: LMap<String, LSet<i64>>): Src -> Dst;

at Src {
    input go();

    rule_one: on go(), r in Dst {
        send upd(map["k" => set[1]]) to r;
    }
    rule_two: on go(), r in Dst {
        send upd(map["k" => set[2]]) to r;
    }
}

at Dst {
    cell store: LMap<String, LSet<i64>>;
    table both_eph();

    sink: on upd(u) {
        emit store(u);
    }
    eph: on upd(u) where 1 in u.at("k"), 2 in u.at("k") {
        emit both_eph();
    }
    view has_two() = 2 in store.at("k");
}
