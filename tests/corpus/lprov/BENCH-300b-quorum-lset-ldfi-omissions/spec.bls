//! BENCH-300b spec: R11 T1 with EOT 4, EFF 2, no crashes. `pre` is R11's `pre() :- Id(c)`: the coordinator is up.

spec QuorumOmissions for r#program {
    nodes V1, V2, V3, V4, V5, C;
    assign Voter = [V1, V2, V3, V4, V5];
    assign Coord = [C];

    fact cast() @ V1 at tick 1;
    fact cast() @ V2 at tick 1;
    fact cast() @ V3 at tick 1;
    fact cast() @ V4 at tick 1;
    fact cast() @ V5 at tick 1;

    faults { eot: 4, eff: 2, crashes: 0, model: sync }

    view pre() = not crashed(C);
    view post() = decided() @ C;

    check ldfi expect fails;
}
