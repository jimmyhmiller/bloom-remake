//! BENCH-309c. T10b: the own-entry increment done in the same tick diverges: a hard error at b's tick 2.
//!
//! R11/G1 T10: vector clocks, ported to Blossom. The R11 program:
//!
//!     lat vc() : lmap<node, lmax<int>>
//!     vc(; {"a" ↦ 1}) :- ev().                               -- at a, deductively in the event's tick
//!     msg(@b; v)@async :- ev(), v = vc[].
//!     vc(; m) :- msg(; m).                                    -- at b
//!     vc(; {"b" ↦ n+1})@next :- msg(; _), n = vc[].at("b") ⊔ 0.  -- own-entry increment at the NEXT tick
//!     saw_a1() :- v = vc[], v.at("a") >= 1.
//!
//! Both nodes run the same projection of role Proc. `saw_other` is `saw_a1` from b's side, and
//! `hb_got_before_now` is the stratified antitone comparison of the received clock with the current one (strictly
//! less: happens-before).
//!
//! T10b: the own-entry increment is done deductively (`emit` instead of `next`). It then feeds itself inside the
//! tick: every round raises b's entry again, the fixpoint is undefined, and the tick aborts (the canonical C2
//! counterexample).

program vector_clocks_deductive version 1;

role Proc: cluster;

channel msg(v: VClock): Proc -> Proc;

at Proc {
    input ev();

    cell vc: VClock;

    stamp: on ev() {
        emit vc(map[self => 1]);
    }
    ship: on ev(), p in Proc where p != self {
        send msg(vc) to p;
    }
    recv: on msg(m), let bumped = map[self => vc.at(self).join(0) + 1] {
        emit vc(m);
        emit vc(bumped);
    }
}
