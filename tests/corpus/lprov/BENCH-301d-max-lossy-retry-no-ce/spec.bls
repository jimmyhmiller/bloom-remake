//! BENCH-301d spec: R11 T2 retry variant, EOT 4, EFF 3, no crashes, post = hi at the sink.

spec MaxRetryHolds for r#program {
    nodes A, B, D, S;
    assign Sender = [A, B, D];
    assign Sink = [S];

    fact x(3) @ A at tick 1;
    fact x(7) @ B at tick 1;
    fact x(7) @ D at tick 1;

    faults {
        eot: 4,
        eff: 3,
        crashes: 0,
        model: sync
    }

    view pre() = not crashed(S);
    view post() = hi() @ S;

    check ldfi expect holds;
}
