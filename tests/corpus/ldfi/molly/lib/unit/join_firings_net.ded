// The two firings of join_firings.ded made observable to LDFI (BENCH-135, provenance counts): the `hop` facts the two
// firings join with arrive from different relays, r1 and r2, so route(n, "d") survives the loss of either message and
// falls only with both. A search whose lineage keeps both firings (TEST-023) proposes the pair at once. Blossom golden
// corpus, re-derived (derived = true); see ../../README.md.

hop(N, R, Dst)@async :- announce(R, N, Dst);
hop(N, R, Dst)@next :- hop(N, R, Dst);
link(N, R, Dst)@next :- link(N, R, Dst);
route(N, Dst) :- link(N, R, Dst), hop(N, R, Dst);

pre(N, Dst) :- link(N, R, Dst);
post(N, Dst) :- route(N, Dst);

announce("r1", "n", "d")@1;
announce("r2", "n", "d")@1;
link("n", "r1", "d")@1;
link("n", "r2", "d")@1;
