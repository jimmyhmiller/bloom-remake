// The two derivations of wildcard_derivations.ded made observable to LDFI (BENCH-135, provenance counts): the two
// proxy facts arrive from different nodes, so c(loc, 1) falls only when both messages are lost. The derivations
// differ only in a column the rule writes as `_`; provenance that drops that column sees one derivation and needs an
// extra run to find the other. Blossom golden corpus, derived (derived = true); see ../../README.md.

proxy(L, A, B)@async :- a(S, L, A, B);
proxy(L, A, B)@next :- proxy(L, A, B);
b(L, V)@next :- b(L, V);
c(L, V) :- b(L, V), proxy(L, _, V);

pre(L, V) :- b(L, V);
post(L, V) :- c(L, V);

a("px", "loc", "x", 1)@1;
a("py", "loc", "y", 1)@1;
b("loc", 1)@1;
