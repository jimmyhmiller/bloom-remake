// The two derivations of wildcard_derivations.ded made observable to LDFI (BENCH-135, provenance counts): the two
// `stock` facts arrive from different shelves' nodes, so available(n, "pen") falls only when both messages are lost.
// The derivations differ only in a column the rule writes as `_`; provenance that drops that column sees one
// derivation and needs an extra run to find the other. Blossom golden corpus, re-derived (derived = true); see
// ../../README.md.

stock(N, Shelf, Item)@async :- report(Shelf, N, Item);
stock(N, Shelf, Item)@next :- stock(N, Shelf, Item);
wanted(N, Item)@next :- wanted(N, Item);
available(N, Item) :- wanted(N, Item), stock(N, _, Item);

pre(N, Item) :- wanted(N, Item);
post(N, Item) :- available(N, Item);

report("s1", "n", "pen")@1;
report("s2", "n", "pen")@1;
wanted("n", "pen")@1;
