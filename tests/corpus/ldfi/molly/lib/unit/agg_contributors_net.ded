// The contributors of agg_contributors.ded made observable to LDFI (BENCH-135, provenance counts): each reading
// arrives from its own probe node, and an aggregate depends on every contributor (TEST-024, Molly's conjunctive
// encoding), so losing any one of the three messages behind tally(k, "x", 3) falsifies it, and only the one message
// behind tally(k, "y", 1) falsifies that. Blossom golden corpus, re-derived (derived = true); see ../../README.md.

reading(K, Sensor, V)@async :- probe(P, K, Sensor, V);
reading(K, Sensor, V)@next :- reading(K, Sensor, V);
quota(K, Sensor, N)@next :- quota(K, Sensor, N);
seen(K, Sensor, V) :- reading(K, Sensor, V);
tally(K, Sensor, count<V>) :- seen(K, Sensor, V);

pre(K, Sensor) :- quota(K, Sensor, N);
post(K, Sensor) :- tally(K, Sensor, N), quota(K, Sensor, N);

quota("k", "x", 3)@1;
quota("k", "y", 1)@1;
probe("p1", "k", "x", 5)@1;
probe("p2", "k", "x", 6)@1;
probe("p3", "k", "x", 7)@1;
probe("p4", "k", "y", 9)@1;
