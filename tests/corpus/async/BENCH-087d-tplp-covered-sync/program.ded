// BENCH-087: TPLP Figure 1 (reachability "covered") in Molly's Dedalus dialect; the `.ded` twin of BENCH-087a. The
// first column of every relation is its node. TPLP's `covered() ← ¬missing()` has no positive body atom; as CRON
// does for its Figure 3, the rule reads Id to bind the location.

marked(Y, U)@async :- start(X, U), node(X, Y);
marked(X, U)@next :- marked(X, U);
marked(X, V) :- marked(X, U), r(X, U, V);
vert(X, U) :- r(X, U, V);
vert(X, U) :- r(X, V, U);
missing(X) :- vert(X, U), notin marked(X, U);
covered(X) :- id(X), notin missing(X);

// The input holds at every step (TPLP §4.3.2); Molly facts hold only at their tick, so it is persisted by hand.
r(X, U, V)@next :- r(X, U, V);
start(X, U)@next :- start(X, U);
node(X, Y)@next :- node(X, Y);
id(X)@next :- id(X);

id("x")@1;
id("y")@1;
id("z")@1;
id("w")@1;
node("x", "x")@1;
node("x", "y")@1;
node("x", "z")@1;
node("x", "w")@1;
node("y", "x")@1;
node("y", "y")@1;
node("y", "z")@1;
node("y", "w")@1;
node("z", "x")@1;
node("z", "y")@1;
node("z", "z")@1;
node("z", "w")@1;
node("w", "x")@1;
node("w", "y")@1;
node("w", "z")@1;
node("w", "w")@1;
r("x", "a", "b")@1;
r("y", "a", "c")@1;
r("y", "c", "d")@1;
r("z", "e", "f")@1;
r("w", "f", "g")@1;
start("x", "a")@1;
start("z", "e")@1;
