//! BENCH-085: "concurrent arrival" (Marczak et al., Datalog 2.0 2012, Appendix F, Example 11), ported rule by rule.
//!
//!     p(#L, X)@async ← q(#L, X), ¬r(#L, X).
//!     r(X)@next ← q(X).
//!     r(X)@next ← r(X).
//!     concurrent() ← p(n1, c1), p(n1, c2).
//!     concurrent()@next ← concurrent().
//!
//! `r` holds from tick 1 on, so both elements of `q` are sent exactly once, in tick 0. `concurrent` is derived, and
//! then persists, if and only if the two messages arrive in the same tick: diffluent.

program concurrent_arrival version 1;

/// MAR's EDB: q(n1, c1) and q(n1, c2).
static q(x: String);
fact q("c1");
fact q("c2");

/// The asynchronous head `p(#L, X)@async`, addressed to the same node. It is not persisted.
loopback p(x: String);
/// r(X)@next ← q(X). r(X)@next ← r(X).
table r(x: String);
/// MAR's output, persisted by `concurrent()@next ← concurrent()`.
output concurrent();

send_once: while q(x), not r(x) {
    send p(x);
}

remember: while q(x) {
    next r(x);
}

both: on p("c1"), p("c2") {
    emit concurrent();
}

/// `concurrent` is written only by event-driven statements, this one included, so it is an event relation
/// (LANGUAGE §8.5, the greatest fixpoint) and the loop that carries it to the next tick is an `on`
/// handler, although `concurrent` then holds in every later tick.
keep: on concurrent() {
    next concurrent();
}
