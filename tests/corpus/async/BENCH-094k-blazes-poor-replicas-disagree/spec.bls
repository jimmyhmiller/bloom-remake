//! BENCH-094: POOR's reporting servers disagree without coordination (R05 T14: "The runtime shows replicas
//! disagreeing without coordination"; Blazes §5.2.2 and §8.2: "The uncoordinated baseline produced observably
//! inconsistent answers across replicas").
//!
//! One ad server logs 100 clicks for ad 7; an analyst asks whether ad 7 is a poor performer (fewer than 100 clicks).
//! The cache forwards the question to both reporting servers. A server that answers before all 100 clicks reach it
//! (with at least one click) reports ad 7 as poor; a server that has all 100, or none, does not answer. Blazes labels
//! the reporting servers' output Inst: some schedule makes the two replicas answer the same question differently.

spec PoorReplicasDisagree for r#program {
    nodes A1, R1, R2, C1, N1;
    assign AdServer = [A1];
    assign Reporter = [R1, R2];
    assign CacheServer = [C1];
    assign Analyst = [N1];

    fact clicked(1, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(2, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(3, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(4, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(5, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(6, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(7, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(8, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(9, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(10, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(11, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(12, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(13, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(14, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(15, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(16, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(17, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(18, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(19, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(20, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(21, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(22, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(23, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(24, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(25, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(26, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(27, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(28, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(29, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(30, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(31, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(32, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(33, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(34, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(35, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(36, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(37, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(38, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(39, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(40, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(41, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(42, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(43, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(44, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(45, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(46, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(47, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(48, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(49, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(50, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(51, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(52, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(53, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(54, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(55, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(56, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(57, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(58, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(59, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(60, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(61, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(62, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(63, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(64, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(65, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(66, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(67, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(68, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(69, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(70, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(71, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(72, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(73, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(74, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(75, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(76, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(77, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(78, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(79, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(80, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(81, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(82, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(83, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(84, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(85, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(86, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(87, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(88, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(89, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(90, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(91, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(92, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(93, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(94, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(95, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(96, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(97, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(98, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(99, 7, "spring", 1) @ A1 at tick 1;
    fact clicked(100, 7, "spring", 1) @ A1 at tick 1;
    fact question(1, 7) @ N1 at tick 1;

    faults {
        crashes: 0,
        model: async,
        delay: 4
    }

    /// Both servers received the question; one answered it and the other did not (a server answers in the tick the
    /// question arrives, or never).
    invariant reporters_agree: never sent found(q, id) @ _ from a, ever lookup(q, id) @ b,
            not sent found(q, id) @ _ from b;

    check sim {
        runs: 1000,
        seed: 1
    } expect fails;
}
