//! BENCH-094: the Storm wordcount of Blazes (Alvaro, Conway, Hellerstein, Maier, ICDE 2014, §1.3 and §5.1), with no
//! seal on its input stream.
//!
//! "Each tweet is associated with a numbered batch (the unit of replay) and is sent to exactly one Splitter component
//! via random partitioning. The Splitter component divides tweets into their constituent words. These are hash
//! partitioned to the Count component, which tallies the number of occurrences of each word in the current batch.
//! When a batch ends, the Commit component records the batch number and frequency for each word in the batch in a
//! backing store." The three Blazes components are the module instances `split`, `count` and `commit`; the channels
//! between the roles are the streams, and the glue handlers only move tuples between a channel and an interface.

program storm_wordcount version 1;

role Spout: cluster;
role Splitter: cluster;
role Counter: cluster;
role Committer;

/// The tweet stream, one tweet to one splitter.
channel tweet(batch: u64, id: u64, text: String): Spout -> Splitter partition by id;
/// The word stream, hash-partitioned on the word.
channel word(batch: u64, word: String, id: u64, pos: u64): Splitter -> Counter partition by word;
/// The counts, to the committer.
channel tally(batch: u64, word: String, n: u64): Counter -> Committer;

fn words_of(text: String) -> Vec<String> {
    text.split_whitespace().map(|w| w.to_lowercase())
}

/// Splitter: tokenizes each tweet. Stateless and order-insensitive (Blazes: CR).
module Split {
    input tweets(batch: u64, id: u64, text: String);
    output words(batch: u64, word: String, id: u64, pos: u64);

    tokenize: on tweets(b, id, text), (p, w) in words_of(text).enumerate() {
        emit words(b, w, id, p);
    }
}

/// Count: the occurrences of each word in each batch. Stateful and order-sensitive, partitioned on word and batch
/// (Blazes: OW_word,batch).
module Count {
    input words(batch: u64, word: String, id: u64, pos: u64);
    output counts(batch: u64, word: String, n: u64);

    table seen(batch: u64, word: String, id: u64, pos: u64);

    keep: on words(b, w, id, p) {
        emit seen(b, w, id, p);
    }

    count_words: while seen(b, w, id, p) {
        emit counts(b, w, count!(*));
    }
}

/// Commit: appends every (batch, word, count) it receives to the backing store; the store records no order
/// (Blazes: CW).
module Commit {
    input counts(batch: u64, word: String, n: u64);
    output db(batch: u64, word: String, n: u64);

    table store(batch: u64, word: String, n: u64);

    append: on counts(b, w, n) {
        emit store(b, w, n);
    }

    read_back: while store(b, w, n) {
        emit db(b, w, n);
    }
}

at Spout {
    /// From the host: the tweets of each batch.
    input tweet_in(batch: u64, id: u64, text: String);

    emit_tweet: on tweet_in(b, id, text) {
        send tweet(b, id, text);
    }
}

at Splitter {
    import Split as split;

    take_tweet: on tweet(b, id, text) {
        emit split.tweets(b, id, text);
    }

    give_words: on split.words(b, w, id, p) {
        send word(b, w, id, p);
    }
}

at Counter {
    import Count as count;

    take_word: on word(b, w, id, p) {
        emit count.words(b, w, id, p);
    }

    give_counts: while count.counts(b, w, n), c in Committer {
        send tally(b, w, n) to c;
    }
}

at Committer {
    import Commit as commit;

    /// The backing store's contents: the sink of the dataflow.
    output committed(batch: u64, word: String, n: u64);

    take_tally: on tally(b, w, n) {
        emit commit.counts(b, w, n);
    }

    expose: while commit.db(b, w, n) {
        emit committed(b, w, n);
    }
}
