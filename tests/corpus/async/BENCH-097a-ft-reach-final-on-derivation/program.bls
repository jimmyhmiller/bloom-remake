//! BENCH-097 (a): free termination of a monotone reachability query (R13 §12 T5; Power, Koutris, Hellerstein, "The
//! Free Termination Property of Queries Over Time", ICDT 2025, Prop. 13 and Thm. 25).
//!
//!     P(x, y) :- Edge(x, y).      P(x, y) :- P(x, z), Edge(z, y).      reach() :- P(s, t).
//!
//! Edges arrive over a channel into a persisted table, which only grows. reach() is monotone in that table, so it
//! is final the moment it holds; so is every tuple of P. The source may seal the edge stream when it has sent its
//! last edge; the graph node then seals its table (R13's "seal Edge").

program ft_reachability version 1;

/// The node that sends the edges, and the node that holds the graph.
static edge_source(n: Node);
static graph_holder(g: Node);
fact edge_source("SRC");
fact graph_holder("G");

/// At the source, from the host: edges to send, and the end of the edge stream.
input add_edge(a: String, b: String);
input end_of_edges();

/// The edge stream, punctuated as a whole by its producers.
channel edge_msg(a: String, b: String) sealed by () producers edge_source;

/// At the graph node: every edge received. It only grows until it is sealed.
table edge(a: String, b: String) sealed by ();

output reach();
output reach_final();
output reach_final_false();
output p_final(x: String, y: String);

ship: on add_edge(a, b), graph_holder(g) {
    send edge_msg(a, b) to g;
}

close_stream: on end_of_edges(), graph_holder(g) {
    seal edge_msg() to g;
}

store: on edge_msg(a, b) {
    emit edge(a, b);
}

/// Once every producer has sealed the stream and every edge it sent has arrived, no edge will ever be added.
close_table: while sealed edge_msg() {
    seal edge();
}

view p(x, y) {
    edge(x, y);
    p(x, z), edge(z, y);
}

answer: while p("s", "t") {
    emit reach();
}

/// The runtime finality status (LANGUAGE §14.5), made observable.
reach_is_final: while final reach() {
    emit reach_final();
}

reach_is_final_false: while final not reach() {
    emit reach_final_false();
}

tuple_is_final: while final p(x, y) {
    emit p_final(x, y);
}
