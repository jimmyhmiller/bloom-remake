//! BENCH-099: batch completion by seals and thresholds (FLAG-141; R13 §12 T16 and §9.6, "Batch stage").
//!
//! A word-count stage over four input splits, written as LANGUAGE's E6 writes it: mappers shuffle one tuple per word
//! occurrence to the reducer that owns the word, and each split source seals its split after its last record. At the
//! reducer:
//! - `hot(w)`, a threshold (n >= 1000) over a growing set of occurrences, is final the moment it holds, before any
//!   seal (THRESH-final);
//! - `word_count(w, n)` and `total_distinct(k)` (count<w>) are exact aggregates: provisional until every split has
//!   been sealed by its mapper, then final (SEALED-final);
//! - `stage_complete()` reports that every split is sealed, which is exactly when those outputs become final.
//! Both sides keep only the splits of the static job plan, so the four split seals close the reducer's state.
//! The `*_final` outputs make the runtime finality status (LANGUAGE §14.5) observable.

program batch_completion version 1;

const HOT: u64 = 1000;

role Mapper: cluster;
role Reducer: cluster;

/// The job plan: which mapper reads each of the four input splits.
static split_of(split: u32, mapper: Node<Mapper>) key(split);
fact split_of(1, "M1");
fact split_of(2, "M2");
fact split_of(3, "M3");
fact split_of(4, "M4");

fn words(text: String) -> Vec<String> {
    text.split_whitespace().map(|w| w.to_lowercase())
}

/// One tuple per word occurrence; (split, line, pos) keeps occurrences apart under set semantics. The channel routes
/// each word to the reducer that owns it and carries per-split seals whose count digests the compiler maintains.
channel occ(word: String, split: u32, line: u64, pos: u64): Mapper -> Reducer partition by word sealed by(split);

at Mapper {
    /// A split's records, from the host.
    input line(split: u32, lineno: u64, text: String);
    /// The host marks the end of a split once it has been read completely.
    input split_end(split: u32);

    map: on line(s, l, text), split_of(s, self), (p, w) in words(text).enumerate() {
        send occ(w, s, l, p);
    }

    /// The split source's whole-split seal after its last record, toward every reducer.
    punctuate: on split_end(s), split_of(s, self) {
        seal occ(split: s);
    }
}

at Reducer {
    table seen(word: String, split: u32, line: u64, pos: u64);
    table occs(word: String, ids: LSet<(u32, u64, u64)>);

    /// Early answers that need no seal: a threshold over a growing set (THRESH-final).
    final output hot(word: String);
    /// Exact answers, final once every split's mapper has sealed it (SEALED-final).
    final output word_count(word: String, n: u64) key(word);
    final output total_distinct(k: u64) key();
    output stage_complete();

    output hot_final(word: String);
    output not_hot_final(word: String);
    output word_count_final(word: String, n: u64);
    output total_distinct_final(k: u64);

    /// Only occurrences of planned splits are kept, so the reducer's state ranges over the static domain of
    /// `split_of`, and it is closed once each of those splits is sealed (FT §5.2's All()).
    keep: on occ(w, s, l, p), split_of(s, _) {
        emit seen(w, s, l, p);
        emit occs(w, set[(s, l, p)]);
    }

    early: while occs(w, ids) where ids.size() >= HOT {
        emit hot(w);
    }

    count_words: while seen(w, s, l, p) {
        emit word_count(w, count!(*));
    }

    count_distinct: while seen(w, _, _, _) {
        emit total_distinct(count!(w));
    }

    /// A split is complete here when its mapper's seal has arrived and the digest matches what arrived.
    view split_done(s) = split_of(s, m), sealed occ(split: s) from m;
    /// A universal over a static domain, so it is monotone: once every split is done, it stays done.
    view all_done() = forall split_of(s, _) { split_done(s) };

    complete: while all_done() {
        emit stage_complete();
    }

    hot_is_final: while final hot(w) {
        emit hot_final(w);
    }
    not_hot_is_final: while seen(w, _, _, _), final not hot(w) {
        emit not_hot_final(w);
    }
    count_is_final: while final word_count(w, n) {
        emit word_count_final(w, n);
    }
    total_is_final: while final total_distinct(k) {
        emit total_distinct_final(k);
    }
}
