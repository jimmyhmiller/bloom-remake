//! BENCH-095: Edelweiss DR+ basics, ported from bud-gc's tc_gc.rb (R05 T26, §5.5).
//!
//! BENCH-095 (R05 T26; §5.5): bud-gc's positive-difference reclamation (DR+, ANA-062) unit tests.
//!
//! R05 §5.5: for X.notin(Y) with X and Y persistent, "any X tuple that has a match in Y will never appear in the output of
//! the notin again"; reclaim it if no other use of X can observe the deletion. "Across rules: AND. Within a chained
//! negation: OR." R05 §9.4 item 26: "RseSimple: reclaim [5,10] after res_approx gets it; sbuf = [[6,12]]. RseQual: after
//! sbuf_val_seen <+ [[5]], sbuf = {[3,6]}. RseChainedNeg and RseNegateIntersect: the AND/OR semantics.
//! RseNegateIntersectDelete: no reclamation when one negated input is user-deleted. RseDeleteDownstream: reclamation
//! allowed." Storage rows are the contents of the Edelweiss-rewritten program; output rows hold with and without it.

program edelweiss_rse_basics version 1;

// ---------------- RseSimple, test_rse_simple
// `res <= sbuf.notin(res_approx)`: once res_approx has a buffered message, the message is reclaimed from sbuf (DR+).

table simple_sbuf(id: u64, val: u64) key(id);

input simple_sbuf_in(id: u64, val: u64);

simple_sbuf_load: on simple_sbuf_in(id, val) {
    emit simple_sbuf(id, val);
}

table simple_res_approx(id: u64, val: u64) key(id);

input simple_res_approx_in(id: u64, val: u64);

simple_res_approx_load: on simple_res_approx_in(id, val) {
    emit simple_res_approx(id, val);
}

output simple_res(id: u64, val: u64);

simple_notin: while simple_sbuf(i, v), not simple_res_approx(i, v) {
    emit simple_res(i, v);
}

// ---------------- RseQual, test_rse_qual
// `res <= sbuf.notin(sbuf_val_seen, :val => :val)`: a qualified negation reclaims every sbuf tuple whose val is seen.

table qual_sbuf(id: u64, val: u64) key(id);

input qual_sbuf_in(id: u64, val: u64);

qual_sbuf_load: on qual_sbuf_in(id, val) {
    emit qual_sbuf(id, val);
}

table qual_val_seen(val: u64);

input qual_val_seen_in(val: u64);

qual_val_seen_load: on qual_val_seen_in(val) {
    emit qual_val_seen(val);
}

output qual_res(id: u64, val: u64);

qual_notin: while qual_sbuf(i, v), not qual_val_seen(v) {
    emit qual_res(i, v);
}

// ---------------- RseChainedNeg, test_rse_chained_neg
// `t0 <= t2.notin(t3).notin(t4).notin(t5)` and `t1 <= t2.notin(t6)`: a t2 tuple is reclaimed when it is in t6 AND (in t3
// OR t4 OR t5): conditions from different rules combine with AND, within a chained negation with OR.

table chain_t0(key: u64, val: u64) key(key);

table chain_t1(key: u64, val: u64) key(key);

table chain_t2(key: u64, val: u64) key(key);

input chain_t2_in(key: u64, val: u64);

chain_t2_load: on chain_t2_in(key, val) {
    emit chain_t2(key, val);
}

table chain_t3(key: u64, val: u64) key(key);

input chain_t3_in(key: u64, val: u64);

chain_t3_load: on chain_t3_in(key, val) {
    emit chain_t3(key, val);
}

table chain_t4(key: u64, val: u64) key(key);

input chain_t4_in(key: u64, val: u64);

chain_t4_load: on chain_t4_in(key, val) {
    emit chain_t4(key, val);
}

table chain_t5(key: u64, val: u64) key(key);

input chain_t5_in(key: u64, val: u64);

chain_t5_load: on chain_t5_in(key, val) {
    emit chain_t5(key, val);
}

table chain_t6(key: u64, val: u64) key(key);

input chain_t6_in(key: u64, val: u64);

chain_t6_load: on chain_t6_in(key, val) {
    emit chain_t6(key, val);
}

chain_to_t0: while chain_t2(k, v), not chain_t3(k, v), not chain_t4(k, v), not chain_t5(k, v) {
    emit chain_t0(k, v);
}

chain_to_t1: while chain_t2(k, v), not chain_t6(k, v) {
    emit chain_t1(k, v);
}

// ---------------- RseNegateIntersect, test_rse_negate_intersect
// Four rules negate t2 against t3, t4, t5 and t6: a t2 tuple is reclaimed only once it appears in all four.

table isect_res1(key: u64, val: u64) key(key);

table isect_res2(key: u64, val: u64) key(key);

table isect_res3(key: u64, val: u64) key(key);

table isect_res4(key: u64, val: u64) key(key);

table isect_t2(key: u64, val: u64) key(key);

input isect_t2_in(key: u64, val: u64);

isect_t2_load: on isect_t2_in(key, val) {
    emit isect_t2(key, val);
}

table isect_t3(key: u64, val: u64) key(key);

input isect_t3_in(key: u64, val: u64);

isect_t3_load: on isect_t3_in(key, val) {
    emit isect_t3(key, val);
}

table isect_t4(key: u64, val: u64) key(key);

input isect_t4_in(key: u64, val: u64);

isect_t4_load: on isect_t4_in(key, val) {
    emit isect_t4(key, val);
}

table isect_t5(key: u64, val: u64) key(key);

input isect_t5_in(key: u64, val: u64);

isect_t5_load: on isect_t5_in(key, val) {
    emit isect_t5(key, val);
}

table isect_t6(key: u64, val: u64) key(key);

input isect_t6_in(key: u64, val: u64);

isect_t6_load: on isect_t6_in(key, val) {
    emit isect_t6(key, val);
}

isect_to_res1: while isect_t2(k, v), not isect_t3(k, v) {
    emit isect_res1(k, v);
}

isect_to_res2: while isect_t2(k, v), not isect_t4(k, v) {
    emit isect_res2(k, v);
}

isect_to_res3: while isect_t2(k, v), not isect_t5(k, v) {
    emit isect_res3(k, v);
}

isect_to_res4: while isect_t2(k, v), not isect_t6(k, v) {
    emit isect_res4(k, v);
}

// ---------------- RseNegateIntersectDelete, test_rse_negate_intersect_del
// As above with three negations, but t5 is the target of a user deletion (`t5 <- some_event`), so it is not
// inflationary: t2 is never reclaimed ("If there is any rule that means we can't reclaim from a relation, we can't reclaim
// from that relation for other rules either").

table isdel_res1(key: u64, val: u64) key(key);

table isdel_res2(key: u64, val: u64) key(key);

table isdel_res3(key: u64, val: u64) key(key);

table isdel_t2(key: u64, val: u64) key(key);

input isdel_t2_in(key: u64, val: u64);

isdel_t2_load: on isdel_t2_in(key, val) {
    emit isdel_t2(key, val);
}

table isdel_t3(key: u64, val: u64) key(key);

input isdel_t3_in(key: u64, val: u64);

isdel_t3_load: on isdel_t3_in(key, val) {
    emit isdel_t3(key, val);
}

table isdel_t4(key: u64, val: u64) key(key);

input isdel_t4_in(key: u64, val: u64);

isdel_t4_load: on isdel_t4_in(key, val) {
    emit isdel_t4(key, val);
}

table isdel_t5(key: u64, val: u64) key(key);

input isdel_t5_in(key: u64, val: u64);

isdel_t5_load: on isdel_t5_in(key, val) {
    emit isdel_t5(key, val);
}

isdel_to_res1: while isdel_t2(k, v), not isdel_t3(k, v) {
    emit isdel_res1(k, v);
}

isdel_to_res2: while isdel_t2(k, v), not isdel_t4(k, v) {
    emit isdel_res2(k, v);
}

isdel_to_res3: while isdel_t2(k, v), not isdel_t5(k, v) {
    emit isdel_res3(k, v);
}

input isdel_some_event(key: u64, val: u64);

isdel_forget: on isdel_some_event(k, v) {
    delete isdel_t5(k, v);
}

// ---------------- RseDeleteDownstream, test_rse_delete_downstream
// `t1 <= t2.notin(t3)` with `t1 <- some_event`: the target of the negation rule may be deleted from; t2 is still reclaimed.

table down_t1(key: u64, val: u64) key(key);

table down_t2(key: u64, val: u64) key(key);

input down_t2_in(key: u64, val: u64);

down_t2_load: on down_t2_in(key, val) {
    emit down_t2(key, val);
}

table down_t3(key: u64, val: u64) key(key);

input down_t3_in(key: u64, val: u64);

down_t3_load: on down_t3_in(key, val) {
    emit down_t3(key, val);
}

down_notin: while down_t2(k, v), not down_t3(k, v) {
    emit down_t1(k, v);
}

input down_some_event(key: u64, val: u64);

down_forget: on down_some_event(k, v) {
    delete down_t1(k, v);
}
