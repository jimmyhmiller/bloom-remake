//! BENCH-098: finality soundness under fuzzing, over BENCH-097 (f) (R13 §12 T10 and T15; TEST-088).
//!
//! Five voters each send one vote for election 1 to two counters, followed by their seal on the election. At each
//! counter the exact tally is a non-monotone aggregate that becomes final only when every voter's seal has arrived
//! with a matching digest (SEALED-final); "at least 3 votes" is a threshold over a growing set, final as soon as it
//! holds (THRESH-final). Both outputs are declared `final output`, so their rows carry the runtime's finality marks.

program ft_soundness_tally version 1;

static voter(v: Node);
static counter(c: Node);
fact voter("V1");
fact voter("V2");
fact voter("V3");
fact voter("V4");
fact voter("V5");
fact counter("C1");
fact counter("C2");

/// At a voter, from the host: its vote.
input cast(e: u64, choice: String);

/// One vote per voter per election; each voter seals the election at each counter once it has voted there.
channel vote(e: u64, choice: String) sealed by (e) producers voter;

/// At a counter: every vote received, with its voter.
table votes(e: u64, voter: Node, choice: String);

final output tally(e: u64, n: u64) key(e);
final output at_least_three(e: u64);
output tally_final(e: u64, n: u64);
output three_final(e: u64);

send_vote: on cast(e, choice), counter(c) {
    send vote(e, choice) to c;
    seal vote(e: e) to c;
}

record: on vote(e, choice) from v {
    emit votes(e, v, choice);
}

count_votes: while votes(e, v, _) {
    emit tally(e, count!(v));
}

three: while votes(e, _, _) where lset{ v | votes(e, v, _) }.size() >= 3 {
    emit at_least_three(e);
}

tally_is_final: while final tally(e, n) {
    emit tally_final(e, n);
}

three_is_final: while final at_least_three(e) {
    emit three_final(e);
}
