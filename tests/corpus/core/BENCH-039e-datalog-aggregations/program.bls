//! BENCH-039: dfir-datalog frontend aggregation tests (dfir_datalog_core lib.rs; R08 §15 T8):
//!
//!     test_max:                        result(max(a), b) :- ints(a, b)
//!     test_max_all:                    result(max(a), max(b)) :- ints(a, b)
//!     test_aggregations_and_comments:  # david doesn't think this line of code will execute
//!                                      result(count(a), b) :- ints(a, b)
//!                                      result(sum(a), b) :+ ints(a, b)
//!                                      result2(choose(a), b) :- ints(a, b)
//!     test_aggregations_fold_keyed_expr: result(a % 2, sum(b)) :- ints(a, b)
//!
//! `:+` is dfir-datalog's next-tick rule (`next`). `choose` is Blossom's seeded choice; its validity is checked by
//! the invariants below. The `#` line comment of the original test is kept (LANG-208).
# david doesn't think this line of code will execute

program datalog_aggregations version 1;

input ints(a: u64, b: u64);

output max_per_b(m: u64, b: u64);
output max_all(ma: u64, mb: u64);
output result(n: u64, b: u64);
output result2(a: u64, b: u64);
output by_parity(p: u64, s: u64);

view chosen(a, b) = ints(a, b), choose!(a per b);

test_max: on ints(a, b) {
    emit max_per_b(max!(a), b);
}

test_max_all: on ints(a, b) {
    emit max_all(max!(a), max!(b));
}

count_now: on ints(a, b) {
    emit result(count!(a), b);
}

sum_next: on ints(a, b) {
    next result(sum!(a), b);
}

choose_one: on chosen(a, b) {
    emit result2(a, b);
}

parity: on ints(a, b) {
    emit by_parity(a % 2, sum!(b));
}

invariant choice_is_candidate "result2 chose a value that is not a candidate": never result2(a, b), not ints(a, b);
invariant one_choice_per_group "result2 chose two values for one group":
    never result2(a1, b), result2(a2, b) where a1 != a2;
invariant choice_is_total "a group with candidates has no choice": never ints(_, b), not result2(_, b);
