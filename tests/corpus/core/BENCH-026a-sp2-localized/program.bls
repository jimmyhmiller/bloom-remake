//! BENCH-026: SP2 with a multi-location body, localized by the compiler (LANG-095, `#[localize(link)]`).
//!
//! SIGMOD06's shortest-path program over its Fig. 2 network, with SP2 written as in the paper: the body joins
//! `#link` at S with `path` at the link's other end Z (R01 §5.6). The attribute asks for NDlog's link-restricted
//! localization (SIGMOD06 Algorithm 2). BENCH-026b is the same program localized by hand; in a quiescent network
//! both must give the same result, which is also BENCH-022's.

program sp2_localized version 1;

role Router: cluster;

static link(src: Node<Router>, dst: Node<Router>, cost: u64);

fact link("e", "a", 1);
fact link("a", "b", 5);
fact link("a", "c", 1);
fact link("c", "b", 1);
fact link("b", "d", 1);

at Router {
    table path(dst: Node<Router>, nxt: Node<Router>, p: Vec<Node<Router>>, cost: u64);

    view sp_cost(d, c = min!(x)) = path(d, _, _, x);
    view shortest_path(d, p, c) = sp_cost(d, c), path(d, _, p, c);

    sp1: while link(self, d, c) {
        emit path(d, d, [self, d], c);
    }

    #[localize(link)]
    sp2: while link(self, z, c1), path(d, _, p2, c2) @ z {
        emit path(d, z, [self] ++ p2, c1 + c2);
    }
}
