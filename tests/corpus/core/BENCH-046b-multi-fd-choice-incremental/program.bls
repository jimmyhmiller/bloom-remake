//! BENCH-046: incremental multi-FD choice (R12 §12 T7): adding (3,c) at a later tick must recompute only its own
//! conflict component, so the existing matching is unchanged and (3,c) joins it.

program multi_fd_choice_incremental version 1;

input add_edge(x: u64, y: String);

table g(x: u64, y: String);

scratch matching_prev(x: u64, y: String);

view matching(x, y) = g(x, y), choose!(y per x), choose!(x per y);
view matched_x(x) = matching(x, _);
view matched_y(y) = matching(_, y);

load: on add_edge(x, y) {
    emit g(x, y);
}

remember: while matching(x, y) {
    next matching_prev(x, y);
}

invariant is_edge "matching chose a non-edge": never matching(x, y), not g(x, y);
invariant fd_x "x is matched twice": never matching(x, y1), matching(x, y2) where y1 != y2;
invariant fd_y "y is matched twice": never matching(x1, y), matching(x2, y) where x1 != x2;
invariant maximal "an edge with two unmatched ends could be added": never g(x, y), not matched_x(x), not matched_y(y);
/// No edge is ever removed, and the new edge is in its own conflict component, so no earlier match may change.
invariant component_stable "adding an unrelated edge changed an earlier match": never matching_prev(x, y),
        not matching(x, y);
