// BENCH-001 (DL11 Ex. 3) in Molly's Dedalus dialect: the `.ded` twin of BENCH-001a.
//
// Example 3 of "Dedalus: Datalog in Time and Space" (DL11), quoted in R02 §3.3. Molly makes the first column of
// every relation its location, so each relation gains a leading location column; everything runs at node "n1".
// `p_pos(...)@next :- p_pos(...), notin p_neg(...)` is explicit persistence (LANG-065).

p_pos(N, A, B) :- p(N, A, B);
p_pos(N, A, B)@next :- p_pos(N, A, B), notin p_neg(N, A, B);

p("n1", 1, 2)@101;
p("n1", 1, 3)@102;
p_neg("n1", 1, 2)@300;
