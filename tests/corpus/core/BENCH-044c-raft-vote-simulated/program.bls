//! BENCH-044: Raft vote among same-tick RequestVotes (R12 §12 T5), for FLAG-002, FLAG-006 and FLAG-007.
//!
//! The voter rules of R07 §11.3 (the structure of examples/e03_raft_election.bls): the tick's effective term is the
//! largest term known; a candidate is up to date if its last log term is greater, or equal with a last index at
//! least ours; at most one *new* vote per term per tick, chosen among the up-to-date candidates; a candidate that
//! already holds the term's vote is granted again (retransmission); every other request is refused with our
//! term. `voted_for` is durable, so the vote is on disk before the reply leaves (SEM-072) and survives a crash.
//! This variant writes the grant as R12's (b), `grant(N, T, choose<C>)`: the seeded choice among the up-to-date
//! requests.
//!
//! Every server runs this program; the host drives the candidates (`campaign`) and loads the voter's initial state
//! (`init_state`). A request carries the candidate's id, which orders the candidates for the `min` variant.
//! `granted_ever` records every grant durably; the invariant is R12's "at most one grantee per term, across all
//! ticks and restarts".

program raft_same_tick_vote version 1;

role Server: cluster;

channel request_vote(term: u64, cand_id: u64, last_idx: u64, last_term: u64): Server -> Server;
channel vote(term: u64, granted: bool): Server -> Server;

at Server {
    input init_state(term: u64, last_idx: u64, last_term: u64);
    input campaign(dst: Node<Server>, term: u64, cand_id: u64, last_idx: u64, last_term: u64);

    durable table current_term(t: u64) key() resolve choose_most(t);
    durable table voted_for(term: u64, cand: Node<Server>) key(term);
    durable table log(idx: u64, term: u64) key(idx);
    durable table granted_ever(term: u64, cand: Node<Server>);
    table replies(term: u64, granted: bool);

    load_state: on init_state(t, i, lt) {
        emit current_term(t);
        emit log(i, lt);
    }

    view heard_term(t) = request_vote(term: t, ..);
    view eff(t = max!(x)) {
        current_term(x);
        heard_term(x);
    }
    persist_term: while eff(t) {
        next current_term(t);
    }

    view last_log(i, t) {
        log(i, t), argmax!(i);
        not log(_, _), let i = 0, let t = 0;
    }

    view rv_ok(c, t, id) =
        request_vote(t, id, li, lt) from c, eff(t), last_log(mi, mt)
        where lt > mt || (lt == mt && li >= mi);

    /// (b) choose<C>: the seeded choice among the up-to-date candidates of the term.
    view fresh_grant(c, t) = rv_ok(c, t, _), not voted_for(t, _), choose!(c per t);

    view grant(c, t) {
        fresh_grant(c, t);
        rv_ok(c, t, _), voted_for(t, c);
    }

    grant_vote: on grant(c, t) {
        next voted_for(t, c);
        next granted_ever(t, c);
        send vote(t, true) to c;
    }

    refuse_vote: on request_vote(t, _, _, _) from c, eff(e), not grant(c, t) {
        send vote(e, false) to c;
    }

    send_request: on campaign(dst, t, id, li, lt) {
        send request_vote(t, id, li, lt) to dst;
    }

    count_reply: on vote(t, g) {
        emit replies(t, g);
    }

    invariant one_grantee "two candidates were granted a vote in one term":
        never granted_ever(t, a), granted_ever(t, b) where a != b;
}
