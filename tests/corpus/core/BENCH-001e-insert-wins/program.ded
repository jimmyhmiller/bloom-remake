// BENCH-001 scenario b (insert wins) in Molly's Dedalus dialect: the `.ded` twin of BENCH-001b.
//
// DL11 Example 3 plus an inductive insertion rule. In Dedalus the insertion rule re-derives p_pos at T+1 even
// when p_neg blocks its persistence at T, so insert wins (R02 §3.3, CR-05).

p_pos(N, A, B) :- p(N, A, B);
p_pos(N, A, B)@next :- p_pos(N, A, B), notin p_neg(N, A, B);
p_pos(N, A, B)@next :- p_next(N, A, B);

p("n1", 1, 2)@101;
p("n1", 1, 3)@102;
p("n1", 1, 4)@150;
p_neg("n1", 1, 4)@150;
p_next("n1", 1, 2)@200;
p_neg("n1", 1, 2)@200;
p_neg("n1", 1, 3)@250;
