//! BENCH-003 (DL11 Ex. 6): an unsafe rule must be rejected.
//!
//! DL11 Example 6 (R02 §3.5): `p(A, B) <- q(A);` is not range-restricted, because `B` is bound by no positive
//! subgoal. In Blossom the rule is a view whose column `b` no alternative binds (LANGUAGE §8.3, BLS0500). The
//! column's type is annotated so that the only error is range restriction, not type inference (BLS0310).

program dl11_unsafe_rule version 1;

static q(a: i64);

fact q(1);

view p(a, b: i64) = q(a); // expect: BLS0500 (b is bound by no positive literal)

output out(a: i64, b: i64);

report: while p(a, b) {
    emit out(a, b);
}
