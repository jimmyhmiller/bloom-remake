//! BENCH-047: choice stratified through time: a BFS tree built one layer per tick (R12 §12 T8).
//!
//!     table reached(n: str)
//!     reached("r") :- bootstrap.
//!     parent(Y, choose<X>) :- reached(X), g(X, Y), notin reached(Y).
//!     reached(Y)@next :- parent(Y, _).
//!     table tree(y: str, x: str)
//!     tree(Y, X) :- parent(Y, X).
//!
//! The cycle through `reached` passes through `next`, so the choice is stratified (SEM-086). With
//! g = {r->a, r->b, a->c, b->c, c->d}: tick 0 gives a <- r and b <- r; tick 1 chooses c's parent from {a, b};
//! tick 2 gives d <- c; tick 3 is quiescent.
//! This variant uses the seeded `choose!`: under any seed c's parent is a or b, and every other node has a single
//! candidate parent.

program bfs_tree_seeded version 1;

static g(x: String, y: String);

fact g("r", "a");
fact g("r", "b");
fact g("a", "c");
fact g("b", "c");
fact g("c", "d");

table reached(n: String);
table tree(y: String, x: String);

view parent(y, x) = reached(x), g(x, y), not reached(y), choose!(x per y);

invariant c_parent "c's parent is not one of its candidates a and b": never tree("c", p) where p != "a" && p != "b";
invariant one_parent "a node got two parents": never tree(y, x1), tree(y, x2) where x1 != x2;

bootstrap {
    emit reached("r");
}

grow: while parent(y, _) {
    next reached(y);
}

record: while parent(y, x) {
    emit tree(y, x);
}
