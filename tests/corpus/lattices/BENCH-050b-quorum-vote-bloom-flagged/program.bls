//! BENCH-050b. The non-monotone quorum vote of SoCC'12 Fig. 2 (R04 §3.9), ported to Blossom. The Bloom original:
//!
//!     table   :votes, [:voter_id]          votes      <= vote_chn {|v| [v.voter_id]}
//!     scratch :cnt, [] => [:cnt]           cnt        <= votes.group(nil, count(:voter_id))
//!                                          result_chn <~ cnt {|c| [RESULT_ADDR] if c >= QUORUM_SIZE}
//!
//! The count is a relational aggregate over an asynchronously fed table, so the CALM analysis must report it as a
//! point of order (R04 §12 T1: "The Fig. 2 Bloom version must be flagged non-monotone at group/count").

program quorum_vote_bloom version 1;

const QUORUM_SIZE: u64 = 5;

role Voter: cluster;
role Tally;
role Sink;

channel vote_chn(voter_id: u64): Voter -> Tally;
channel result_chn(): Tally -> Sink;

at Voter {
    input cast(voter_id: u64);

    forward: on cast(id), t in Tally {
        send vote_chn(id) to t;
    }
}

at Tally {
    table votes(voter_id: u64);

    /// `cnt <= votes.group(nil, count(:voter_id))`: a relational aggregate, a negative edge (CR-09).
    view cnt(n = count!(v)) = votes(v);

    record: on vote_chn(id) {
        emit votes(id);
    }
    announce: while cnt(n), s in Sink where n >= QUORUM_SIZE {
        send result_chn() to s;
    }
}

at Sink {
    table got_result();

    receive: on result_chn() {
        emit got_result();
    }
}
