//! An `outer` atom over a column a generator binds joins on it (the generator stays a generator), and constant
//! collections (LANGUAGE §6.4): tuples, vectors, sets and maps.

program outer_generator version 1;

const LINES: Vec<(u64, u64, u64)> = [(0, 1, 2), (3, 4, 5)];
const NAMES: Map<u64, String> = map[1 => "one", 4 => "four"];
const ODD: Set<u64> = set[1, 3, 5];

input pair(a: u64, b: u64);
table pairs(a: u64, b: u64);
table names(x: u64, s: String);

keep: on pair(a, b) {
    emit pairs(a, b);
}
start: on boot() {
    emit names(1, "one");
    emit names(3, "three");
}

/// Each end of each pair, with its name or "?".
view named(x, s) = pairs(a, b), x in [a, b], outer names(x, n), let s = n.unwrap_or("?");
/// The squares of the constant lines, by line.
view square(i, c) = (i, (a, b, d)) in LINES.enumerate(), c in [a, b, d];
view const_name(x, s) = square(_, x), let Some(s) = NAMES.get(x);
view odd_square(x) = square(_, x) where ODD.contains(x);
