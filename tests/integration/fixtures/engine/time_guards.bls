//! Views that read the time only by ordering `now()` against an instant, and one with no positive atom. The engine
//! leaves such a rule alone while nothing it reads changes and the time stays before its next flip; the oracle
//! evaluates every rule at every tick. Ticks are a second apart and the thresholds fall on them, so `<` and `<=`
//! (and `>` and `>=`) differ at a tick.
program time_guards version 1;
input seen(x: u64);
input forget(x: u64);
param TWO: Duration = 2s;
param THREE: Duration = 3s;
param ONE: Duration = 1s;
table at(x: u64, t: Instant) key(x);
on seen(x) { upsert at(x, now()); }
on forget(x), at(x, t) { delete at(x, t); }
view fresh(x) = at(x, t) where now() < t + TWO;
view fresh_incl(x) = at(x, t) where now() <= t + TWO;
view stale(x) = at(x, t) where now() >= t + THREE;
view stale_excl(x) = at(x, t) where now() > t + THREE;
view later(x) = at(x, t) where t + ONE < now();
view gated(x) = at(x, t) where x > 1 && now() > t + ONE;
view nothing_seen() = not at(_, _);
/// Reads the time freely: its output changes at every tick though nothing it reads does.
view age(x, d: Duration) = at(x, t), let d = now() - t;
