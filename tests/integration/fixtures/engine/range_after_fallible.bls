//! A range guard written after a check that can fail: the guard cannot fail, so it runs first (LANGUAGE §9.14) and
//! narrows the scan of `v`; the division runs only for rows it accepts. `v` is settled before `s` arrives, so the
//! change to `s` drives the join and `v` is probed.
program range_after_fallible version 1;
input s(x: u64);
input add(i: u64);
table v(i: u64);
table out(i: u64);
bootstrap {
    emit v(1);
}
on add(i) { emit v(i); }
while s(x), v(i), let y = i / x where i > 5 { emit out(y); }
