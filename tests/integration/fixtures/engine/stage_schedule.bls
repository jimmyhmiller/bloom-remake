program stage_schedule version 1;
input values(k: u64, v: u64);
input divisors(k: u64, v: u64);
fn work(x: u64) -> u64 {
    range(0u64, 32u64).map(|i| (i + x) * (i + x)).fold(0u64, |a, v| a + v)
}
view left(k, x) = values(k, v), let x = work(v);
view right(k, x) = values(k, v), let x = work(v + 1u64);
view third(k, x) = values(k, v), let x = work(v + 2u64);
view joined(k, x) = left(k, a), right(k, b), third(k, c), let x = a + b + c;
view failure_a(k, x) = divisors(k, v), let x = 10u64 / v;
view failure_b(k, x) = divisors(k, v), let x = 20u64 / v;
