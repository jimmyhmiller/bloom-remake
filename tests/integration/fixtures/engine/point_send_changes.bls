//! A lattice channel whose per-tick contribution changes from a larger to a smaller point.
program point_send_changes version 1;
role P: cluster;
channel pt(k: u8, p: LPoint<u8>): P -> P;
at P {
    input set(v: u8);
    table cur(v: u8) key();
    bootstrap { emit cur(5); }
    on set(v) { upsert cur(v); }
    while cur(v) { for p in P where p != self { send pt(0, LPoint::of(v)) to p; } }
}
