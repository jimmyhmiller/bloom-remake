//! A harness for the replicated-log layer (`examples/kafka/raft.bls`, S8 item 1): five groups over four brokers,
//! of sizes 4, 3, 3, 2 and 1. Each group's leader proposes a numbered entry on every `tickle`, so every group keeps
//! appending; the test's observer checks Raft's safety properties per group.
program raft_groups version 1;

role Broker: cluster;

include "../../../../examples/kafka/raft.bls";

/// The groups and their members.
static group_member(g: Group, n: Node<Broker>);

fact group_member((b"all", 0), "b1");
fact group_member((b"all", 0), "b2");
fact group_member((b"all", 0), "b3");
fact group_member((b"all", 0), "b4");
fact group_member((b"left", 0), "b1");
fact group_member((b"left", 0), "b2");
fact group_member((b"left", 0), "b3");
fact group_member((b"right", 1), "b2");
fact group_member((b"right", 1), "b3");
fact group_member((b"right", 1), "b4");
fact group_member((b"pair", 2), "b1");
fact group_member((b"pair", 2), "b4");
fact group_member((b"solo", 3), "b3");

at Broker {
    timer tickle every 30ms;

    /// A directed test holds a group's proposals at a broker, and releases them.
    input hold(g: Group);
    input release(g: Group);
    table held(g: Group) key(g);
    hold_it: on hold(g) {
        upsert held(g);
    }
    release_it: on release(g), held(g) {
        delete held(g);
    }

    view members(g, n) = group_member(g, n);
    /// No group has a preferred leader here: every election starts after a random timeout.
    view preferred(g, n) = group_member(g, n) where false;

    /// A leader proposes one entry per tickle (its count), unless the group is held here.
    view proposals(g, xs = collect!((DATA, n as i64, blob))) =
        tickle(n, _), leader(g, _), not held(g), let blob = Blob::of(Bytes::from_u64_be(n));
}
