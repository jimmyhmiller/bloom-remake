//! A harness around the Blossom Kafka library (`examples/kafka/`) for the Rust codec oracle (`kafka_codec.rs`):
//! requests go in as bytes and come out decoded; response fields go in and come out encoded.
program codec version 1;

include "../../../../examples/kafka/protocol.bls";
include "../../../../examples/kafka/headers.bls";
include "../../../../examples/kafka/apiversions.bls";
include "../../../../examples/kafka/metadata.bls";

/// A request, without its size prefix.
input req(frame: Bytes);
/// The fields of an ApiVersions response (`unsupported`: the v0-layout refusal).
input apiv_resp(corr: i32, unsupported: bool);
/// The fields of a Metadata response: brokers (id, host, port, rack), cluster id, controller, requested topics.
input meta_resp(corr: i32, brokers: Vec<(i32, String, i32, Option<String>)>, cluster: String, controller: i32, topics: Option<Vec<String>>);
/// Bytes to split into frames.
input stream_bytes(b: Bytes);

fn header_of(b: Bytes) -> Option<RequestHeader> {
    request_header(cur(b)).map(|p| p.0)
}

fn apiv_of(b: Bytes) -> Option<ApiVersionsRequest> {
    request_header(cur(b)).and_then(|p| decode_api_versions_request(p.1))
}

fn meta_of(b: Bytes) -> Option<MetadataRequest> {
    request_header(cur(b)).and_then(|p| decode_metadata_request(p.1))
}

fn zero_uuid() -> Bytes {
    Bytes::join(range(0, 16).map(|_i| Bytes::from_u8(0u8)))
}

fn meta_bytes(corr: i32, brokers: Vec<(i32, String, i32, Option<String>)>, cluster: String, controller: i32, topics: Option<Vec<String>>) -> Bytes {
    let req = MetadataRequest {
        topics: topics.map(|ns| ns.map(|n| MetadataTopicRequest { topic_id: zero_uuid(), name: Some(n) })),
        allow_auto_topic_creation: true,
        include_topic_authorized_operations: false,
    };
    let bs = brokers.map(|b| BrokerInfo { node_id: b.0, host: b.1, port: b.2, rack: b.3 });
    encode_metadata_response(corr, req, bs, cluster, controller)
}

fn apiv_bytes(corr: i32, unsupported: bool) -> Bytes {
    if unsupported { encode_api_versions_unsupported(corr) } else { encode_api_versions_response(corr) }
}

view v_header(f, h) = req(f), let h = header_of(f);
view v_apiv(f, r) = req(f), let r = apiv_of(f);
view v_meta(f, r) = req(f), let r = meta_of(f);
view v_apiv_resp(corr, u, b) = apiv_resp(corr, u), let b = apiv_bytes(corr, u);
view v_meta_resp(corr, b) = meta_resp(corr, brokers, cluster, controller, topics), let b = meta_bytes(corr, brokers, cluster, controller, topics);
view v_split(b, x) = stream_bytes(b), let x = split_frames(b);
