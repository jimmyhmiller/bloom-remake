//! A harness around the Blossom Kafka library (`examples/kafka/`) for the Rust codec oracle (`kafka_codec.rs`):
//! requests go in as bytes and come out decoded; response fields go in and come out encoded.
program codec version 1;

include "../../../../examples/kafka/protocol.bls";
include "../../../../examples/kafka/headers.bls";
include "../../../../examples/kafka/apiversions.bls";
include "../../../../examples/kafka/metadata.bls";
include "../../../../examples/kafka/topics.bls";
include "../../../../examples/kafka/records.bls";
include "../../../../examples/kafka/produce.bls";
include "../../../../examples/kafka/fetch.bls";

/// Read by the topic functions: the broker's id and the partition count a topic gets by default.
param NODE_ID: i32 = 1;
param DEFAULT_PARTITIONS: i32 = 1;

/// A request, without its size prefix.
input req(frame: Bytes);
/// The fields of an ApiVersions response (`unsupported`: the v0-layout refusal).
input apiv_resp(corr: i32, unsupported: bool);
/// The fields of a Metadata response: brokers (id, host, port, rack), cluster id, controller, requested topics (id,
/// name), and the broker's topics (name, id, partitions).
input meta_resp(corr: i32, brokers: Vec<(i32, String, i32, Option<String>)>, cluster: String, controller: i32, topics: Option<Vec<(Bytes, Option<String>)>>, have: Vec<(String, Bytes, i32)>);
/// The outcomes of a CreateTopics response: name, id, error, message, partitions and the configs set at creation.
input create_resp(corr: i32, outcomes: Vec<(String, Bytes, i16, Option<String>, i32, Vec<(String, String)>)>);
/// The outcomes of a DeleteTopics response: name, id, error and message.
input delete_resp(corr: i32, outcomes: Vec<(Option<String>, Bytes, i16, Option<String>)>);
/// The resources of a DescribeConfigs response: type, name, the keys asked for, and the topic's configs if it
/// exists.
input describe_resp(corr: i32, resources: Vec<(i8, String, Option<Vec<String>>, Option<Vec<(String, String)>>)>);
/// The answers of a Produce response to the request `frame`: per entry (in request order) its position, error, base
/// offset, log start, message and bad batch.
input produce_resp(corr: i32, frame: Bytes, answers: Vec<(u64, i16, i64, i64, Option<String>, Option<i32>)>);
/// The answers of a Fetch response to request `frame`: the request-level error, and per entry its position, error,
/// high watermark, log start and batches.
input fetch_resp(corr: i32, frame: Bytes, err: i16, answers: Vec<(u64, i16, i64, i64, Vec<Bytes>)>);
/// The answers of a ListOffsets response to request `frame`: per entry its position, error, timestamp, offset and
/// leader epoch.
input list_resp(corr: i32, frame: Bytes, answers: Vec<(u64, i16, i64, i64, i32)>);
/// Batches appended to one partition one by one, from an empty log and no producer state.
input seq_case(id: u64, batches: Vec<Bytes>);
/// Bytes to split into frames.
input stream_bytes(b: Bytes);
/// Chunks to reassemble into frames, fed in order.
input chunks(id: u64, cs: Vec<Bytes>);

fn header_of(b: Bytes) -> Option<RequestHeader> {
    request_header(cur(b)).map(|p| p.0)
}

fn apiv_of(b: Bytes) -> Option<ApiVersionsRequest> {
    request_header(cur(b)).and_then(|p| decode_api_versions_request(p.1))
}

fn meta_of(b: Bytes) -> Option<MetadataRequest> {
    request_header(cur(b)).and_then(|p| decode_metadata_request(p.1))
}

fn meta_bytes(corr: i32, brokers: Vec<(i32, String, i32, Option<String>)>, cluster: String, controller: i32, topics: Option<Vec<(Bytes, Option<String>)>>, have: Vec<(String, Bytes, i32)>) -> Bytes {
    let req = MetadataRequest {
        topics: topics.map(|ts| ts.map(|t| MetadataTopicRequest { topic_id: t.0, name: t.1 })),
        allow_auto_topic_creation: true,
        include_topic_authorized_operations: false,
    };
    let bs = brokers.map(|b| BrokerInfo { node_id: b.0, host: b.1, port: b.2, rack: b.3 });
    let topics = have.map(|t| TopicInfo { name: t.0, id: t.1, partitions: range(0, t.2 as u64).map(|p| PartInfo {
        index: p as i32, leader: controller, epoch: 0i32, replicas: [controller],
    }) });
    encode_metadata_response(corr, req, bs, cluster, controller, topics, empty_names())
}

fn create_of(b: Bytes) -> Option<CreateTopicsRequest> {
    request_body(b).and_then(|c| decode_create_topics(c))
}

fn delete_of(b: Bytes) -> Option<(Vec<DeleteTopicState>, i32)> {
    request_body(b).and_then(|c| decode_delete_topics(c))
}

fn describe_of(b: Bytes) -> Option<Vec<ConfigResource>> {
    request_body(b).and_then(|c| decode_describe_configs(c))
}

fn produce_of(b: Bytes) -> Option<ProduceRequest> {
    request_body(b).and_then(|c| decode_produce(c))
}

fn produce_bytes(corr: i32, frame: Bytes, answers: Vec<(u64, i16, i64, i64, Option<String>, Option<i32>)>) -> Option<Bytes> {
    produce_of(frame).map(|req| encode_produce_response(corr, req, answers.map(|a| (a.0, PartitionAnswer {
        error: a.1,
        base_offset: a.2,
        log_start: a.3,
        message: a.4,
        bad_batch: a.5,
    }))))
}

fn init_pid_of(b: Bytes) -> Option<InitProducerIdRequest> {
    request_body(b).and_then(|c| decode_init_producer_id(c))
}

fn produce_checks(r: ProduceRequest) -> Vec<(i16, Option<String>)> {
    produce_entries(r).map(|e| {
        let c = check_records(e.3, 1048588i64);
        (c.error, c.message)
    })
}

/// Each batch's outcome (error, base offset) when appended alone, in order.
fn sequence_each(batches: Vec<Bytes>) -> Vec<(i16, i64)> {
    let start: (Vec<(i16, i64)>, i64, Vec<ProducerEntry>) = ([], 0i64, []);
    let end = batches.fold(start, |acc, b| {
        let (outs, at, sts) = acc;
        let (o, sts2) = sequence_one([b], at, sts);
        (outs.push((o.error, o.base)), at + o.count, sts2)
    });
    end.0
}

fn fetch_of(b: Bytes) -> Option<FetchRequest> {
    request_body(b).and_then(|c| decode_fetch(c))
}

fn list_of(b: Bytes) -> Option<ListOffsetsRequest> {
    request_prefix(cur(b)).and_then(|p| request_body(b).and_then(|c| decode_list_offsets(c, p.1)))
}

/// The bytes a stream write of `parts` sends.
fn render(parts: Vec<Part>) -> Bytes {
    Bytes::join(parts.map(|p| match p {
        Part::Bytes(b) => b,
        Part::Blob(bl, lo, hi) => match bl.read(lo, hi) {
            Some(x) => x,
            None => error("render: a blob of this tick cannot be read"),
        },
    }))
}

fn fetch_bytes_of(corr: i32, frame: Bytes, err: i16, answers: Vec<(u64, i16, i64, i64, Vec<Bytes>)>) -> Option<Bytes> {
    fetch_of(frame).map(|req| render(fetch_response_parts(corr, err, req, answers.map(|a| (a.0, FetchAnswer {
        error: a.1,
        high_watermark: a.2,
        log_start: a.3,
        batches: a.4.map(|b| Blob::of(b)),
    })))))
}

fn list_bytes_of(corr: i32, frame: Bytes, answers: Vec<(u64, i16, i64, i64, i32)>) -> Option<Bytes> {
    list_of(frame).map(|req| encode_list_offsets_response(corr, req, answers.map(|a| (a.0, OffsetAnswer {
        error: a.1,
        timestamp: a.2,
        offset: a.3,
        leader_epoch: a.4,
    }))))
}

fn request_body(b: Bytes) -> Option<Cur> {
    request_header(cur(b)).map(|p| p.1)
}

fn create_bytes(corr: i32, outcomes: Vec<(String, Bytes, i16, Option<String>, i32, Vec<(String, String)>)>) -> Bytes {
    encode_create_topics_response(corr, outcomes.map(|o| CreateOutcome {
        error: o.2,
        message: o.3,
        topic: NewTopic { name: o.0, id: o.1, partitions: o.4, configs: o.5, assignment: if o.4 > 0i32 { range(0, o.4 as u64).map(|_p| [1i32]) } else { [] } },
    }))
}

fn delete_bytes(corr: i32, outcomes: Vec<(Option<String>, Bytes, i16, Option<String>)>) -> Bytes {
    encode_delete_topics_response(corr, outcomes.map(|o| DeleteOutcome { name: o.0, id: o.1, error: o.2, message: o.3 }))
}

fn describe_bytes(corr: i32, resources: Vec<(i8, String, Option<Vec<String>>, Option<Vec<(String, String)>>)>) -> Bytes {
    encode_describe_configs_response(corr, resources.map(|r| encode_config_result(ConfigResource { kind: r.0, name: r.1, keys: r.2 }, r.3)))
}

fn apiv_bytes(corr: i32, unsupported: bool) -> Bytes {
    if unsupported { encode_api_versions_unsupported(corr) } else { encode_api_versions_response(corr) }
}

view v_header(f, h) = req(f), let h = header_of(f);
view v_apiv(f, r) = req(f), let r = apiv_of(f);
view v_meta(f, r) = req(f), let r = meta_of(f);
view v_apiv_resp(corr, u, b) = apiv_resp(corr, u), let b = apiv_bytes(corr, u);
view v_meta_resp(corr, b) = meta_resp(corr, brokers, cluster, controller, topics, have), let b = meta_bytes(corr, brokers, cluster, controller, topics, have);
view v_create(f, r) = req(f), let r = create_of(f);
view v_produce(f, r) = req(f), let r = produce_of(f);
view v_fetch(f, r) = req(f), let r = fetch_of(f);
view v_list(f, r) = req(f), let r = list_of(f);
view v_fetch_resp(corr, b) = fetch_resp(corr, f, err, answers), let b = fetch_bytes_of(corr, f, err, answers);
view v_list_resp(corr, b) = list_resp(corr, f, answers), let b = list_bytes_of(corr, f, answers);
view v_seq(id, outs) = seq_case(id, batches), let outs = sequence_each(batches);
view v_init_pid(f, r) = req(f), let r = init_pid_of(f);
/// Each entry's check of a Produce request (error, message), as the broker checks it.
view v_produce_check(f, cs) = req(f), let Some(r) = produce_of(f), let cs = produce_checks(r);
view v_produce_resp(corr, b) = produce_resp(corr, f, answers), let b = produce_bytes(corr, f, answers);
view v_delete(f, r) = req(f), let r = delete_of(f);
view v_describe(f, r) = req(f), let r = describe_of(f);
view v_create_resp(corr, b) = create_resp(corr, outcomes), let b = create_bytes(corr, outcomes);
view v_delete_resp(corr, b) = delete_resp(corr, outcomes), let b = delete_bytes(corr, outcomes);
view v_describe_resp(corr, b) = describe_resp(corr, resources), let b = describe_bytes(corr, resources);
/// All frames `b` holds (a frame takes at least 4 bytes).
view v_split(b, x) = stream_bytes(b), let x = split_frames(b, b.len() / 4);

/// The frames the chunks complete, fed one by one, whether a size was invalid, and the bytes left over.
fn feed_all(cs: Vec<Bytes>) -> (Vec<Bytes>, bool, u64) {
    let end = cs.fold((framer(), [], false), |acc, c| {
        let (f, frames, bad) = acc;
        if bad {
            acc
        } else {
            let fed = feed(f, c);
            (fed.next, frames.concat(fed.frames), fed.bad)
        }
    });
    (end.1, end.2, end.0.have)
}
view v_feed(id, x) = chunks(id, cs), let x = feed_all(cs);

fn empty_names() -> Set<String> {
    [].to_set()
}
