//! A chat room with a server and browser tabs (docs/design/CLIENTS.md), for `bls_clients.rs`: tabs are members of the
//! client role `Browser`; the server keeps the log and who is online, fans every line out, and greets a tab that
//! (re)connects with the log so far.
program chat version 1;

role Server;
role Browser: client;

channel say(text: String): Browser -> Server;
channel heard(who: Node<Browser>, text: String): Server -> Browser;

at Server {
    table online(b: Node<Browser>);
    durable table log(who: Node<Browser>, text: String);

    join: on Browser.connected(b, _) {
        emit online(b);
    }
    leave: on Browser.disconnected(b) {
        delete online(b);
    }
    store: on say(t) from b {
        emit log(b, t);
    }
    fan: on say(t) from b, online(o) {
        send heard(b, t) to o;
    }
    /// A tab whose link did not resume gets the whole log.
    greet: on Browser.connected(b, false), log(w, t) {
        send heard(w, t) to b;
    }
}

at Browser {
    input line(text: String);
    table seen(who: Node<Browser>, text: String);
    table up(s: Node<Server>);

    talk: on line(t), srv in Server {
        send say(t) to srv;
    }
    hear: on heard(w, t) {
        emit seen(w, t);
    }
    link: on Server.connected(s, _) {
        emit up(s);
    }
    lost: on Server.disconnected(s) {
        delete up(s);
    }
}
