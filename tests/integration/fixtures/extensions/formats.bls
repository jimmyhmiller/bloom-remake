//! Formats (LANGUAGE §16.7): a Kafka-like vocabulary of aliases, two records (one nested in the other, with a
//! version parameter, a constant, an ignored field, tuples, conditional fields, tagged sections, and `select`s
//! between a legacy and a compact encoding by version). `bls_extensions.rs` encodes random values
//! with its own reference encoder and checks the decoded fields, the re-encoding and that truncations decode to
//! nothing, on both evaluators.
program formats version 1;

format compact_string = prefixed(uvarint, 1, utf8);
format compact_nullable_string = nullable(compact_string);
format compact_array(F) = array(uvarint, 1, F);
format string16 = nullable(prefixed(i16, 0, utf8));
format uuid = bytes(16);
/// An alias whose argument is used inside an expression.
format doubled(n) = bytes(n * 2);
format Six { a: doubled(3) }
/// The legacy encoding before a version, the compact one from it.
format kstring(flex) = select(flex, compact_nullable_string, string16);
format karray(flex, F) = select(flex, compact_array(F), array(i32, 0, F));

format Topic(version: i16) {
    id: uuid,
    name: kstring(version >= 8i16),
    parts: karray(version >= 12i16, i32),
    pairs: compact_array((i32, bool, tags)),
    tags,
}

format Request(version: i16) {
    constant(i16, 7),
    topics: nullable(compact_array(Topic(version))),
    auto: bool,
    ops: bool if version >= 8,
    legacy: string16 if version < 8,
    big: u64,
    small: i8,
    ignored(i64, -1i64),
    delta: varint,
    blob: prefixed(varint, 0, rest),
    tags,
}

input msg(k: u64, version: i16, b: Bytes);

fn flat(r: Request) -> (Option<Vec<(Bytes, Option<String>, Vec<i32>, Vec<(i32, bool)>)>>, bool, bool, Option<String>, u64, i8, i64, Bytes) {
    (r.topics.map(|ts| ts.map(|t| (t.id, t.name, t.parts, t.pairs))), r.auto, r.ops, r.legacy, r.big, r.small, r.delta, r.blob)
}

/// Each message decoded: its fields, the bytes it took, and whether encoding it gives the same bytes.
view decoded(k, fields, used, same) =
    msg(k, v, b), let Some((r, used)) = Request::decode(b, 0, v), let fields = flat(r), let same = Request::encode(r, v) == b;
/// `doubled(3)` reads six bytes.
view six(k, n) = msg(k, _, b), let Some((_r, n)) = Six::decode(b, 0);
