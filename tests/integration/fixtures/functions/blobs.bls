//! Blobs in the language (FOREIGN-PROTOCOLS §5): `Blob::of`, `len` and `read`, in rules and functions, and a blob
//! created in one tick and read in a later one. `bls_functions.rs` checks the views on both evaluators.
program blobs version 1;

input e(b: Bytes);

/// Every blob ever made, kept across ticks.
table kept(b: Blob);

keep: on e(b) {
    emit kept(Blob::of(b));
}

/// The blob's bytes one at a time, read back through the handle.
fn bytewise(b: Bytes) -> Vec<Option<Bytes>> {
    let x = Blob::of(b);
    range(0, x.len()).map(|i| x.read(i, i + 1))
}

view v_len(b, n) = e(b), let n = Blob::of(b).len();
view v_read(b, x) = e(b), let x = Blob::of(b).read(1, 3);
view v_bytewise(b, x) = e(b), let x = bytewise(b);
/// Blobs made in earlier ticks, read whole.
view v_kept(k, x) = kept(k), let x = k.read(0, k.len());
