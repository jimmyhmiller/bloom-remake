{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "blossom": { "root": ".", "entrypoint": "Dockerfile.vercel", "runtime": "container" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "blossom" } }],
  "crons": [{ "path": "/blossom/wake", "schedule": "* * * * *" }]
}
