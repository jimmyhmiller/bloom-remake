{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "crates/blossom-vercel/api/blossom.rs",
      "use": "@vercel/rust",
      "config": { "includeFiles": ["DEPLOY_DIR/**"] }
    },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/blossom/(.*)", "dest": "/crates/blossom-vercel/api/blossom.rs" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
